            </div>
            
                <div class="ad-preview__section">
                    <div class="ad-preview__inline">
                            <p class="ad-preview__char p-sm">1 hab.</p>
                            <p class="ad-preview__char p-sm">1 ba&#xF1;o</p>
                            <p class="ad-preview__char p-sm">67 m&#xB2;</p>
                            <p class="ad-preview__char p-sm">8&#xAA; planta</p>
