5\",\"logo\":\"https://static.fotocasa.es/images/client/6d071e9c-34b6-450a-b195-2c40abfb182d/20220712203020.jpeg?rule=original\",\"website\":\"https://www.avenida155.es/es\",\"navigationUrl\":\"/inmobiliaria/inmobiliaria-avenida-155/\",\"legacyPublisherId\":\"39017\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-04T12:06:12.9657906+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":1,\"builtSurface\":105,\"landArea\":null,\"terrace\":{\"has\":true},\"floor\":\"FIRST\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"SOUTH_EAST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"F\",\"value\":124},\"emissions\":{\"label\":\"F\",\"value\":24}},\"status\":\"AVAILABLE\"}},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1200,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1200,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@avenida155.com\",\"phone\":\"+34944677402\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/baztan-haranaren-plaza/deusto/bilbao/f73ea57d-19e3-4e07-8fb2-027b75eca34b/d\",\"feature\":null,\"short\":\"/a/f73ea57d-19e3-4e07-8fb2-027b75eca34b\"}},{\"id\":\"74782334-b82d-472c-8f71-384c53dff7fa\",\"reference\":\"3737\",\"legacyNumericId\":\"30081000006097\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/basurtu-kastrexana-errepidea/basurtu-zorrotza/bilbao/74782334-b82d-472c-8f71-384c53dff7fa/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/basurtu-zorrotza/s\",\"summary\":{\"title\":\"INMOBILIARIA CAMPUZANO pone en alquiler bonito piso con car\u00E1cter temporal.\",\"description\":\"INMOBILIARIA CAMPUZANO pone en alquiler bonito piso con car\u00E1cter temporal.\\nImprescindible demostrar el motivo del alquiler.\\nCon una superficie de 110 metros cuadrados construidos, el piso se distribuye en 3 dormitorios (uno de ellos en suite), dos cuartos de ba\u00F1o, cocina independiente, tendedero, sal\u00F3n comedor y balc\u00F3n con espectaculares vistas. Todos los dormitorios disponen de armarios empotrados. \\nSuelo radiante y refrescante.\\nPiso, completamente exterior, de reciente construcci\u00F3n.\\nDisponible a partir del 17 de noviembre.\\nPara m\u00E1s informaci\u00F3n, contactar con la inmobiliaria.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Basurtu - Zorrotza\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Basurtu Kastrexana Errepidea\",\"streetNumber\":\"73\"},\"coordinates\":{\"latitude\":43.26041221114906,\"longitude\":-2.959663702374769},\"displayAddressLine\":\"Basurtu Kastrexana Errepidea\",\"displayZoneLine\":\"Basurtu - Zorrotza, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Altamira\",\"slug\":\"altamira\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug