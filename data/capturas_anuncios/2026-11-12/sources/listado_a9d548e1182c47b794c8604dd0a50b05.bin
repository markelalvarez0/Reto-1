lue\":316},\"emissions\":{\"label\":\"G\",\"value\":67}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":980,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":980,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@ihbilbao.com\",\"phone\":\"+34946510000\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/lapurdi-hiribidea/errekalde/bilbao/7ec071e1-c233-4e9b-9380-15ddf18a69e7/d\",\"feature\":null,\"short\":\"/a/7ec071e1-c233-4e9b-9380-15ddf18a69e7\"}},{\"id\":\"13281095-6d4b-47af-8a07-cbce13762e0d\",\"reference\":\"3593\",\"legacyNumericId\":\"38192000002468\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/basurtu-kastrexana-errepidea/basurtu-zorrotza/bilbao/13281095-6d4b-47af-8a07-cbce13762e0d/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/basurtu-zorrotza/s\",\"summary\":{\"title\":\"Piso en alquiler temporal en BASURTO\",\"description\":\"Vivienda c\u00F3moda y funcional, ideal para estancias TEMPORALES por trabajo o estudios. El piso es muy luminoso gracias a sus amplios ventanales y ofrece unas vistas agradables y despejadas.\\r\\nCuenta con tres dormitorios amplios y bien equipados, un sal\u00F3n acogedor, cocina independiente totalmente equipada y un ba\u00F1o moderno con ducha. Todo el piso est\u00E1 amueblado y listo para entrar a vivir, con una distribuci\u00F3n pr\u00E1ctica que facilita el d\u00EDa a d\u00EDa.\\r\\nAdem\u00E1s, dispone de plaza de garaje en el edificio incluida en el precio. \\r\\nConsumos incluidos en el precio.\\r\\nUbicado en un entorno tranquilo, bien comunicado y con servicios cercanos, es una opci\u00F3n perfecta para quienes buscan confort, luz natural y buena conexi\u00F3n con el resto de la ciudad durante una estancia temporal.\\r\\nIdeal para profesionales desplazados, parejas o estudiantes que busquen comodidad y tranquilidad.\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\\r\\n \",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Basurtu - Zorrotza\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Basurtu Kastrexana Errepidea\",\"streetNumber\":\"73\"},\"coordinates\":{\"latitude\":43.26222130189399,\"longitude\":-2.96014163402333},\"displayAddressLine\":\"Basurtu Kastrexana Errepidea\",\"displayZoneLine\":\"Basurtu - Zorrotza, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Altamira\",\"slug\":\"altamira\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Basurtu - Zorrotza\",\"slug\":\"basurtu-zorrotza\"},{\"type\":\"street\",\"value\":\"Carretera Basurtu-Kastrexana\",\"slug\":\"carretera-basurtu-kastrexana\"},{\"type\":\"street\",\"value\":\"Grupo Santa Ana\",\"slug\":\"grupo-santa-ana\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48002\",\"geography\":[{\"level\":\"country\",\"code\":