\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-06T22:24:10.8731939+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"apartment\",\"status\":\"ALMOST_NEW\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":118,\"landArea\":null,\"constructionYear\":2025,\"terrace\":{\"has\":true},\"floor\":\"FIRST\",\"features\":{\"has\":[\"EQUIPPED_KITCHEN\",\"HOME_APPLIANCES\",\"WARDROBES\",\"ELEVATOR\",\"YARD\",\"BALCONY\",\"PRIVATE_PARKING\"],\"hasNot\":[\"FURNISHED\",\"JACUZZI\",\"SAUNA\",\"GYM\",\"SUITE_BATHROOM\",\"PARQUET\",\"TENNIS_COURT\",\"CHILDREN_AREA\",\"PRIVATE_GARDEN\",\"PRIVATE_POOL\",\"AIR_CONDITIONER\",\"PETS_ALLOWED\"]},\"orientation\":\"NORTH\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"A\",\"value\":12},\"emissions\":{\"label\":\"A\",\"value\":2}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_MODERN\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":3000,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":3000,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"bilbao@engelvoelkers.com\",\"phone\":\"+34946444005\"},\"urls\":{\"canonical\":\"/alquiler/apartamento/abando-albia/bilbao/f792d74b-f285-40b8-aaff-15fee5c1f42f/d\",\"feature\":null,\"short\":\"/a/f792d74b-f285-40b8-aaff-15fee5c1f42f\"}},{\"id\":\"1c81f11d-12c7-436e-a9b3-a130220c08a3\",\"reference\":\"3840\",\"legacyNumericId\":\"38192000002628\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/mugica-y-butron-kalea/uribarri/bilbao/1c81f11d-12c7-436e-a9b3-a130220c08a3/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/uribarri/s\",\"summary\":{\"title\":\"Vivienda en alquiler para ESTUDIANTES o TRABAJADORES\",\"description\":\"Vivienda en alquiler para ESTUDIANTES o TRABAJADORES en el campo volant\u00EDn en la calle Mugica y Butron, situado junto al paseo de la r\u00EDa. Vivienda exterior con una superficie de 115m2 y amplia terraza, cocina totalmente equipada y reci\u00E9n reformada, 4 habitaciones y dos ba\u00F1os completos con ducha, reci\u00E9n reformados. Dispone de ascensor y calefacci\u00F3n y agua caliente individuales de gas natural.\\r\\nVen a verla, te la ense\u00F1amos encantadas, INFINITY HOMES\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Uribarri\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"M\u00FAgica y Butr\u00F3n Kalea\",\"streetNumber\":\"2\"},\"coordinates\":{\"latitude\":43.267754867191826,\"longitude\":-2.9276396254331303},\"displayAddressLine\":\"M\u00FAgica y Butr\u00F3n Kalea\",\"displayZoneLine\":\"Uribarri, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Casta\u00F1os - Bego\u00F1aibarra\",\"slug\":\"castanos-begonaibarra\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\