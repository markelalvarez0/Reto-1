\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3abc8b2b-8d16-4306-8b42-12fe039dfce7?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/0adaf39d-cd8a-4991-94b0-7120d2dd3150?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":32,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"6d071e9c-34b6-450a-b195-2c40abfb182d\",\"name\":\"San Ignacio Inmobiliaria Avenida 155\",\"tradeName\":\"Inmobiliaria Avenida 155\",\"logo\":\"https://static.fotocasa.es/images/client/6d071e9c-34b6-450a-b195-2c40abfb182d/20220712203020.jpeg?rule=original\",\"website\":\"https://www.avenida155.es/es\",\"navigationUrl\":\"/inmobiliaria/inmobiliaria-avenida-155/\",\"legacyPublisherId\":\"39017\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-04T12:04:10.7535072+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":1,\"builtSurface\":87,\"landArea\":null,\"floor\":\"EIGHTH\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\",\"BALCONY\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"WEST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"FOR_STUDENTS\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1200,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1200,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@avenida155.com\",\"phone\":\"+34944677402\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/francisco-durrio-eskultorearen-kalea/deusto/bilbao/ca894199-55ef-4d0a-b77c-ebd941e46cc6/d\",\"feature\":null,\"short\":\"/a/ca894199-55ef-4d0a-b77c-ebd941e46cc6\"}},{\"id\":\"f73ea57d-19e3-4e07-8fb2-027b75eca34b\",\"reference\":\"AVDA-3713\",\"legacyNumericId\":\"39017000000392\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/baztan-haranaren-plaza/deusto/bilbao/f73ea57d-19e3-4e07-8fb2-027b75eca34b/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/deusto/s\",\"summary\":{\"title\":\"ESTUDIANTES CURSO 2627\",\"description\":\"ALQUILER DE TEMPORADA  PARA ESTUDIANTES CURSO 26/27 \\r\\nEl autob\u00FAs a la UPV a dos minutos, a diez minutos andando al conservatorio y arte dram\u00E1tico y universidad de Sarriko.\\r\\nEsta vivienda de 96 m\u00B2  PARA ESTUDIANTES CURSO 26/27 - ESTUDIANTES  CURSO 26/27cuenta con un recibidor, un amplio sal\u00F3n-comedor, una cocina equipada, un ba\u00F1o con ducha  y 3 habitaciones\\r\\nDesde el sal\u00F3n y dos habitaciones se accede a una gran terraza\\r\\nEl suministro de agua y calefacci\u00F3n es mediante una caldera individual de gas.\\r\\nLa vivienda es totalmente exterior  lo que le proporciona una excelente luminosidad\\r\\nSomos una empresa en continuo crecimiento, con el fin de proporcionar UNA CALIDAD DE SERVICIO EXCELENTE a nuestros clientes, ofreciendo servicios personalizados sobre la base de la confianza, el trabajo, la seriedad y todo ello en busca de maximizar la satisfacci\u00F3n de las necesidades del cliente.\\r\\nESPECIALIZADA EN EL SECTOR INMOBILIARIO, centrada en la persona y construida sobre fuertes valores humanos.\\r\\nBuscamos ampliaciones en todos nuestros servicios en consonancia con las \u00DALTIMAS NOVEDADES y demandas del mercado inmobiliario, adaptados a las necesidades de nuestros clientes, con herramientas necesarias para su gesti\u00F3n.\\r\\nSomos PERSONAS que tratamos con PERSONAS, con un \u00FAnico objetivo: el de contribuir a la SATISFACCI\u00D3N DE NUESTROS CLIENTES.\\r\\nNuestro objetivo es ayudar a NUESTROS CLIENTES a tomar la decisi\u00F3n m\u00E1s adecuada en sus operaciones inmobiliarias, facilitando la compra, venta o alquiler de inmuebles en el menor tiempo posible, al mejor precio de mercado y CON LA M\u00C1XIMA TRANSPARENCIA Y CONFIABILIDAD.\\r\\nAvda. Lehendakari Aguirre n\u00BA 155 \u2013 San Ignacio Bilbao\\r\\nHorario de Lunes a viernes de 9:30h a 13:30h y 16:30h a 20:00h\\r\\n \",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Deusto\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Baztan Haranaren Plaza\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":43.278504175346455,\"longitude\":-2.959178558030885},\"displayAddressLine\":\"Baztan Haranaren Plaza\",\"displayZoneLine\":\"Deusto, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"San Ignacio - Elorrieta\",\"slug\":\"san-ignacio-elorrieta\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Deusto\",\"slug\":\"deusto\"},{\"type\":\"street\",\"value\":\"Plaza Valle del Baztan\",\"slug\":\"plaza-valle-del-baztan\"},{\"type\":\"street\",\"value\":\"Calle Pintor Antonio Guezala\",\"slug\":\"calle-pintor-antonio-guezala\"},{\"type\":\"street\",\"value\":\"Calle Seber Altube\",\"slug\":\"calle-seber-altube\"},{\"type\":\"street\",\"value\":\"Calle Orixe\",\"slug\":\"calle-orixe\"},{\"type\":\"street\",\"value\":\"Plaza Aoiz/Agoitz\",\"slug\":\"plaza-aoizagoitz\"},{\"type\":\"street\",\"value\":\"Calle Etxepare\",\"slug\":\"calle-etxepare\"},{\"type\":\"street\",\"value\":\"Calle Navarro Villoslada\",\"slug\":\"calle-navarro-villoslada\"},{\"type\":\"street\",\"value\":\"Calle Mar Mediterraneo\",\"slug\":\"calle-mar-mediterraneo\"},{\"type\":\"street\",\"value\":\"Calle Errondoko\",\"slug\":\"calle-errondoko\"},{\"type\":\"street\",\"value\":\"Calle Erronkari\",\"slug\":\"calle-erronkari\"},{\"type\":\"street\",\"value\":\"Calle Arturo Campion\",\"slug\":\"calle-arturo-campion\"},{\"type\":\"street\",\"value\":\"Calle Doctor Guimon Rezola\",\"slug\":\"calle-doctor-guimon-rezola\"},{\"type\":\"street\",\"value\":\"Calle Gregorio Balparda\",\"slug\":\"calle-gregorio-balparda\"},{\"type\":\"street\",\"value\":\"Calle Pintor Tellaetxe\",\"slug\":\"calle-pintor-tellaetxe\"},{\"type\":\"street\",\"value\":\"Calle Toribio Alzaga\",\"slug\":\"calle-toribio-alzaga\"},{\"type\":\"street\",\"value\":\"Calle Encartaciones\",\"slug\":\"calle-encartaciones\"},{\"type\":\"street\",\"value\":\"Calle Tudela\",\"slug\":\"calle-tudela\"},{\"type\":\"street\",\"value\":\"Calle Izarra\",\"slug\":\"calle-izarra\"},{\"type\":\"street\",\"value\":\"Calle Saturraran\",\"slug\":\"calle-saturraran\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48015\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2028\"},{\"level\":\"neighbourhood\",\"code\":\"650\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/08ae5683-614f-44e