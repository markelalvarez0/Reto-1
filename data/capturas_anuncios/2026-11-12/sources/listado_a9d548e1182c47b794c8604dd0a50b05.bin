e=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/0776b106-f8e6-49b8-98a0-049622e14226?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b84c8032-af50-4ef8-bd0b-48fb54ff2b59?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":23,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"fea4910d-2d26-49b8-9e1f-6c245eae7e56\",\"name\":\"Infinity Homes Bilbao, Sl\",\"tradeName\":\"Infinity Homes\",\"logo\":\"https://static.fotocasa.es/images/client/fea4910d-2d26-49b8-9e1f-6c245eae7e56/20241125090707?rule=original\",\"website\":\"https://www.ihbilbao.com/\",\"navigationUrl\":\"/inmobiliaria/infinity-homes/\",\"legacyPublisherId\":\"38192\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-09T15:50:26.6514245+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":1,\"builtSurface\":76,\"landArea\":null,\"floor\":\"THIRD\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"SOUTH_EAST\",\"heating\":\"ELECTRIC\",\"hotWater\":\"ELECTRIC\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":164},\"emissions\":{\"label\":\"E\",\"value\":34}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1000,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1000,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@ihbilbao.com\",\"phone\":\"+34946510000\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/sagarminaga-kalea/begona-santutxu/bilbao/bb80d420-26ed-40af-a9fe-53af0b000a46/d\",\"feature\":null,\"short\":\"/a/bb80d420-26ed-40af-a9fe-53af0b000a46\"}},{\"id\":\"69ec33ec-fbda-4e21-bc6d-9ca04b1b3a49\",\"reference\":\"13933\",\"legacyNumericId\":\"29527000004972\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/jardines-kalea/ibaiondo/bilbao/69ec33ec-fbda-4e21-bc6d-9ca04b1b3a49/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/ibaiondo/s\",\"summary\":{\"title\":\"Salazar alquila vivienda en el casco viejo  alquiler para corta estancias\",\"description\":\"INMOBILIARIA  SALAZAR, alquila partamento de dise\u00F1o rehabilitado PARA CORTA TEMPORADA CON CAUSA JUSTIFICADA EN CONTRATO, muy luminoso, en edificio de 1858, se alquila por temporada/mensual, todos los gastos incluidos en el precio, totalmente equipado para 2/4 personas, tanto cocina, como ropa de cama y ropa de ba\u00F1o, con una habitaci\u00F3n doble independiente, armarios empotrados, sof\u00E1 cama (1,60m. ) y capacidad para 4 personas.\\r\\nLos suministros de gas, electricidad, agua y wifi est\u00E1n incluidos en el precio.  DISPONIBLE EN NOVIEMBRE\\r\\nEl presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.\\r\\n \\r\\n \",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Ibaiondo\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Jardines Kalea\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":43.258616414771616,\"longitude\":-2.9248059878375443},\"displayAddressLine\":\"Jardines Kalea\",\"displayZoneLine\":\"Ibaiondo, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Casco Viejo\",\"slug\":\"casco-viejo\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Ibaiondo\",\"slug\":\"ibaiondo\"},{\"type\":\"street\",\"value\":\"Calle Barrenkalebarrena\",\"slug\":\"calle-barrenkalebarrena\"},{\"type\":\"street\",\"value\":\"Calle el Perro\",\"slug\":\"calle-el-perro\"},{\"type\":\"street\",\"value\":\"Calle Victor\",\"slug\":\"calle-victor\"},{\"type\":\"street\",\"value\":\"Calle Arenal\",\"slug\":\"calle-arenal\"},{\"type\":\"street\",\"value\":\"Calle Loteria\",\"slug\":\"calle-loteria\"},{\"type\":\"street\",\"value\":\"Plaza Arriaga\",\"slug\":\"plaza-arriaga\"},{\"type\":\"street\",\"value\":\"Calle Santa Maria\",\"slug\":\"calle-santa-maria\"},{\"type\":\"street\",\"value\":\"Calle Bidebarrieta\",\"slug\":\"calle-bidebarrieta\"},{\"type\":\"street\",\"value\":\"Plaza Santiago\",\"slug\":\"plaza-santiago\"},{\"type\":\"street\",\"value\":\"Calle la Torre\",\"slug\":\"calle-la-torre\"},{\"type\":\"street\",\"value\":\"Calle Barrenkale\",\"slug\":\"c