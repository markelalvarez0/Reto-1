\",\"COMMUNITY_AREA\",\"SPORTS_AREA\",\"CHILDREN_AREA\",\"GYM\",\"PETS_ALLOWED\",\"EQUIPPED_KITCHEN\"]},\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_EXTERIOR\",\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1600,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1600,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@achproperties.es\",\"phone\":\"+34607645425\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/lehendakari-aguitte/deusto/bilbao/890d8558-3893-47e9-b845-c745d2202cbf/d\",\"feature\":null,\"short\":\"/a/890d8558-3893-47e9-b845-c745d2202cbf\"}},{\"id\":\"ad5d0bfa-4c1a-4adc-9d16-0632adef3382\",\"reference\":\"1108\",\"legacyNumericId\":\"38326000000264\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/montevideo/basurtu-zorrotza/bilbao/ad5d0bfa-4c1a-4adc-9d16-0632adef3382/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/basurtu-zorrotza/s\",\"summary\":{\"title\":\"Estupendo piso en alquiler de tres habitaciones\",\"description\":\"\\nALQUILER TEMPORAL. SOLO  ESTUDIANTES !!\\nVivienda en alquiler para estudiantes. Piso muy bien ubicado cerca de termib\u00FAs y el Hospital de Basurto. La vivienda se distribuye en hall, sal\u00F3n-comedor, cocina completa tres dormitorios totalmente equipados y dos ba\u00F1os completos.\\n\\n\\nACH Properties  est\u00E1 formado por profesionales con m\u00E1s de 20 a\u00F1os de trayectoria en el sector inmobiliario y tiene como principal objetivo satisfacer las necesidades de vendedores y compradores de todo tipo de inmuebles.\\n\\n\\n\\n\\n\\nCon el fin de otorgar la m\u00E1xima eficacia en todo el proceso de comercializaci\u00F3n, nuestro equipo focaliza gran parte de sus esfuerzos en tres fines que considera esenciales: atenci\u00F3n personalizada, m\u00E1xima digitalizaci\u00F3n y total seguridad y transparencia. \\n\\n\\nACH Properties  est\u00E1 formado por profesionales con m\u00E1s de 20 a\u00F1os de trayectoria en el sector inmobiliario y tiene como principal objetivo satisfacer las necesidades de vendedores y compradores de todo tipo de inmuebles.\\n\\nCon el fin de otorgar la m\u00E1xima eficacia en todo el proceso de comercializaci\u00F3n, el equipo de ACH focaliza gran parte de sus esfuerzos en tres fines que considera esenciales: atenci\u00F3n personalizada, m\u00E1xima digitalizaci\u00F3n y total seguridad y transparencia.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Basurtu - Zorrotza\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Montevideo\",\"streetNumber\":null},\"coordinates\":{\"latitude\":43.2582323887595,\"longitude\":-2.951948638350018},\"displayAddressLine\":\"Montevideo\",\"displayZoneLine\":\"Basurtu - Zorrotza, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Basurtu\",\"slug\":\"basurtu\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Basurtu - Zorrotza\",\"slug\":\"basurtu-zorrotza\"},{\"type\":\"street\",\"value\":\"Plaza Garellano\",\"slug\":\"plaza-garellano\"},{\"type\":\"street\",\"value\":\"Avenida Montevideo\",\"slug\":\"avenida-montevideo\"},{\"type\":\"street\",\"value\":\"Calle Iturribarria\",\"slug\":\"calle-iturribarria\"},{\"type\":\"street\",\"value\":\"Carretera Basurtu-Kastrexana\",\"slug\":\"carretera-basurtu-kastrexana\"},{\"type\":\"street\",\"value\":\"Calle Basurtubekoa\",\"slug\":\"calle-basurtubekoa\"},{\"type