s\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-10T19:47:40.5718019+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":2,\"bathrooms\":2,\"builtSurface\":92,\"landArea\":null,\"terrace\":{\"has\":true},\"floor\":\"SIXTH\",\"features\":{\"has\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\",\"BALCONY\"],\"hasNot\":[\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"EAST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"D\",\"value\":83},\"emissions\":{\"label\":\"D\",\"value\":17}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_MODERN\",\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1400,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1400,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@ihbilbao.com\",\"phone\":\"+34946510000\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/republica-de-begona-kalea/ibaiondo/bilbao/e46a5bd3-d9c0-47da-bea4-d6379c5f7a34/d\",\"feature\":null,\"short\":\"/a/e46a5bd3-d9c0-47da-bea4-d6379c5f7a34\"}},{\"id\":\"16ab205c-3885-4e68-8cb2-57b4b3588521\",\"reference\":\"13044\",\"legacyNumericId\":\"29527000004229\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/hurtado-de-amezaga-kalea/abando-albia/bilbao/16ab205c-3885-4e68-8cb2-57b4b3588521/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/abando-albia/s\",\"summary\":{\"title\":\"ALQUILER VIVIENDA JUNTO A LA ESTACI\u00D3N DE ABANDO PARA EMPRESAS\",\"description\":\"INMOBILIARIA SALAZAR ALQUILA GRAN VIVIENDA junto a la ESTACI\u00D3N DE ABANDO para EMPRESAS.  DISPONIBLE 01 DE ENERO 2027.\\r\\nLa vivienda tiene una ubicaci\u00F3n fant\u00E1stica, junto a la Estaci\u00F3n de Abando, a un paso de los autobuses a la UPV y con todas las comunicaciones muy cerquita de la vivienda. Es una zona muy comercial y la Plaza Indautxu o la Plaza Moyua est\u00E1n a 10 minutos andando. \\r\\nLa vivienda es muy amplia y se distribuye en un gran sal\u00F3n comedor, cocina equipada con zona de comedor, 6 dormitorios, todos ellos espaciosos y cuenta adem\u00E1s con dos ba\u00F1os, ambos con ducha. Dispone de agua caliente y calefacci\u00F3n de gas natural individual y se ubica en un edificio con ascensor a cota 0. \\r\\nDISPONIBLE 01 DE ENERO DE 2027\\r\\nNo lo dudes y ll\u00E1manos para verlo!\\r\\nEl presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.\\r\\n \\r\\n \\r\\n \",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Abando - Albia\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Hurtado de Amezaga Kalea\",\"streetNumber\":\"3\"},\"coordinates\":{\"latitude\":43.25944627726581,\"longitude\":-2.930581549254498},\"displayAddressLine\":\"Hurtado de Amezaga Kalea\",\"displayZoneLine\":\"Abando - Albia, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Zabalburu\",\"slug\":\"zabalburu\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Abando - Albia\",\"slug\":\"abando-albia\"},{\"type\":\"street\",\"value\":\"Calle Hurtado de Amezaga\",\"slug\":\"calle-hurtado-de-amezaga\"},{\"type\":\"street\",\"value\":\"Calle Garcia Salazar\",\"slug\":\"calle-garcia-salazar\"},{\"type\":\"street\",\"value\":\"Calle Euskalduna\",\"slug\":\"calle-euskalduna\"},{\"type\":\"street\",\"value\":\"Calle Lutxana\",\"slug\":\"calle-lutxana\"},{\"type\":\"street\",\"value\":\"Travesia Euskalduna\",\"slug\":\"travesia-euskalduna\"},{\"type\":\"street\",\"value\":\"Calle Bertendona\",\"slug\":\"calle-bertendona\"},{\"type\":\"street\",\"value\":\"Alameda Urquijo\",\"slug\":\"alameda-urquijo\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48008\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2025\"},{\"level\":\"neighbourhood\",\"code\":\"831\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/9caa1ac8-4740-4cd6-b039-989150291273?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f676fc10-444b-4d6b-92f0-ecb937bec8b1?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/imag