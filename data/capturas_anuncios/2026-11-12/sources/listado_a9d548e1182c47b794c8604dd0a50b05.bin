riginal\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f7cb210a-7488-4720-980b-895c5283b249?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":35,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"fea4910d-2d26-49b8-9e1f-6c245eae7e56\",\"name\":\"Infinity Homes Bilbao, Sl\",\"tradeName\":\"Infinity Homes\",\"logo\":\"https://static.fotocasa.es/images/client/fea4910d-2d26-49b8-9e1f-6c245eae7e56/20241125090707?rule=original\",\"website\":\"https://www.ihbilbao.com/\",\"navigationUrl\":\"/inmobiliaria/infinity-homes/\",\"legacyPublisherId\":\"38192\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-10T20:52:08.6025308+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"ALMOST_NEW\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":87,\"landArea\":null,\"floor\":\"THIRD\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"NORTH\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":338},\"emissions\":{\"label\":\"E\",\"value\":57}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_ADAPTED_FOR_WHEELCHAIR\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1372,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1372,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@ihbilbao.com\",\"phone\":\"+34946510000\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/prim-kalea/ibaiondo/bilbao/f2609c78-cc33-4314-910b-6d2d798fdbe4/d\",\"feature\":null,\"short\":\"/a/f2609c78-cc33-4314-910b-6d2d798fdbe4\"}},{\"id\":\"f792d74b-f285-40b8-aaff-15fee5c1f42f\",\"reference\":\"I-04A5YV-W-04A5YV\",\"legacyNumericId\":\"29658000000639\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/apartamento/abando-albia/bilbao/f792d74b-f285-40b8-aaff-15fee5c1f42f/d\",\"listingNavigationUrl\":\"/alquiler/apartamentos/bizkaia-provincia/bilbao/abando-albia/s\",\"summary\":{\"title\":\"Vivienda de obra nueva , a estrenar , en Rodr\u00EDguez Arias\",\"description\":\"La vivienda se encuentra en el edificio ACRUX de reciente construcci\u00F3n y m\u00E1xima calificaci\u00F3n energ\u00E9tica, ascensor a cota 0 y dispone de plaza de garaje de acceso directo en el mismo edificio y amplio trastero.\\n\\nEl inmueble se compone de hall-recibidor, con acceso a sal\u00F3n y cocina independiente equipada con todos los electrodom\u00E9sticos y con salida a amplio balc\u00F3n en la fachada principal. La parte privada se distribuye en tres dormitorios , uno de ellos con ba\u00F1o incorporado, todos ellos con armarios empotrados, y un segundo ba\u00F1o con ba\u00F1era de hidromasaje y ducha.\\n\\nLa calefacci\u00F3n es individual por suelo radiante. \\n\\nEl edificio residencial ACRUX ofrece adem\u00E1s dos espacios de uso comunitario: sol\u00E1rium en la azotea y sala multiusos/deportiva.\\nC\u00E9ntrica ubicaci\u00F3n en una de las zonas m\u00E1s demandadas de la ciudad, junto a la Diputaci\u00F3n y Plaza Moy\u00FAa, rodeada de todo tipo de comercios, servicios, transporte p\u00FAblico, estaci\u00F3n de metro frente al portal y paradas de autob\u00FAs y taxi.\",\"location\":{\"visibility\":\"ZONE\",\"municipality\":\"Bilbao\",\"district\":\"Abando - Albia\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Rodr\u00EDguez Arias Kalea\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":43.26070706260456,\"longitude\":-2.933348106463427},\"displayAddressLine\":null,\"displayZoneLine\":\"Abando - Albia, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Ensanche - Moyua - Diputaci\u00F3n\",\"slug\":\"ensanche-moyua-diputacion\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Abando - Albia\",\"slug\":\"abando-albia\"},{\"type\":\"street\",\"value\":\"Calle Marques del Puerto\",\"slug\":\"calle-marques-del-puerto\"},{\"type\":\"street\",\"value\":\"Plaza Pedro Eguillor\",\"slug\":\"plaza-pedro-eguillor\"},{\"type\":\"street\",\"value\":\"Calle Cardenal Gardoqui\",\"slug\":\"calle-cardenal-gardoqui\"},{\"type\":\"street\",\"value\":\"Calle Elcano\",\"slug\":\"calle-elcano\"},{\"type\":\"street\",\"value\":\"Calle Astarloa\",\"slug\":\"calle-astarloa\"},{\"type\":\"street\",\"value\":\"Calle Arbieto\",\"slug\":\"calle-arbieto\"},{\"type\":\"street\",\"value\":\"Calle Rodriguez Arias\",\"slug\":\"calle-rodriguez-arias\"},{\"type\":\"street\",\"value\":\"Calle Gran Via Don Diego Lopez de Haro\",\"slug\":\"calle-gran-via-don-diego-lopez-de-haro\"},{\"type\":\"street\",\"value\":\"Calle Licenciado Poza\",\"slug\":\"calle-licenciado-poza\"},{\"type\":\"street\",\"value\":\"Calle Diputacion\",\"slug\":\"calle-diputacion\"},{\"type\":\"street\",\"value\":\"Calle Bertendona\",\"slug\":\"calle-bertendona\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00ED