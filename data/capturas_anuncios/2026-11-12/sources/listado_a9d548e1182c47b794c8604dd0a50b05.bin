Id\":\"38192\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-09T14:45:51.2243669+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":115,\"landArea\":null,\"terrace\":{\"has\":true},\"floor\":\"SIXTH\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"WEST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":258},\"emissions\":{\"label\":\"E\",\"value\":36}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1650,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1650,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@ihbilbao.com\",\"phone\":\"+34946510000\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/mugica-y-butron-kalea/uribarri/bilbao/1c81f11d-12c7-436e-a9b3-a130220c08a3/d\",\"feature\":null,\"short\":\"/a/1c81f11d-12c7-436e-a9b3-a130220c08a3\"}},{\"id\":\"1d32e635-4399-4ba3-9499-b536ac518d3a\",\"reference\":\"3964\",\"legacyNumericId\":\"38192000002717\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/lamana-kalea/ibaiondo/bilbao/1d32e635-4399-4ba3-9499-b536ac518d3a/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/ibaiondo/s\",\"summary\":{\"title\":\"Se alquila ESPECTACULAR ATICO CON TERRAZA junto a la ESTACION DE ABANDO\",\"description\":\"INMOBILIARIA INFINITY alquila POR CORTAS TEMPORADAS ESTUPENDO ATICO CON ESPECTACULAR TERRAZA completamente exterior y con salida a la terraza desde todas las estancias de la casa. Se distribuye en hall de entrada, amplio sal\u00F3n con acceso a una gran despensa, cocina nueva completamente equipada, dos habitaciones y dos ba\u00F1os completos, uno de ellos en suite en la habitaci\u00F3n principal. La vivienda esta adaptada para personas con movilidad reducida y es accesible para silla de ruedas, as\u00ED como el propio edificio que tambi\u00E9n esta adaptado para una correcta accesibilidad. Terraza con accesibilidad y equipada con tres toldos motorizados para poder disfrutarla todo el d\u00EDa. \\r\\nDISPONIBLE 01 DE ENERO\\r\\nVen a visitarlo, te los ense\u00F1amos encantadas.INFINITY HOMES.\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Ibaiondo\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Lamana Kalea\",\"streetNumber\":\"2\"},\"coordinates\":{\"latitude\":43.257196494212636,\"longitude\":-2.9288440204375092},\"displayAddressLine\":\"Lamana Kalea\",\"displayZoneLine\":\"Ibaiondo, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"San Francisco\",\"slug\":\"san-francisco\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Ibaiondo\",\"slug\":\"ibaiondo\"},{\"type\":\"street\",\"value\":\"Calle Naja\",\"slug\":\"calle-naja\"},{\"type\":\"street\",\"value\":\"Calle Dos de Mayo\",\"slug\":\"calle-dos-de-mayo\"},{\"type\":\"street\",\"value\":\"Calle Luis Iruarrizaga\",\"slug\":\"calle-luis-iruarrizaga\"},{\"type\":\"street\",\"value\":\"Puente la Merced\",\"slug\":\"puente-la-merced\"},{\"type\":\"street\",\"value\":\"Muelle la Merced\",\"slug\":\"muelle-la-merced\"},{\"type\":\"street\",\"value\":\"Calle Hernani\",\"slug\":\"calle-hernani\"},{\"type\":\"street\",\"value\":\"Calle Particular del Norte\",\"slug\":\"calle-particular-del-norte\"},{\"type\":\"street\",\"value\":\"Calle General Castillo\",\"slug\":\"calle-general-castillo\"},{\"type\":\"street\",\"value\":\"Calle Lamana\",\"slug\":\"calle-lamana\"},{\"type\":\"street\",\"value\":\"Calle Bailen\",\"slug\":\"calle-bailen\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48003\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2030\"},{\"level\":\"neighbourhood\",\"code\":\"649\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/30f317d5-d283-4dd2-a9cb-3cd