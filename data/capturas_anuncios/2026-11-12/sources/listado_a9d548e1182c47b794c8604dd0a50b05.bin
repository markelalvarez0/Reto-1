//static.fotocasa.es/images/ads/221bbe53-fd05-42c9-b684-7c530c577c80?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e5a64c5b-8174-40e0-ada6-d000504b604f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2be14df2-eb18-473c-a123-9409809196ef?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/8e51b69a-a737-4d43-a27a-ce2619a67d4e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/310ee7f9-38f4-4496-865e-45a0db6935ab?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a28720db-1236-41fa-9513-56f0aac7cfa8?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ee87ed33-3559-4e23-8948-06df8dfe32dd?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":24,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"2cdb03f2-20b4-4c5d-a0d3-dafdbe423bef\",\"name\":\"ANA M\u00AASALAZAR FONTAL\",\"tradeName\":\"Inmobiliaria Salazar\",\"logo\":\"https://static.fotocasa.es/images/client/2cdb03f2-20b4-4c5d-a0d3-dafdbe423bef/20261014170323?rule=original\",\"website\":\"http://www.inmosalazar.com/\",\"navigationUrl\":\"/inmobiliaria/inmobiliaria-salazar/\",\"legacyPublisherId\":\"29527\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T15:54:12.0362659+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":6,\"bathrooms\":2,\"builtSurface\":190,\"landArea\":null,\"floor\":\"SECOND\",\"features\":{\"has\":[\"ELEVATOR\",\"WARDROBES\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"WEST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":81},\"emissions\":{\"label\":\"E\",\"value\":33}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":2900,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":2900,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@inmosalazar.com\",\"phone\":\"+34946465015\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/hurtado-de-amezaga-kalea/abando-albia/bilbao/16ab205c-3885-4e68-8cb2-57b4b3588521/d\",\"feature\":null,\"short\":\"/a/16ab205c-3885-4e68-8cb2-57b4b3588521\"}},{\"id\":\"291a421e-babb-42de-a42e-045ddc260ff8\",\"reference\":\"13938\",\"legacyNumericId\":\"29527000004977\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/errekalde/bilbao/291a421e-babb-42de-a42e-045ddc260ff8/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/errekalde/s\",\"summary\":{\"title\":\"SALAZAR ALQUILA ERASMUS 2027 EN AMETZOLA\",\"description\":\"INMOBILIARIA SALAZAR, alquila piso PARA ERASMUS FEBRERO-JUNIO 2027 en la zona de Am\u00E9tzola.\\r\\nCon una distribuci\u00F3n de vest\u00EDbulo, tres habitaciones  (una con salida a balc\u00F3n), sal\u00F3n comedor y cocina equipada.   Exterior muy luminoso.\\r\\nCuenta con agua caliente y calefacci\u00F3n de gas natural individual.\\r\\nInmueble con ascensor a cota cero.\\r\\nCon todos los servicios esenciales a mano y con varias lineas de autob\u00FAs.  A cinco minutos andando del centro y de boca de metro.\\r\\nLLAMANOS Y TE LO ENSE\u00D1AREMOS ENCANTADOS.\\r\\n \\r\\nEl presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.\\r\\n \\r\\n \",\"location\":{\"visibility\":\"ZONE\",\"municipality\":\"Bilbao\",\"district\":\"Errekalde\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Carmelo Gil Doktoreen Kalea\",\"streetNumber\":\"10\"},\"coordinates\":{\"latitude\":43.25586399260947,\"longitude\":-2.9407797190668816},\"displayAddressLine\":null,\"displayZoneLine\":\"Errekalde, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Ametzola\",\"slug\":\"ametzola\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Errekalde\",\"slug\":\"errekalde\"},{\"type\":\"street\",\"value\":\"Calle Labayru\",\"slug\":\"calle-labayru\"},{\"type\":\"street\",\"value\":\"Calle Dolores Ibarruri\",\"slug\":\"calle-dolores-ibarruri\"},{\"type\":\"street\",\"value\":\"Calle General Salazar\",\"slug\":\"calle-general-salazar\"},{\"type\":\"street\",\"value\":\"Calle Doctores Carmelo Gil\",\"slug\":\"calle-doctores-carmelo-gil\"},{\"type\":\"street\",\"value\":\"Calle Autonomia\",\"slug\":\"calle-autonomia\"},{\"type\":\"street\",\"value\":\"Calle Avila\",\"slug\":\"calle-avila\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48012\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2029\"},{\"level\":\"neighbourhood\",\"code\":\"625\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/926113d4-b7b9-496f-95d9-e3c85de46a44?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/58196e43-7e2d-4924-8e1f-c68a68c64520?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b9da2a11-b976-4f1e-957b-cad64422ed49?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/8c35a166-5293-4f37-af82-f0a4226cba8f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/21a398c6-ef13-4346-8872-37482b933cb4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e7a83c6f-e932-4cdd-b36f-df0c18265c66?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b9a43b44-9bb8-47dd-8e9f-4fbea7d633f3?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d5d52521-ba77-4695-808e-56203b51db17?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6ae6c692-bc18-427c-bb56-206cc3cf4d07?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/78ffb562-9e90-41f5-b5e9