sa.es/images/ads/3d62b302-9744-416f-982e-a11ede2fc687?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/19499e9d-14e6-4dc4-afb5-f7f215c55a9c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/39d79fd3-6ad2-4662-a4b6-86e674d8e57c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/adc8bec0-fe8b-4e27-b718-d57850b0f800?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/70ccbdf2-2022-4c4c-8a96-8868c9062d17?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":23,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"2cdb03f2-20b4-4c5d-a0d3-dafdbe423bef\",\"name\":\"ANA M\u00AASALAZAR FONTAL\",\"tradeName\":\"Inmobiliaria Salazar\",\"logo\":\"https://static.fotocasa.es/images/client/2cdb03f2-20b4-4c5d-a0d3-dafdbe423bef/20261014170323?rule=original\",\"website\":\"http://www.inmosalazar.com/\",\"navigationUrl\":\"/inmobiliaria/inmobiliaria-salazar/\",\"legacyPublisherId\":\"29527\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T11:20:09.5782968+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":2,\"bathrooms\":2,\"builtSurface\":81,\"landArea\":null,\"terrace\":{\"has\":true},\"floor\":\"FIRST\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"EAST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":142},\"emissions\":{\"label\":\"E\",\"value\":30}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1295,\"currency\":null,\"hidden\":false,\"priceDrop\":{\"reductionAmount\":105},\"priceRaise\":null},\"trackingPrice\":1295,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@inmosalazar.com\",\"phone\":\"+34946465015\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/perez-galdos-kalea/indautxu/bilbao/a04dcbdf-da2a-458a-b710-4f83035a28c4/d\",\"feature\":null,\"short\":\"/a/a04dcbdf-da2a-458a-b710-4f83035a28c4\"}},{\"id\":\"bb80d420-26ed-40af-a9fe-53af0b000a46\",\"reference\":\"4085\",\"legacyNumericId\":\"38192000002798\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/sagarminaga-kalea/begona-santutxu/bilbao/bb80d420-26ed-40af-a9fe-53af0b000a46/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/begona-santutxu/s\",\"summary\":{\"title\":\"SE ALQUILA MAGNIFICA VIVIENDA TEMPORAL EN SANTUTXU\",\"description\":\"INFINITY HOMES ALQUILA Vivienda completamente exterior!! POR TEMPORADAS, con ascensor a cota cero, ideal para quienes buscan comodidad, y una ubicaci\u00F3n accesible.La vivienda est\u00E1 distribuida en: Acogedor hall de entrada, Amplia sala de estar, luminosa y confortable, Cocina completamente equipada con electrodom\u00E9sticos. Ba\u00F1o completo con amplio plato de ducha. y Tres habitaciones con excelente distribuci\u00F3nVive en una zona bien comunicada, con todos los servicios cerca y con f\u00E1cil acceso al transporte p\u00FAblico.\\r\\nDIPONIBLE 21 de Diciembre Se alquila amueblado y totalmente equipado, perfecto para instalarse sin preocupaciones. Adem\u00E1s, dispone de calefacci\u00F3n individual el\u00E9ctrica, para mayor confort durante todo el a\u00F1o.\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\\r\\nVen a verla, te la ense\u00F1amos encantadas, INFINITY HOMES.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Bego\u00F1a - Santutxu\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Sagarminaga Kalea\",\"streetNumber\":\"5\"},\"coordinates\":{\"latitude\":43.2492647551862,\"longitude\":-2.9131512512117297},\"displayAddressLine\":\"Sagarminaga Kalea\",\"displayZoneLine\":\"Bego\u00F1a - Santutxu, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Santutxu - Basarrate\",\"slug\":\"santutxu-basarrate\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Bego\u00F1a - Santutxu\",\"slug\":\"begona-santutxu\"},{\"type\":\"street\",\"value\":\"Calle Santa Cecilia\",\"slug\":\"calle-santa-cecilia\"},{\"type\":\"street\",\"value\":\"Calle Ogovo\",\"slug\":\"calle-ogovo\"},{\"type\":\"street\",\"value\":\"Calle Kalamua\",\"slug\":\"calle-kalamua\"},{\"type\":\"street\",\"value\":\"Grupo Sagarminaga\",\"slug\":\"grupo-sagarminaga\"},{\"type\":\"street\",\"value\":\"Calle Sagarminaga\",\"slug\":\"calle-sagarminaga\"},{\"type\":\"street\",\"value\":\"Grupo Union Begoresa\",\"slug\":\"grupo-union-begoresa\"},{\"type\":\"street\",\"value\":\"Calle Pintor Losada\",\"slug\":\"calle-pintor-losada\"},{\"type\":\"street\",\"value\":\"Calle Luis Luciano Bonaparte\",\"slug\":\"calle-luis-luciano-bonaparte\"},{\"type\":\"street\",\"value\":\"Calle Cocherito de Bilbao\",\"slug\":\"calle-cocherito-de-bilbao\"},{\"type\":\"street\",\"value\":\"Calle San Joaquin\",\"slug\":\"calle-san-joaquin\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48004\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2027\"},{\"level\":\"neighbourhood\",\"code\":\"652\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d5fcc79e-970d-494a-bff3-c98ec363b25f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/7f3a9b15-3618-4bc7-9269-5629edba4508?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a33dd3ff-87f6-4dca-925e-fb1075618db3?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c03e1f97-e6fd-4984-929b-f3f4f66fba35?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/1aed4cb6-0c3d-425f-9792-e3f3733b1dad?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e3c9712d-42be-4844-a102-2527923ca0e7?rule=original\",\"position\"