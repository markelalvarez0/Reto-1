-homes/" aria-label="Logo de Infinity Homes Bilbao, Sl" class="relative z-raised -mt-lg -mb-lg -translate-y-1/3 @xs:mt-none @xs:mb-none @xs:translate-y-0 block shrink-0" tabindex="-1" data-panot-component="link-box-raised"><div class="flex shrink-0 items-center justify-center overflow-hidden rounded-md border-sm border-outline-variant bg-surface p-none [&amp;&gt;picture]:size-full h-56 w-112"><picture><source media="(max-width: 600px)" srcSet="https://static.fotocasa.es/images/client/fea4910d-2d26-49b8-9e1f-6c245eae7e56/20241125090707?rule=web_360x0_ar"/><source media="(min-width: 601px)" srcSet="https://static.fotocasa.es/images/client/fea4910d-2d26-49b8-9e1f-6c245eae7e56/20241125090707?rule=web_360x0_ar"/><img src="https://static.fotocasa.es/images/client/fea4910d-2d26-49b8-9e1f-6c245eae7e56/20241125090707?rule=web_360x0_ar" alt="" loading="lazy" class="block size-full object-cover" decoding="async"/></picture></div></a></div><h3 class="m-none line-clamp-2 text-body-1 font-bold text-main hover:text-support"><a title="Piso con terraza en alquiler en Lamana Kalea" class="static before:absolute before:left-none before:top-none before:z-base before:block before:size-full before:content-[&#x27;&#x27;] text-main no-underline hover:no-underline hover:text-support leading-snug font-bold" data-panot-component="link-box-link" href="/alquiler/planta-intermedia/lamana-kalea/ibaiondo/bilbao/1d32e635-4399-4ba3-9499-b536ac518d3a/d">Piso con terraza en alquiler en Lamana Kalea</a></h3><p class="m-none flex items-start gap-sm text-body-2 text-on-neutral mt-auto"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" data-title="poi_outline" fill="currentColor" stroke="none" class="w-16 h-16 shrink-0 text-on-neutral" aria-hidden="true" focusable="false" data-panot-component="icon"><path d="M11.08.487C9.824.605 8.312 1.12 7.22 1.8a9.301 9.301 0 0 0-2.782 2.706c-1.61 2.441-1.929 5.402-.915 8.517.99 3.046 3.41 6.41 6.699 9.315.779.688 1.441.898 2.278.722.449-.094.786-.287 1.294-.