id\":\"2cdb03f2-20b4-4c5d-a0d3-dafdbe423bef\",\"name\":\"ANA M\u00AASALAZAR FONTAL\",\"tradeName\":\"Inmobiliaria Salazar\",\"logo\":\"https://static.fotocasa.es/images/client/2cdb03f2-20b4-4c5d-a0d3-dafdbe423bef/20261014170323?rule=original\",\"website\":\"http://www.inmosalazar.com/\",\"navigationUrl\":\"/inmobiliaria/inmobiliaria-salazar/\",\"legacyPublisherId\":\"29527\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T15:54:07.9005492+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"ALMOST_NEW\",\"rooms\":1,\"bathrooms\":1,\"builtSurface\":70,\"landArea\":null,\"floor\":\"THIRD\",\"features\":{\"has\":[\"WARDROBES\",\"FURNISHED\",\"BALCONY\"],\"hasNot\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"EAST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":143},\"emissions\":{\"label\":\"E\",\"value\":67}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":2150,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":2150,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@inmosalazar.com\",\"phone\":\"+34946465015\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/jardines-kalea/ibaiondo/bilbao/69ec33ec-fbda-4e21-bc6d-9ca04b1b3a49/d\",\"feature\":null,\"short\":\"/a/69ec33ec-fbda-4e21-bc6d-9ca04b1b3a49\"}},{\"id\":\"7120bd1a-049a-4c86-b73d-1e304aab17c1\",\"reference\":\"4089\",\"legacyNumericId\":\"38192000002800\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/perez-galdos-kalea/indautxu/bilbao/7120bd1a-049a-4c86-b73d-1e304aab17c1/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/indautxu/s\",\"summary\":{\"title\":\"ALQUILER TEMPORAL EN INDAUTXU\",\"description\":\"Se ALQUILA vivienda para ALQUILER TEMPORAL ubicada en la PLAZA BOMBERO ECH\u00C1NIZ, a 2 minutos de la PLAZA INDAUTXU con el metro y de la parada de autob\u00FAs a la UPV y rodeado de multitud de comercios, supermercados, centro de salud y todos los servicios necesarios a un paso de la vivienda. Se distribuye en 3 dormitorios totalmente equipados para estudiantes, cama, armario y zona de estudio, una cocina totalmente equipada con zona para comer y estar y un ba\u00F1o con ducha. Toda la vivienda se encuentra a estrenar, la obra se est\u00E1 terminando actualmente y los inquilinos estrenar\u00E1n todas las dependencias y el mobiliario de la vivienda. Dispone de agua caliente y calefacci\u00F3n de gas individual. Su ubicaci\u00F3n es inmejorable para vivir en Bilbao, c\u00E9ntrico y muy bien comunicado, pero en una zona muy tranquila para poder estudiar comodamente, no lo dudes y ll\u00E1manos para verlo!\\r\\nDISPONIBLE 12 DE DICIEMBRE\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Indautxu\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"P\u00E9rez Gald\u00F3s Kalea\",\"streetNumber\":\"3\"},\"coordinates\":{\"latitude\":43.25969931263466,\"longitude\":-2.946309768528863},\"displayAddressLine\":\"P\u00E9rez Gald\u00F3s Kalea\",\"displayZoneLine\":\"Indautxu, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Sabino Arana - Jesuitas\",\"slug\":\"sabino-arana-jesuitas\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Indautxu\",\"slug\":\"indautxu\"},{\"type\":\"street\",\"value\":\"Calle Perez Galdos\",\"slug\":\"calle-perez-galdos\"},{\"type\":\"street\",\"value\":\"Calle General Eguia\",\"slug\":\"calle-general-eguia\"},{\"type\":\"street\",\"value\":\"Calle Jose Maria Escuza\",\"slug\":\"calle-jose-maria-escuza\"},{\"type\":\"street\",\"value\":\"Avenida Sabino Arana\",\"slug\":\"avenida-sabino-arana\"},{\"type\":\"street\",\"value\":\"Calle Maria Diaz de Haro\",\"slug\":\"calle-maria-diaz-de-haro\"},{\"type\":\"street\",\"value\":\"Avenida el Ferrocarril\",\"slug\":\"avenida-el-ferrocarril\"},{\"type\":\"street\",\"value\":\"Calle Simon Bolivar\",\"slug\":\"calle-simon-bolivar\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48010\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level