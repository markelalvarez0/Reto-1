es\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"PRIVATE_PARKING\",\"NEARBY_PUBLIC_TRANSPORT\",\"SUITE_BATHROOM\",\"BALCONY\",\"HOME_APPLIANCES\"],\"hasNot\":[\"PETS_ALLOWED\",\"STORAGE_ROOM\",\"PRIVATE_GARDEN\",\"YARD\",\"AIR_CONDITIONER\",\"SECURITY_DOOR\",\"COMMUNITY_POOL\",\"PRIVATE_POOL\",\"FIREPLACE\",\"ALARM\",\"SURVEILLANCE_SYSTEM\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"OFFICE_KITCHEN\",\"DOORMAN\",\"JACUZZI\",\"SAUNA\",\"TENNIS_COURT\",\"GYM\",\"SPORTS_AREA\",\"CHILDREN_AREA\",\"HOME_AUTOMATION\",\"INTERNET\",\"PARQUET\",\"STONEWARE\",\"OVEN\",\"WASHING_MACHINE\",\"DISHWASHER\",\"MICROWAVE\",\"FRIDGE\",\"DRYER\",\"TV\"]},\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1710,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1710,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"juan@icampuzano.es\",\"phone\":\"+34944077077\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/basurtu-kastrexana-errepidea/basurtu-zorrotza/bilbao/74782334-b82d-472c-8f71-384c53dff7fa/d\",\"feature\":null,\"short\":\"/a/74782334-b82d-472c-8f71-384c53dff7fa\"}},{\"id\":\"c89d79f3-e1b3-4bf7-81d4-49f3e3a58977\",\"reference\":\"3600\",\"legacyNumericId\":\"30081000005887\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/urkixo-zumarkalea/indautxu/bilbao/c89d79f3-e1b3-4bf7-81d4-49f3e3a58977/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/indautxu/s\",\"summary\":{\"title\":null,\"description\":\"INMOBILIARIA CAMPUZANO presenta en alquiler este magn\u00EDfico piso, situado en un edificio totalmente rehabilitado, con excelentes calidades y acabados de lujo.\\n\\nDISPONIBLE A PARTIR DE DICIEMBRE.\\n\\nLa vivienda destaca por su altura, luminosidad y amplios ventanales, que proporcionan una gran sensaci\u00F3n de amplitud y luz natural.\\nLa distribuci\u00F3n es c\u00F3moda y funcional y consta de:\\n Amplio y luminoso sal\u00F3n-comedor.\\n Cocina equipada.\\n Dos dormitorios, uno de ellos con armarios empotrados.\\n Dos cuartos de ba\u00F1o.\\nLa vivienda se alquila sin amueblar, con la cocina y los ba\u00F1os totalmente equipados.\\nDispone de calefacci\u00F3n individual de gas natural y ascensor a cota cero, ofreciendo adem\u00E1s una excelente accesibilidad.\\nSe requiere solvencia econ\u00F3mica demostrable, un mes de fianza y una mensualidad de garant\u00EDa adicional\\nPara m\u00E1s informaci\u00F3n, consulte con INMOBILIARIA CAMPUZANO.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Indautxu\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Urkixo Zumarkalea\",\"streetNumber\":\"41\"},\"coordinates\":{\"latitude\":43.259996666242316,\"longitude\":-2.935894014799942},\"displayAddressLine\":\"Urkixo Zumarkalea\",\"displayZoneLine\":\"Indautxu, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Alh\u00F3ndiga\",\"slug\":\"alhondiga\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Indautxu\",\"slug\":\"indautxu\"},{\"type\":\"street\",\"value\":\"Calle Telesforo Aranzadi\",\"slug\":\"calle-telesforo-aranzadi\"},{\"type\":\"street\",\"value\":\"Calle Licenciado Poza\",\"slug\":\"calle-licenciado-poza\"},{\"type\":\"street\",\"value\":\"Calle General Concha\",\"slug\":\"calle-general-concha\"},{\"type\":\"street\",\"value\":\"Alameda Recalde\",\"slug\":\"a