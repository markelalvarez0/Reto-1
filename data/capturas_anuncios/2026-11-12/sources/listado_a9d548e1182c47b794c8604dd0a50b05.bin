ads/590bebdd-02e6-48b9-91b5-a2a86e38f24c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3df214fd-d54a-491b-86d1-1873d9c7fcbe?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/0097614c-a75a-4072-a120-320249e182c3?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3a6d655f-7f58-44ac-8366-4ae2380050eb?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b8583b6c-f3ec-4581-a804-39ee47f75098?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/dd2e115a-0a01-4a2d-988b-4ebdecb07b05?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/43b526e3-dd38-45fe-8024-1761219b82d8?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/95f4c658-0771-4572-bc54-f81d4920e472?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c68eca4d-934a-4a1d-b48c-e198875f309e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/7fbc35bc-137c-4d60-8f6f-bbb625cbe7e5?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/11f55a54-de01-486c-b206-5f567cb0476b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/0daed89f-2d5b-4802-9f82-ef2911e14467?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d7767856-5928-42f2-87c2-6b60f2fbf84c?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":25,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"b81098aa-45b8-4e8e-924b-6fbb4b128080\",\"name\":\"INMOBILIARIA ARTEAGOITIA, S.L.\",\"tradeName\":\"Artea INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/b81098aa-45b8-4e8e-924b-6fbb4b128080/20260123091522?rule=original\",\"website\":\"http://www.arteainmobiliaria.com/\",\"navigationUrl\":\"/inmobiliaria/artea-inmobiliaria/\",\"legacyPublisherId\":\"29686\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-05T23:46:40.1848926+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"PRETTY_GOOD\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":95,\"landArea\":null,\"floor\":\"FIRST\",\"features\":{\"has\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"EQUIPPED_KITCHEN\",\"FURNISHED\",\"MICROWAVE\",\"BALCONY\",\"WASHING_MACHINE\",\"FRIDGE\",\"OVEN\"],\"hasNot\":[\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"TV\"]},\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"B\",\"value\":31},\"emissions\":{\"label\":\"A\",\"value\":5}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_MODERN\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1900,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1900,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"irati@arteainmobiliaria.com\",\"phone\":\"+34688611872\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/basurto-kastrexana-errepidea/basurtu-zorrotza/bilbao/884a7f1c-5288-4c75-aa63-218dd57a5a53/d\",\"feature\":null,\"short\":\"/a/884a7f1c-5288-4c75-aa63-218dd57a5a53\"}},{\"id\":\"e46a5bd3-d9c0-47da-bea4-d6379c5f7a34\",\"reference\":\"4090\",\"legacyNumericId\":\"38192000002801\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/republica-de-begona-kalea/ibaiondo/bilbao/e46a5bd3-d9c0-47da-bea4-d6379c5f7a34/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/ibaiondo/s\",\"summary\":{\"title\":\"Se alquila vivienda en Atxuri con terraza Y parcela de garaje\",\"description\":\"Se alquila vivienda PARA ESTANCIAS TEMPORALES de reciente construcci\u00F3n, todo exterior y terraza y balc\u00F3n, muy soleado frente al parque nuevo de atxuri. Vivienda con una superficie de 85m2 distribuidos en sal\u00F3n comedor con salida a terraza con vistas despejadas al parque, cocina totalmente equipada con salida a terraza, 2 habitaciones y 2 ba\u00F1os completos uno con ba\u00F1era y el segundo con plato de ducha. Dispone de agua caliente y calefacci\u00F3n individual de gas natural, armarios empotrados y ascensor a cota cero para m\u00E1s comodidad, adem\u00E1s dispone de parcela de garaje con acceso directo, incluida en el precio.\\r\\nSe sit\u00FAa a 5 minutos del casco viejo andando, bien comunicado, en una zona tranquila con todos los servicios, polideportivo, colegios supermercado.. entre otros, adem\u00E1s de transporte p\u00FAblico con estaci\u00F3n de tren y paradas de autob\u00FAs a 6 minutos andando de la vivienda.\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\\r\\nVen a verla, te la ense\u00F1amos encantadas, INFINITY HOMES.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Ibaiondo\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Rep\u00FAblica de Bego\u00F1a Kalea\",\"streetNumber\":\"4\"},\"coordinates\":{\"latitude\":43.25285923316624,\"longitude\":-2.9186018164366487},\"displayAddressLine\":\"Rep\u00FAblica de Bego\u00F1a Kalea\",\"displayZoneLine\":\"Ibaiondo, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Atxuri\",\"slug\":\"atxuri\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Ibaiondo\",\"slug\":\"ibaiondo\"},{\"type\":\"street\",\"value\":\"Plaza Encarnacion\",\"slug\":\"plaza-encarnacion\"},{\"type\":\"street\",\"value\":\"Plaza Reverendo Santiago Lasalle\",\"slug\":\"plaza-reverendo-santiago-lasalle\"},{\"type\":\"street\",\"value\":\"Camino el Bosque\",\"slug\":\"camino-el-bosque\"},{\"type\":\"street\",\"value\":\"Calle George Steer\",\"slug\":\"calle-george-steer\"},{\"type\":\"street\",\"value\":\"Calle Republica de Bego\",\"slug\":\"calle-republica-de-bego\"},{\"type\":\"street\",\"value\":\"Parque Encarnacion\",\"slug\":\"parque-encarnacion\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48006\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2030\"},{\"level\":\"neighbourhood\",\"code\":\"627\"}]},\"mul