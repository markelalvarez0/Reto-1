uments\":[],\"counts\":{\"images\":30,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"fea4910d-2d26-49b8-9e1f-6c245eae7e56\",\"name\":\"Infinity Homes Bilbao, Sl\",\"tradeName\":\"Infinity Homes\",\"logo\":\"https://static.fotocasa.es/images/client/fea4910d-2d26-49b8-9e1f-6c245eae7e56/20241125090707?rule=original\",\"website\":\"https://www.ihbilbao.com/\",\"navigationUrl\":\"/inmobiliaria/infinity-homes/\",\"legacyPublisherId\":\"38192\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-29T14:47:01.4857081+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":2,\"bathrooms\":2,\"builtSurface\":80,\"landArea\":null,\"terrace\":{\"has\":true},\"floor\":\"SIXTH\",\"features\":{\"has\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\"],\"hasNot\":[\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"orientation\":\"SOUTH_EAST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_ADAPTED_FOR_WHEELCHAIR\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1700,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1700,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@ihbilbao.com\",\"phone\":\"+34946510000\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/lamana-kalea/ibaiondo/bilbao/1d32e635-4399-4ba3-9499-b536ac518d3a/d\",\"feature\":null,\"short\":\"/a/1d32e635-4399-4ba3-9499-b536ac518d3a\"}},{\"id\":\"175f8803-25ac-473e-9cd0-08cf765dec49\",\"reference\":\"4059\",\"legacyNumericId\":\"38192000002774\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/matiko-kalea/uribarri/bilbao/175f8803-25ac-473e-9cd0-08cf765dec49/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/uribarri/s\",\"summary\":{\"title\":\"SE ALQUILA VIVIENDA TEMPORAL EN MATIKO\",\"description\":\"INMOBILIARIA INFINITY ALQUILA VIVIENDA TEMPORAL EN MATIKO\\r\\nPreciosa vivienda totalmente REFORMADA en la zona de Matiko. Muy cerca de todo tipo de servicios.\\r\\nESTANCIAS TEMPORALES.  Completo con todo lo necesario para entrar a vivir Reci\u00E9n reformado 3 habitaciones, 2 ba\u00F1os completo y cocina totalmente equipada.\\r\\nEdifico con ascensor, exterior y muy luminosa\\r\\nDISPONIBLE 1 DICIEMBRE.\\r\\nVen a visitarlo, te lo ense\u00F1amos encantadas. INFINITY HOMES\\r\\n(((El presente arrendamiento se formaliza como un contrato de temporada (uso distinto de vivienda), el cual se rige estrictamente por el Art\u00EDculo 3 de la Ley de Arrendamientos Urbanos (LAU).Al tratarse de un r\u00E9gimen de temporada y no de un alquiler de vivienda habitual, no aplica la exenci\u00F3n de honorarios para el arrendatario estipulada en el art\u00EDculo 20.1 de la LAU (modificado por la Ley por el Derecho a la Vivienda). Por tanto, los honorarios por los servicios de gesti\u00F3n e intermediaci\u00F3n inmobiliaria corresponden y ser\u00E1n abonados \u00EDntegramente por el inquilino.)))\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Uribarri\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Matiko Kalea\",\"streetNumber\":\"17\"},\"coordinates\":{\"latitude\":43.26754021955207,\"longitude\":-2.923333389623963},\"displayAddressLine\":\"Matiko Kalea\",\"displayZoneLine\":\"Uribarri, Bilbao\",\"layers\":[