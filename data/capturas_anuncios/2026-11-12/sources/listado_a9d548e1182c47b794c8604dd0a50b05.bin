ms\":2,\"builtSurface\":100,\"landArea\":null,\"constructionYear\":1974,\"terrace\":{\"has\":false},\"floor\":\"FIFTH\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"EQUIPPED_KITCHEN\",\"HOME_APPLIANCES\",\"OVEN\",\"WASHING_MACHINE\",\"FRIDGE\"],\"hasNot\":[\"PETS_ALLOWED\",\"WARDROBES\",\"STORAGE_ROOM\",\"PRIVATE_PARKING\",\"PRIVATE_GARDEN\",\"YARD\",\"AIR_CONDITIONER\",\"SECURITY_DOOR\",\"COMMUNITY_POOL\",\"PRIVATE_POOL\",\"FIREPLACE\",\"ALARM\",\"SURVEILLANCE_SYSTEM\",\"NEARBY_PUBLIC_TRANSPORT\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"OFFICE_KITCHEN\",\"DOORMAN\",\"JACUZZI\",\"SAUNA\",\"TENNIS_COURT\",\"GYM\",\"SPORTS_AREA\",\"CHILDREN_AREA\",\"HOME_AUTOMATION\",\"INTERNET\",\"SUITE_BATHROOM\",\"PARQUET\",\"STONEWARE\",\"BALCONY\",\"DISHWASHER\",\"MICROWAVE\",\"DRYER\",\"TV\"]},\"orientation\":\"SOUTH_WEST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":190},\"emissions\":{\"label\":\"E\",\"value\":40}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"FOR_STUDENTS\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1600,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1600,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"estudiozumalakarregui@gmail.com\",\"phone\":\"+34946071207\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/begona-santutxu/bilbao/3c3db526-76db-4fc2-8de8-4a7763b6fba3/d\",\"feature\":null,\"short\":\"/a/3c3db526-76db-4fc2-8de8-4a7763b6fba3\"}},{\"id\":\"ca894199-55ef-4d0a-b77c-ebd941e46cc6\",\"reference\":\"AVDA - 8338\",\"legacyNumericId\":\"39017000000425\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/francisco-durrio-eskultorearen-kalea/deusto/bilbao/ca894199-55ef-4d0a-b77c-ebd941e46cc6/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/deusto/s\",\"summary\":{\"title\":\"ALQUILER ESTUDIANTES CURSO 2627\",\"description\":\"ALQUILER DE TEMPORADA  PARA ESTUDIANTES CURSO 26/27 \\r\\nVivienda en IBARREKOLANDA a un paso de bus y metro , Conexione con todas  las facultades DEUSTO , SARRIKO Y LEIOA \\r\\nConsta de sal\u00F3n , 3 HABITACIONES , cocina totalmente equipada , ba\u00F1o completo y balc\u00F3n.\\r\\nAmplio Tendedero  ,agua caliente y calefacci\u00F3n individual de gas \\r\\nOctava planta muy luminoso y soleado , situado en una zona peatonal hace que la vivienda sea tranquila .\\r\\nDispone de 2 ascensores \\r\\nEn Inmobiliaria Avenida 155 sabemos que vender una vivienda no es solo una operaci\u00F3n inmobiliaria: es gestionar uno de tus bienes m\u00E1s importantes, tu patrimonio. Por eso te acompa\u00F1amos en todo el proceso con profesionalidad, cercan\u00EDa y total transparencia.\\r\\nTe ayudamos a vender o alquilar tu vivienda al mejor precio y en el menor tiempo posible, realizando un estudio de mercado realista, definiendo una estrategia de venta personalizada y cuidando cada detalle de la presentaci\u00F3n del inmueble.\\r\\nConf\u00EDa en Inmobiliaria Avenida 155 y deja la compraventa de tu vivienda en manos de profesionales que se implican contigo de principio a fin.\\r\\nEstamos en Avda.  Lehendakari Aguirre 155 - San Ignacio -  Horario de verano :  lunes a viernes de 9:30h a 13:30 h y de 16:30h a 20:00h  \",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Deusto\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Francisco Durrio Eskultorearen Kalea\",\"streetNumber\":\"3\"},\"coordinates\":{\"latitude\":43.27605119606919,\"longitude\":-2.9585663441745282},\"displayAddressLine\":\"Francisco Durrio Eskultorearen Kalea\",\"displayZoneLine\":\"Deusto, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Ibarrekolanda\",\"slug\":\"ibarrekolanda\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"sl