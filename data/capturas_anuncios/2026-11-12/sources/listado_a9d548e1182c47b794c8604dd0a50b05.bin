:false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T15:54:06.6960807+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":79,\"landArea\":null,\"floor\":\"FIRST\",\"features\":{\"has\":[\"ELEVATOR\",\"WARDROBES\",\"FURNISHED\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"MICROWAVE\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"]},\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"G\",\"value\":318},\"emissions\":{\"label\":\"F\",\"value\":54}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"FOR_STUDENTS\",\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1200,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1200,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@inmosalazar.com\",\"phone\":\"+34946465015\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/autonomia-kalea/errekalde/bilbao/bbc9809f-6e26-451b-8455-26af9cfc6cdc/d\",\"feature\":null,\"short\":\"/a/bbc9809f-6e26-451b-8455-26af9cfc6cdc\"}},{\"id\":\"7a2fd3ae-970a-42d9-864c-33f085096457\",\"reference\":\"19034\",\"legacyNumericId\":\"29469000002907\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/calle-lehendakari-leizaola/abando-albia/bilbao/7a2fd3ae-970a-42d9-864c-33f085096457/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/bizkaia-provincia/bilbao/abando-albia/s\",\"summary\":{\"title\":\"Exclusiva Vivienda Con Gran Terraza En Plaza Euskadi\",\"description\":\"INMOBILIARIA QUORUM presenta en alquiler esta magn\u00EDfica vivienda de reciente construcci\u00F3n, situada en la prestigiosa Plaza Euskadi, uno de los enclaves m\u00E1s emblem\u00E1ticos y deseados de Bilbao.\\n\\nSe trata de una vivienda elegante, luminosa y de dise\u00F1o contempor\u00E1neo, que destaca por sus excelentes calidades y por su impresionante terraza de 60 m2, un verdadero espacio de ensue\u00F1o al aire libre, pensado para disfrutar del sol, del descanso y de agradables reuniones en un entorno privilegiado. Totalmente equipada con toldos el\u00E9ctricos, sistema de calefacci\u00F3n por estufas de infrarrojos, zona chill out y comedor exterior, esta terraza se integra de forma natural con el sal\u00F3n, creando una continuidad perfecta entre interior y exterior.\\n\\nEl interior mantiene la misma l\u00EDnea de sofisticaci\u00F3n, con una distribuci\u00F3n funcional y acogedora. Dispone de un amplio sal\u00F3n comedor muy luminoso, cocina moderna completamente equipada, dos habitaciones con grandes armarios empotrados y un ba\u00F1o completo. Cada estancia est\u00E1 cuidada al detalle, ofreciendo comodidad, amplitud y elegancia en un ambiente contempor\u00E1neo y sereno.\\n\\nLa vivienda incluye adem\u00E1s dos parcelas de garaje con acceso directo y trastero, un valor a\u00F1adido que aporta comodidad y espacio adicional en una de las zonas m\u00E1s exclusivas de Bilbao.\\n\\nEl edificio, de reciente construcci\u00F3n, cuenta con ascensor, calefacci\u00F3n individual de gas natural y todas las comodidades propias de una vivienda de alto nivel.\\n\\nUna oportunidad \u00FAnica para quienes buscan vivir en una ubicaci\u00F3n privilegiada, rodeados de zonas verdes, servicios y el dinamismo del centro de Bilbao, disfrutando adem\u00E1s de una de las terrazas m\u00E1s exclusivas y agradables de la ciudad\\n\\nSi buscas Agencias Inmobiliarias en Bilbao centro, Quorum es la inmobiliaria que puede ayudarte en la compra, venta o alquiler de tu piso, vivienda o local. 25 A\u00F1os de trayectoria con 9 Oficinas Inmobiliarias y m\u00E1s de 40 profesionales con gran bagaje en el sector inmobiliario a trav\u00E9s de una metodolog\u00EDa basada en el rigor, el compromiso y la responsabilidad a trav\u00E9s del tratamiento personalizado y con la asesor\u00EDa de un departamento jur\u00EDdico propio. Siempre con la sensibilidad de que un inmueble puede llegar a ser un hogar, una inversi\u00F3n o la puesta en marcha de un gran proyecto; el objetivo es acompa\u00F1ar a nuestros clientes de principio a fin para satisfacer expectativas y alimentar ilusiones.\\n\\nGarant\u00EDa, responsabilidad y eficiencia definen los pilares del servicio Quorum. En Grupo Quorum aplicamos una metodolog\u00EDa enfocada a lograr resultados \u00F3ptimos y de beneficio en el menor tiempo posible. En Quorum somos muy conscientes del v\u00EDnculo emocional asociado a una vivienda o a un proyecto de negocio, de ah\u00ED que nuestros agentes y nuestros asesores sepan acompa\u00F1arle con seriedad y empat\u00EDa en todo el proceso de compra-venta, facilitando la b\u00FAsqueda y gestionando desde las labores administrativas, la consecuci\u00F3n del certificado energ\u00E9tico, home staging, hasta las fotograf\u00EDas/v\u00EDdeos profesionales o todos los servicios asociados a la gesti\u00F3n inmobiliaria. Un equipo propio experto en marketing, as\u00ED como un departamento legal velar\u00E1n por los intereses de cada cliente con el fin de evitar incidencias y simplificar el proceso de compra o de venta de viviendas, chalets, locales o naves industriales en nuestro \u00E1rea de implantaci\u00F3n: el Gran Bilbao, as\u00ED como en zonas vacacionales y proyectos de segunda residencia.\\n\\nQuorum es la inmobiliaria l\u00EDder en Vizcaya. Localiza nuestra agencia inmobiliaria en www.inmobiliariaquorum.com\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Bilbao\",\"district\":\"Abando - Albia\",\"region\":\"Gran Bilbao\",\"province\":\"Bizkaia\",\"address\":{\"streetName\":\"Calle Lehendakari Leizaola\",\"streetNumber\":\"7\"},\"coordinates\":{\"latitude\":43.26733810198014,\"longitude\":-2.9397223603664315},\"displayAddressLine\":\"Calle Lehendakari Leizaola\",\"displayZoneLine\":\"Abando - Albia, Bilbao\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Abandoibarra - Guggenheim\",\"slug\":\"abandoibarra-guggenheim\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Bizkaia\",\"slug\":\"bizkaia\"},{\"type\":\"region\",\"value\":\"Gran Bilbao\",\"slug\":\"gran-bilbao\"},{\"type\":\"area\",\"value\":\"Bilbao, Zona de\",\"slug\":\"bilbao-zona-de\"},{\"type\":\"municipality\",\"value\":\"Bilbao\",\"slug\":\"bilbao\"},{\"type\":\"district\",\"value\":\"Abando - Albia\",\"slug\":\"abando-albia\"},{\"type\":\"street\",\"value\":\"Calle Lehendakari Leizaola\",\"slug\":\"calle-lehendakari-leizaola\"},{\"type\":\"street\",\"value\":\"Paseo Estitxu\",\"slug\":\"paseo-estitxu\"},{\"type\":\"street\",\"value\":\"Alameda Conde de Arteche\",\"slug\":\"alameda-conde-de-arteche\"},{\"type\":\"street\",\"value\":\"Paseo Eduardo Victoria de Lecea\",\"slug\":\"paseo-eduardo-victoria-de-lecea\"},{\"type\":\"street\",\"value\":\"Plaza Euskadi\",\"slug\":\"plaza-euskadi\"},{\"type\":\"street\",\"value\":\"Puente Deustu\",\"slug\":\"puente-deustu\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"48001\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"48\"},{\"level\":\"region\",\"code\":\"420\"},{\"level\":\"area\",\"code\":\"791\"},{\"level\":\"municipality\",\"code\":\"48020\"},{\"level\":\"district\",\"code\":\"2025\"},{\"level\":\"neighbourhood\",\"code\":\"834\"}]},\"multimedia\":{\"images\":[{\"typ