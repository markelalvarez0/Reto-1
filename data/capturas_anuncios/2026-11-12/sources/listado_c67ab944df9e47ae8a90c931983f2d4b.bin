EGI\",\"streetNumber\":\"26\"},\"coordinates\":{\"latitude\":42.856031322466116,\"longitude\":-2.688597023465036},\"displayAddressLine\":\"JOSE ATXOTEGI\",\"displayZoneLine\":\"Gazalbide, Vitoria - Gasteiz\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Araba - \u00C1lava\",\"slug\":\"araba-alava\"},{\"type\":\"region\",\"value\":\"Vitoria - Gasteiz, Zona de\",\"slug\":\"vitoria-gasteiz-zona-de\"},{\"type\":\"municipality\",\"value\":\"Vitoria - Gasteiz\",\"slug\":\"vitoria-gasteiz\"},{\"type\":\"district\",\"value\":\"Gazalbide\",\"slug\":\"gazalbide\"},{\"type\":\"street\",\"value\":\"Calle Bulevar Euskal Herria\",\"slug\":\"calle-bulevar-euskal-herria\"},{\"type\":\"street\",\"value\":\"Calle Duque de Wellington\",\"slug\":\"calle-duque-de-wellington\"},{\"type\":\"street\",\"value\":\"Calle Jose Achotegui\",\"slug\":\"calle-jose-achotegui\"},{\"type\":\"street\",\"value\":\"Calle Donostia-San Sebasti\u00E1n\",\"slug\":\"calle-donostia-san-sebastian\"},{\"type\":\"street\",\"value\":\"Calle Conde Don Vela\",\"slug\":\"calle-conde-don-vela\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"01009\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"1\"},{\"level\":\"region\",\"code\":\"439\"},{\"level\":\"municipality\",\"code\":\"1059\"},{\"level\":\"district\",\"code\":\"2087\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c4a02704-06e1-446a-9647-d484b0ee3084?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/17a784d2-c958-4a16-a418-48821b15e313?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/1cf21b42-661c-479b-81ff-c265899abe6b?ru