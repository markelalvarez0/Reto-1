":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-08-06T14:27:32.7189362+02:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":1,\"bathrooms\":1,\"builtSurface\":65,\"landArea\":null,\"constructionYear\":2010,\"floor\":\"FIRST\",\"features\":{\"has\":[],\"hasNot\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"FURNISHED\",\"ALARM\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"WARDROBES\",\"YARD\",\"SAUNA\",\"INTERNET\",\"PARQUET\",\"SECURITY_DOOR\",\"STONEWARE\",\"BALCONY\",\"PRIVATE_GARDEN\",\"COMMUNITY_POOL\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"EQUIPPED_KITCHEN\",\"DRYER\",\"DISHWASHER\"]},\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"}},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1415,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1415,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@fincasarmentia.com\",\"phone\":\"+34945232400\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/uleta-kalea/mendizorrotza-armentia/vitoria-gasteiz/65491b0a-a203-49fc-a138-6269763cd399/d\",\"feature\":null,\"short\":\"/a/65491b0a-a203-49fc-a138-6269763cd399\"}},{\"id\":\"865436fc-51d9-4415-8b2c-03f1ea36058d\",\"reference\":\"7645\",\"legacyNumericId\":\"30373000000325\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/uleta-kalea/mendizorrotza-armentia/vitoria-gasteiz/865436fc-51d9-4415-8b2c-03f1ea36058d/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/araba-alava-provincia/vitoria-gasteiz/mendizorrotza-armentia/s\",\"summary\":{\"title\":\"Piso de 2 DORM en Hotel Jardines de Uleta Suites\",\"description\":\"Apartamento de 80m2 en Hotel Jardines de Uleta Suites: Ideal para Empresas\\n\\nApartamento de dos dormitorios de 80 m\u00B2 perfecta para estancias de empresas y profesionales desplazados en Vitoria-Gasteiz. Ubicado en la zona de Uleta, ofrece conexi\u00F3n directa con los pol\u00EDgonos de Jundiz y Miranda, facilitando la log\u00EDstica de transporte.\\n\\nEquipamiento y servicios incluidos en el apartamento:\\nEl apartamento se entrega amueblado y con la cocina totalmente equipada (incluye kit de menaje). Dispone de una distribuci\u00F3n de dos dormitorios, dos ba\u00F1os completos, vestidor y sal\u00F3n-comedor. El contrato incluye servicios de mantenimiento integral, as\u00ED como limpieza semanal con cambio de lencer\u00EDa (s\u00E1banas y toallas).\\n\\nVentajas operativas y fiscales:\\nPermite la deducci\u00F3n total del IVA y su contabilizaci\u00F3n como gasto en el Impuesto de Sociedades. El modelo de facturaci\u00F3n es de cuota fija mensual, lo que garantiza el control de costes al incluir en una \u00FAnica factura el alquiler m\u00E1s un importe fijo de gastos de 710,10 \u20AC que cubre todos los suministros de 2 personas (luz, agua, calefacci\u00F3n y aire acondicionado y acceso a WiFi de alta velocidad). Solicite m\u00E1s informaci\u00F3n para 3 y 4 personas. \\n\\nInstalaciones y servicios adicionales:\\nLos residentes tienen acceso a los servicios de gimnasio, piscina y cafeter\u00EDa del edificio. \\n\\nExiste la posibilidad de contratar otros servicios como plaza de parking mensual y trastero.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Vitoria - Gasteiz\",\"district\":\"Mendizorrotza - Armentia\",\"region\":\"Vitoria - Gasteiz, Zona de\",\"province\":\"Araba - \u00C1lava\",\"address\":{\"streetName\":\"Uleta Kalea\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":42.834042279362016,\"longitude\":-2.6962388095116694},\"displayAddressLine\":\"Uleta Kalea\",\"displayZoneLine\":\"Mendizorrotza - Armentia, Vitoria - Gasteiz\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",