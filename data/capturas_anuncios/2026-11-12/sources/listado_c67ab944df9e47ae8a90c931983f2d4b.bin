span><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" data-title="chevron_down" fill="currentColor" stroke="none" class="shrink-0 text-current u-current-font-size" aria-hidden="true" focusable="false" data-panot-component="icon" data-testid="select-trigger-icon"><path d="M12 17.4944C11.6183 17.4944 11.2366 17.3482 10.9459 17.0574L2 8.10887L4.10825 6L12 13.8941L19.8918 6L22 8.10887L13.0541 17.0574C12.7634 17.3482 12.3817 17.4944 12 17.4944" fill-rule="nonzero"/></svg></button><select aria-hidden="true" tabindex="-1" name="footer-language-selector" style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal"></select></div></div></div></div></div></div></footer></div></div><script>window.__PERFORMANCE_METRICS__ = JSON.parse("{}");</script><script>window.__APP_CONFIG__ = JSON.parse("{\"hostname\":\"www.habitaclia.com\"}");</script><script>window.__INITIAL_PROPS__ = JSON.parse("{\"initialSearchResultsPage\":{\"status\":\"success\",\"initialSearchContext\":{\"searchType\":\"standard\",\"viewMode\":\"list\",\"geography\":{\"code\":\"1059\",\"locationIds\":\"724,18,1,439,0,1059,0,0,0\",\"layerId\":20,\"layer\":\"municipality\",\"name\":\"Vitoria - Gasteiz\",\"slug\":\"vitoria-gasteiz\",\"latitude\":42.8517,\"longitude\":-2.67141,\"parentSlug\":\"araba-alava-provincia\"},\"filters\":{\"transactionType\":\"rent\",\"propertyType\":\"home\",\"minPrice\":null,\"maxPrice\":null,\"minSurface\":null,\"maxSurface\":null,\"minRooms\":null,\"minBathrooms\":null,\"features\":[],\"isPrivate\":null,\"isTypology\":null,\"isBank\":null,\"propertySubtype\":[]},\"sortBy\":\"RELEVANCE\",\"semanticFilterSlug\":null,\"urls\":{\"list\":\"/alquiler/viviendas/araba-alava-provincia/vitoria-gasteiz/s\",\"map\":\"/alquiler/viviendas/araba-alava-provincia/vitoria-gasteiz/sm\"},\"results\":{\"items\":[{\"id\":\"051d6c9e-2239-47dd-9548-9d1ac4b707ba\",\"reference\":\"592\",\"legacyNumericId\":\"55233000000131\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/tarragona/lakua-bizkarra/vitoria-gasteiz/051d6c9e-2239-47dd-9548-9d1ac4b707ba/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/araba-alava-provincia/vitoria-gasteiz/lakua-bizkarra/s\",\"summary\":{\"title\":\"Piso en alquiler en Lakua, 3 dormitorios.\",\"description\":\"Piso en alquiler en Lakua, Vitoria-Gasteiz, ideal para quienes buscan comodidad y una ubicaci\u00F3n bien comunicada. Con 90 m\u00B2, ofrece tres dormitorios y dos ba\u00F1os, adem\u00E1s de una distribuci\u00F3n pr\u00E1ctica y espacios acogedores. Se alquila completamente amueblado y cuenta con cocina equipada, listo para entrar a vivir. Su estilo moderno y su plaza de garaje aportan un extra de confort para el d\u00EDa a d\u00EDa. Situado en una zona con buena ubicaci\u00F3n, es una excelente opci\u00F3n para familias o para quienes necesitan espacio adicional para trabajar desde casa. Una vivienda funcional y atractiva. No se admiten mascotas. IMPRESCINDIBLE  SOLVENCIA ECONOMICA DEMOSTRABLE . Se pide dos meses de fianza.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Vitoria - Gasteiz\",\"district\":\"Lakua-Bizkarra\",\"region\":\"Vitoria - Gasteiz, Zona de\",\"province\":\"Araba - \u00C1lava\",\"address\":{\"streetName\":\"TARRAGONA\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":42.867064344750204,\"longitude\":-2.6881942245896653},\"displayAddressLine\":\"TARRAGONA\",\"displayZoneLine\":\"Lakua-Bizkarra, Vitoria - Gasteiz\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Araba - \u00C1lava\",\"slug\":\"araba-alava\"},{\"type\":\"region\",\"value\":\"Vitoria - Gasteiz, Zona de\",\"slug\":\"vitoria-gasteiz-zona-de\"},{\"type\":\"municipality\",\"value\":\"Vitoria - Gasteiz\",\"slug\":\"vitoria-gasteiz\"},{\"type\":\"district\",\"value\":\"Lakua-Bizkarra\",\"slug\":\"lakua-bizkarra\"},{\"type\":\"street\",\"value\":\"Calle Zarautz\",\"slug\":\"calle-zarautz\"},{\"type\":\"street\",\"value\":\"Calle Portal de Foronda\",\"slug\":\"calle-portal-de-foronda\"},{\"type\":\"street\",\"value\":\"Calle Tarragona\",\"slug\":\"calle-tarragona\"},{\"type\":\"street\",\"value\":\"Calle Baiona\",\"slug\":\"calle-baiona\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"01010\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"1\"},{\"level\":\"region\",\"code\":\"439\"},{\"level\":\"municipality\",\"code\":\"1059\"},{\"level\":\"district\",\"code\":\"3184\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/dcd65d4c-e2b4-4c5a-9bc0-c1da96b0f75d?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/839e526e-3184-410f-8650-63afbfe07d53?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/67c5b1d5-1f06-4633-b7b6-692dd19b8edb?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/0d4b347c-f051-4628-a7a4-129eca7d72c2?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/943e5337-4ed2-4988-843a-04b846329dc8?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c3e1df1b-3fbb-456f-9891-abfc635d95b6?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2cefd2f3-d3ac-4e2b-9696-7ff199185cab?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/46546747-445f-498e-b01b-3b50fcc0af0a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/01308214-fb13-4cf6-b05a-4df166fc89e3?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/af5dba69-54be-4283-b4c3-c6d119ff631e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/9b5dd5b8-ced6-4719-878e-e87a563f1721?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e3eb6e4a-11e2-4eed-b67a-25663801238f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/bed9c060-d05f-4261-8281-d2b016e7a934?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e951f872-5f22-4935-9fae-53203055ef9b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2df1c497-c792-4e31-b0f2-2a4d7832cd6b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b0a39f0f-4c96-4548-a6c5-e5e094bf0d0d?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/aa525887-e78c-4e8e-99de-99a872426a14?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/7d9f32f2-38a1-4a24-ab6d-98e0d61d54a5?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c8aa6eeb-05c1-4088-a4b1-6bc1055e7c7c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/33b09856-036b-4156-a7ac-bef2cbe90a1f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6f7aa70a-ee75-4ed2-86e5-c385ccf48ff4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/fdac2382-c9d1-4f33-ab64-71e252da3f80?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a5dcb970-1c3f-4dfc-88c2-35bae0178f9e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3c9a5656-46a2-41de-83a4-5b44e6378661?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ec6b6de9-7310-444e-9d9b-7479bc5d73ed?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/84ccd965-977c-4bc3-b533-bd6d7fe43ff7?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a2ed2d1f-3c11-4125-92f6-f01443c82df1?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":27,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"61fc0328-28cc-43ac-bab3-162f8aa71d0f\",\"name\":\"A&M ALQUILER Y MEDIACION SC\",\"tradeName\":\"INMO GASTEIZ A&M\",\"logo\":null,\"website\":\"www.alquilerymediacion.com\",\"navigationUrl\":null,\"legacyPublisherId\":\"55233\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[],\"updatedAt\":\"2026-11-04T22:42:35.3400224+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":3,\"bathrooms\":2,\"builtSurface\":90,\"landArea\":null,\"floor\":\"FOURTH\",\"features\":{\"has\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"FURNISHED\"],\"hasNot\":[]},\"orientation\":\"SOUTH_WEST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_MODERN\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1057,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1057,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"oficina@alquilerymediacion.com\",\"phone\":\"+34945002629\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/tarragona/lakua-bizkarra/vitoria-gasteiz/051d6c9e-2239-47dd-9548-9d1ac4b707ba/d\",\"feature\":null,\"short\":\"/a/051d6c9e-2239-47dd-9548-9d1ac4b707ba\"}},{\"id\":\"65491b0a-a203-49fc-a138-6269763cd399\",\"reference\":\"7644\",\"legacyNumericId\":\"30373000000324\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/uleta-kalea/mendizorrotza-armentia/vitoria-gasteiz/65491b0a-a203-49fc-a138-6269763cd399/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/araba-alava-provincia/vitoria-gasteiz/mendizorrotza-armentia/s\",\"summary\":{\"title\":\"Apartamento en Hotel Jardines de Uleta Suites\",\"description\":\"Apartamento de 60m2 en Hotel Jardines de Uleta Suites: Ideal para Empresas\\n\\nApartamento de 60 m\u00B2 de un dormitorio con WiFi de alta velocidad y un espacio de sal\u00F3n-comedor vers\u00E1til. Perfecto para desplazados en Vitoria-Gasteiz que necesitan un entorno conectado y profesional. Ubicaci\u00F3n ideal: conexi\u00F3n directa con los pol\u00EDgonos de Jundiz y Miranda.\\nEquipamiento y servicios incluidos en el apartamento:\\nEl apartamento se entrega amueblado y con la cocina totalmente equipada (incluye kit de menaje). Dispone de una distribuci\u00F3n de un dormitorio, un ba\u00F1o completo, vestidor y sal\u00F3n-comedor. El contrato incluye servicios de mantenimiento integral, as\u00ED como limpieza semanal con cambio de lencer\u00EDa (s\u00E1banas y toallas).\\nVentajas operativas y fiscales:\\nPermite la deducci\u00F3n total del IVA y su contabilizaci\u00F3n como gasto en el Impuesto de Sociedades. El modelo de facturaci\u00F3n es de cuota fija mensual, lo que garantiza el control de costes al incluir en una \u00FAnica factura el alquiler m\u00E1s un importe fijo de gastos de 629,40 \u20AC que cubre todos los suministros (luz, agua, calefacci\u00F3n y aire acondicionado y acceso a WiFi de alta velocidad).\\nInstalaciones y servicios adicionales:\\nLos residentes tienen acceso a los servicios de gimnasio, piscina y cafeter\u00EDa del edificio. \\nExiste la posibilidad de contratar otros servicios como plaza de parking mensual y trastero.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Vitoria - Gasteiz\",\"district\":\"Mendizorrotza - Armentia\",\"region\":\"Vitoria - Gasteiz, Zona de\",\"province\":\"Araba - \u00C1lava\",\"address\":{\"streetName\":\"Uleta Kalea\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":42.83385971186881,\"longitude\":-2.6956895536661705},\"displayAddressLine\":\"Uleta Kalea\",\"displayZoneLine\":\"Mendizorrotza - Armentia, Vitoria - Gasteiz\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Araba - \u00C1lava\",\"slug\":\"araba-alava\"},{\"type\":\"region\",\"value\":\"Vitoria - Gasteiz, Zona de\",\"slug\":\"vitoria-gasteiz-zona-de\"},{\"type\":\"municipality\",\"value\":\"Vitoria - Gasteiz\",\"slug\":\"vitoria-gasteiz\"},{\"type\":\"district\",\"value\":\"Mendizorrotza - Armentia\",\"slug\":\"mendizorrotza-armentia\"},{\"type\":\"street\",\"value\":\"Calle Emilia Pardo Bazan\",\"slug\":\"calle-emilia-pardo-bazan\"},{\"type\":\"street\",\"value\":\"Avenida San Prudencio\",\"slug\":\"avenida-san-prudencio\"},{\"type\":\"street\",\"value\":\"Calle Uleta\",\"slug\":\"calle-uleta\"},{\"type\":\"street\",\"value\":\"Calle Obispo Bivere\",\"slug\":\"calle-obispo-bivere\"},{\"type\":\"street\",\"value\":\"Calle Atxo Apellaniz\",\"slug\":\"calle-atxo-apellaniz\"},{\"type\":\"street\",\"value\":\"Calle Maite Zu\u00F1iga\",\"slug\":\"calle-maite-zuniga\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"01007\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"1\"},{\"level\":\"region\",\"code\":\"439\"},{\"level\":\"municipality\",\"code\":\"1059\"},{\"level\":\"district\",\"code\":\"2090\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f7b8bee4-