0ab?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6f7249eb-0e53-49a8-b2df-89b1bf5caceb?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/deaf3692-8c18-4091-8db3-4f09704daf1b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/397ee950-77cc-4353-9d7e-74b039cc43ec?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/96406bf6-5224-464a-839b-5a4a7baee578?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/188ddbd1-a41c-42c8-b832-6987a5109fc4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c548cf28-35a6-40e4-a129-aeef50aea423?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/13fffe7b-0801-49d1-9b7f-5a0fb229d406?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a15e6304-4887-4bca-bddf-32d6f0de7593?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a3e45590-16a5-4ad3-b640-bfe6384f582c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/384e1dad-c02a-49aa-8054-4d213d2d2ab7?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/034f81d1-a39b-4ee0-93d1-98a2ff568cc7?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/9e0c16ae-d9f2-4459-8a1b-8eee17f1d5ce?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":19,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"4bb9bb7c-ce92-4cfa-ab5f-1e820a308820\",\"name\":\"ASESORIA JURIDICA Y AGENCIA INMOBILIARIA NUEVO GROS SL\",\"tradeName\":\"NUEVO GROS INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/9202755625017/439961.jpg?rule=original\",\"website\":\"www.https://www.inmonuevogros.com\",\"navigationUrl\":\"/inmobiliaria/nuevo-gros-inmobiliaria/\",\"legacyPublisherId\":\"31357\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"435\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-09T11:50:05.4326857+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":3,\"bathrooms\":2,\"builtSurface\":75,\"landArea\":null,\"constructionYear\":1978,\"floor\":\"FOURTH\",\"features\":{\"has\":[\"ELEVATOR\",\"WARDROBES\",\"EQUIPPED_KITCHEN\"],\"hasNot\":[]},\"heating\":\"NON_SPECIFIED\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":241},\"emissions\":{\"label\":\"E\",\"value\":50}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_ADAPTED_FOR_WHEELCHAIR\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1300,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1300,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3586@inmoweb.email\",\"phone\":\"+34943293029\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/jose-maria-salaberria/amara-berri/donostia-san-sebastian/dfb0f221-0b67-442f-8f64-d2c863adf7be/d\",\"feature\":null,\"short\":\"/a/dfb0f221-0b67-442f-8f64-d2c863adf7be\"}},{\"id\":\"7b1fa25c-d44b-4c14-8a09-2abfe7527d3e\",\"reference\":\"2335460\",\"legacyNumericId\":\"30956000001055\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/pescadores-gran-sol-10/amara-berri/donostia-san-sebastian/7b1fa25c-d44b-4c14-8a09-2abfe7527d3e/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/amara-berri/s\",\"summary\":{\"title\":\"Amplia vivienda temporal en excelente ubicaci\u00F3n, Pescadores de Gran Sol, Amara\",\"description\":\"ALQUILER DE VIVIENDA TEMPORAL. Y PARA ESTUDIANTES. Piso en Pescadores de Gran Sol.\\n SUPERFICIE: 80 m2 \u00FAtiles interiores.\\n DISTRIBUCI\u00D3N : Hall de entrada, sala exterior, cocina equipada ( lavadora, vitrocer\u00E1mica, frigor\u00EDfico y caldera), 3 habitaciones amplias, todas ellas con camas y armarios, dos de ellas exteriores y una interior a patio de la casa, y dos ba\u00F1os completos, uno de ellos dentro del dormitorio principal.\\n CARACTERISTICAS: Dispone de calefacci\u00F3n y agua caliente por gas natural. Suelos de madera, ventanas aluminio. Las tres habitaciones tienen cama y armario. \\n EDIFICIO : Sin barreras arquitect\u00F3nicas y con ascensor .Fachada ventilada recien hecha.\\n CONDICIONES: Fianza legal (2 mensualidades), Honorarios agencia (12% de los meses de arrendamiento +IVA21%) por cuenta del inquilino.\\n No se admiten animales\\n  \\n Cl\u00E1usula de Transparencia y Desglose de Gastos (Ley 10/2025)\u00B7 \\n  En cumplimiento de las obligaciones de informaci\u00F3n previstas en la Ley 10/2025, de 28 de diciembre,  de servicios de atenci\u00F3n a la clientela y transparencia, as\u00ED como en la normativa sectorial vigente, se hace constar que el precio indicado si incluye los datos, gastos e impuestos siguientes: Se hace constar que el precio indicado no incluye los gastos siguientes que no pueden ser calculados de antemano y que ser\u00E1n por cuenta del arrendatario, tales como gastos de Electricidad, Gas, as\u00ED como la tasa de Agua y basuras. Los Honorarios de comercializaci\u00F3n de la Agencia Inmobiliaria son por cuenta de los inquilinos. El impuesto de Transmisiones patrimoniales, el Impuesto de bienes inmuebles y los gastos de comunidad ser\u00E1n por cuenta del propietario.\\n  \\n  \\n  \",\"location\":{\"visibility\":\"EXACT\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Amara - Berri\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Pescadores Gran Sol\",\"streetNumber\":\"10\"},\"coordinates\":{\"latitude\":43.3059231,\"longitude\":-1.9706599},\"displayAddressLine\":\"Pescadores Gran Sol 10\",\"displayZoneLine\":\"Amara - Berri, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Anoeta\",\"slug\":\"anoeta\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Amara - Berri\",\"slug\":\"amara-berri\"},{\"type\":\"street\",\"value\":\"Calle Pescadores Gran Sol\",\"slug\":\"calle-pescadores-gran-sol\"},{\"type\":\"street\",\"value\":\"Paseo de Bizkaia\",\"slug\":\"paseo-de-bizkaia\"},{\"type\":\"street\",\"value\":\"Calle Real Cia. Gip. Caracas\",\"slug\":\"calle-real-cia-gip-caracas\"},{\"type\":\"street\",\"value\":\"Calle Pescadores Terranova\",\"slug\":\"calle-pescadores-terranova\"},{\"type\":\"street\",\"value\":\"Calle Astilleros\",\"slug\":\"calle-astilleros\"},{\"type\":\"street\",\"value\":\"Calle Jardin  la Memoria\",\"slug\":\"calle-jardin-la-memoria\"},{\"type\":\"street\",\"value\":\"Calle Eustasio Amilibia\",\"slug\":\"calle-eustasio-amilibia\"},{\"type\":\"street\",\"value\":\"Plaza de Azkoitia\",\"slug\":\"plaza-de-azkoitia\"},{\"type\":\"street\",\"value\":\"Paseo de Zorroaga\",\"slug\":\"paseo-de-zorroaga\"},{\"type\":\"street\",\"v