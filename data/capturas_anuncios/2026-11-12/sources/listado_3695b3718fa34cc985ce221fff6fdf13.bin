,\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T10:49:38.3355887+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":3,\"builtSurface\":98,\"landArea\":null,\"floor\":\"THIRD\",\"features\":{\"has\":[\"WARDROBES\",\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"FURNISHED\",\"PARQUET\"],\"hasNot\":[]},\"orientation\":\"WEST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"FOR_STUDENTS\",\"IS_EXTERIOR\",\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1400,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1400,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"524841@inbox.habitatsoft.com\",\"phone\":\"+34747444818\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/calle-segundo-ispizua/gros/donostia-san-sebastian/8594baf0-090c-42bc-920d-077320b3fe5e/d\",\"feature\":null,\"short\":\"/a/8594baf0-090c-42bc-920d-077320b3fe5e\"}},{\"id\":\"88294588-ce37-4394-9401-0a1dfce4d9bb\",\"reference\":\"MA06594\",\"legacyNumericId\":\"46021000005242\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/centro/donostia-san-sebastian/88294588-ce37-4394-9401-0a1dfce4d9bb/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/centro/s\",\"summary\":{\"title\":\"Piso de alquiler PARA ESTUDIANTES en \u00C1rea Rom\u00E1ntica, DonostiaSan Sebasti\u00E1n\",\"description\":\"REFERENCIA: MA06594\\n\\n\uD83C\uDF93 \u00A1PISO EN ALQUILER PARA ESTUDIANTES! \uD83C\uDFD6\uFE0F\uD83D\uDCDA\u00A1TEMPORADA!\\n\\n\uD83D\uDCC5 Disponible del 1 de Febrero hasta junio 2027 \u2013 \u00A1ideal para el curso acad\u00E9mico!\\n\uD83D\uDCCD Ubicaci\u00F3n TOP: pleno centro de la ciudad, a solo 50 metros de la Playa de La Concha y del parking \uD83D\uDEB6\u200D\u2642\uFE0F\uD83C\uDF0A\\n\\n\uD83C\uDFE1 Totalmente amueblado y equipado:\\n\uD83D\uDECF\uFE0F 2 habitaciones con TV y escritorio\\n\uD83D\uDECB\uFE0F Gran sof\u00E1 cama de 3 metros en la sala\\n\uD83C\uDF7D\uFE0F Cocina completa con menaje: lavadora, secadora, cubiertos, edredones y m\u00E1s\\n\uD83D\uDEBF 1 ba\u00F1o con ducha\\n\uD83D\uDCF6 Wifi incluido en el precio\\n\u2600\uFE0F Muy luminoso \u2013 todas las estancias tienen ventana o balc\u00F3n exterior\\n\uD83C\uDD7F\uFE0F Plaza de parking incluida a solo 50 metros\\n\\n\u2B50 Lo mejor: c\u00E9ntrico, cerca del Casco Viejo y de la playa \uD83C\uDFD9\uFE0F\uD83C\uDF05 \u2013 \u00A1puedes ir andando a todas partes!\\n\\n\uD83D\uDCDE \u00A1No dejes pasar esta oportunidad! Vive cerca del mar con todas las comodidades \uD83D\uDE0D\",\"location\":{\"visibility\":\"ZONE\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Centro\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Calle Calle de Urbieta, 5\",\"streetNumber\":\"5\"},\"coordinates\":{\"latitude\":43.318870144383034,\"longitude\":-1.983370465286498},\"displayAddressLine\":null,\"displayZoneLine\":\"Centro, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"\u00C1rea Rom\u00E1ntica\",\"slug\":\"area-romantica\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"D