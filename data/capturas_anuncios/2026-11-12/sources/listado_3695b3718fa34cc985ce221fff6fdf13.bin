type\":null,\"url\":\"https://static.fotocasa.es/images/ads/07e3ec00-204c-4d69-a570-e6777c18fbed?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/add3a5de-115f-44ba-9de6-69fa145a2345?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f6ab2a39-624b-4df7-9c60-af84612b6601?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/64d97a14-a240-4f34-83a6-da67a856ca5a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/1f107617-a4b1-4f03-9e64-f93620f41103?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f8c75103-b806-4d47-b117-898159293a47?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ceb0f5db-eee9-4e54-b169-14969b7a1b06?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c2c0f472-11af-4297-a6ca-760ebe616506?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/dec24828-00d0-4a59-9589-8991176097e3?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a8d13984-363e-4592-8b31-601c7221629e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/dd95fc31-d585-4a70-91cf-665aaf795af2?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ac45bae3-33e0-4dba-adf7-04698bccc709?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/80d11ac2-1813-413c-bb52-d1e69bc03eaa?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":14,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"00645ab5-e5ce-49bb-902f-1214a09647f1\",\"name\":\"INMOBILIARIA ARRIGAIN, S.L.\",\"tradeName\":\"ARRIGAIN\",\"logo\":\"https://static.fotocasa.es/images/client/00645ab5-e5ce-49bb-902f-1214a09647f1/20240930112525?rule=original\",\"website\":\"http://www.arrigain.com/\",\"navigationUrl\":\"/inmobiliaria/arrigain/\",\"legacyPublisherId\":\"29680\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T11:24:46.6290303+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":2,\"bathrooms\":2,\"builtSurface\":78,\"landArea\":null,\"floor\":\"FOURTH\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"MICROWAVE\",\"BALCONY\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"],\"hasNot\":[]},\"orientation\":\"NORTH\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1500,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1500,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"arrigain@arrigain.com\",\"phone\":\"+34943450666\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/euskal-herria-kalea/parte-vieja/donostia-san-sebastian/a4f7fa9c-f37b-428c-a8f9-55165bec6dc3/d\",\"feature\":null,\"short\":\"/a/a4f7fa9c-f37b-428c-a8f9-55165bec6dc3\"}},{\"id\":\"8594baf0-090c-42bc-920d-077320b3fe5e\",\"reference\":\"868\",\"legacyNumericId\":\"52363000000279\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/calle-segundo-ispizua/gros/donostia-san-sebastian/8594baf0-090c-42bc-920d-077320b3fe5e/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/gros/s\",\"summary\":{\"title\":\"Piso de alquiler para estudiantes en el barrio de Gros\",\"description\":\"Piso para estudiantes (Curso 2026-2027) en Gros \u2013 3 hab. exteriores con terraza (1.400 \u20AC/mes)\\n\\nExcelente oportunidad de alquiler temporal para el curso acad\u00E9mico (de septiembre de 2026 a julio de 2027) en el barrio de Gros, a un paso de la playa de Zurriola y bien comunicado con los campus universitarios. Buscamos un perfil de inquilinos responsables, formales y respetuosos con la convivencia de la comunidad.\\n\\nVivienda amueblada y equipada con menaje completo.\\n\\nDistribuci\u00F3n de la vivienda:\\n\\n-3 habitaciones exteriores: Muy luminosas, equipadas con armario empotrado, cama y mesa de estudio en cada una.\\n-2 ba\u00F1os completos y  aseo: Uno integrado en suite dentro de la habitaci\u00F3n principal.\\n-Espacios comunes: Sal\u00F3n acogedor con salida a terraza exterior, zona de comedor independiente y cocina equipada.\\n\\nCondiciones del alquiler y requisitos:\\n\\n-Exclusivo estudiantes: Imprescindible presentar la matr\u00EDcula oficial del curso 2026-2027.\\n-Ocupaci\u00F3n m\u00E1xima: 3 personas.\\n-Garant\u00EDas econ\u00F3micas: Se requiere aval (padres o tutores legales como avalistas solidarios).\\n-Renta y gastos: 1.400 \u20AC / mes (+ gastos de comunidad, luz y agua no incluidos).\\n-Servicios: La conexi\u00F3n a internet/fibra corre a cuenta de los inquilinos.\\n-Fianza y entrada: 1 mes de fianza (depositada en el Gobierno Vasco) + 1 mes de renta por adelantado.\\n-Mascotas: No se admiten mascotas.\\n-Periodo: De septiembre de 2026 a julio de 2027.\\n\\nContacto: Atenderemos \u00FAnicamente las solicitudes recibidas por correo electr\u00F3nico. Si est\u00E1is interesados, enviad un e-mail indicando vuestro perfil universitario\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Gros\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Calle Segundo Ispizua\",