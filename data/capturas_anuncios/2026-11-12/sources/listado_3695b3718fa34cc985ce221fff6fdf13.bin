atic.fotocasa.es/images/ads/1a947ac5-b513-4843-953f-446c7b54d78b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3d4ad9c3-e604-4d29-bbed-cebf8f7ba0f1?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/0145359f-c825-4ff0-87bd-3f81948fc090?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":43,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"e4bd625a-1499-4476-a408-c25fa03ed9dc\",\"name\":\"LIGATI SL\",\"tradeName\":\"Araxes Agencia Inmobiliaria\",\"logo\":\"https://static.fotocasa.es/images/client/9202758917444/625209.jpg?rule=original\",\"website\":\"http://www.araxes.es/?utm_medium=fotocasa\",\"navigationUrl\":\"/inmobiliaria/araxes-agencia-inmobiliaria/\",\"legacyPublisherId\":\"30956\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"349\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T11:24:57.9095210+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":80,\"landArea\":null,\"constructionYear\":1980,\"terrace\":{\"has\":true},\"floor\":\"SIXTH\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"WARDROBES\",\"EQUIPPED_KITCHEN\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\"]},\"orientation\":\"EAST\",\"heating\":\"NON_SPECIFIED\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":178},\"emissions\":{\"label\":\"E\",\"value\":37}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"FOR_STUDENTS\",\"IS_EXTERIOR\",\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1350,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1350,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"iagestion_1407@iagestion.com\",\"phone\":\"+34604557120\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/pescadores-gran-sol-10/amara-berri/donostia-san-sebastian/7b1fa25c-d44b-4c14-8a09-2abfe7527d3e/d\",\"feature\":null,\"short\":\"/a/7b1fa25c-d44b-4c14-8a09-2abfe7527d3e\"}},{\"id\":\"b07181a8-6c70-408e-8748-78679e737b35\",\"reference\":\"2423133\",\"legacyNumericId\":\"30956000001094\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/donostia-san-sebastian-calle-zabaleta-37/gros/donostia-san-sebastian/b07181a8-6c70-408e-8748-78679e737b35/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/gros/s\",\"summary\":{\"title\":\"Preciosa vivienda temporal en el coraz\u00F3n de Gros.\",\"description\":\"ALQUILER de TEMPORADA. (NO larga duraci\u00F3n). Per\u00EDodo de 8/9 meses, hasta julio inclu\u00EDdo.\\n En excelente ubicaci\u00F3n, calle Zabaleta, con vistas despejadas y junto a la playa de la Zurriola. \\n Superficie: 77 m2 \u00FAtiles.\\n Distribuci\u00F3n:  Hall de entrada (4 m2), con acceso a amplio sal\u00F3n con gran mirador y vistas a la plaza Catalu\u00F1a (23 m2), cocina funcional y totalmente equipada con ventilaci\u00F3n a patio interior (9,50 m2), dos amplios y luminosos dormitorios, ambos con armario empotrado y salida a balc\u00F3n (11,50 y 12m2) , tercer dormitorio (7,50 m2) con armario empotrado y ventana  patio interior, ba\u00F1o completo con ducha (6 m2) y segundo ba\u00F1o completo con ba\u00F1era (4 m2).\\n Caracter\u00EDsticas: El piso se encuentra en perfecto estado y totalmente amueblada, es acogedora y con todas las comodidades. El agua caliente y la calefacci\u00F3n es de gas natural.\\n Ubicaci\u00F3n:- Excelente ubicaci\u00F3n en el coraz\u00F3n de Gros, en plena plaza Catalu\u00F1a y a un paso del Boulevard de San Sebasti\u00E1n. Junto a la playa de La Zurriola. En los alrededores cuenta con todo tipo de servicios comerciales y de ocio, estando muy pr\u00F3ximo a las paradas de autob\u00FAs que conectan el Centro de la ciudad con el resto de los barrios. \\n Condiciones:  Fianza Legal (2 mensualidades de Renta) y Honorarios de la Agencia Inmobiliaria (equivalente al 12% de los meses alquilados + IVA), por cuenta del Inquilino.\\n  No se admiten animales.\\n  \\n \u0093Cl\u00E1usula de Transparencia y Desglose de Gastos (Ley 10/2025)\\n En cumplimiento de las obligaciones de informaci\u00F3n previstas en la Ley 10/2025, de 28 de diciembre, de servicios de atenci\u00F3n a la clientela y transparencia, as\u00ED como en la normativa sectorial vigente, se hace constar que:El precio indicado NO incluye los gastos siguientes que no pueden ser calculados de antemano y que ser\u00E1n por cuenta del arrendatario:Los gastos de Electricidad, Gas, as\u00ED como la tasa de Agua y basuras.El impuesto de Transmisiones patrimoniales si se devengara.Ser\u00E1n por cuenta de la Propiedad los gastos siguientes:Los gastos de ComunidadEl Impuesto de bienes inmueblesLos Honorarios de comercializaci\u00F3n de la Agencia Inmobiliaria.\",\"location\":{\"visibility\":\"EXACT\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Gros\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Donostia-San Sebasti\u00E1n - Calle Zabaleta\",\"streetNumber\":\"37\"},\"coordinates\":{\"latitude\":43.3244276,\"longitude\":-1.9745749},\"displayAddressLine\":\"Donostia-San Sebasti\u00E1n - Calle Zabaleta 37\",\"displayZoneLine\":\"Gros, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Gros\",\"slug\":\"gros\"},{\"type\":\"street\",\"value\":\"Calle Gran Via\",\"slug\":\"calle-gran-via\"},{\"type\":\"street\",\"value\":\"Calle Zabaleta\",\"slug\":\"calle-zabaleta\"},{\"type\":\"street\",\"value\":\"Calle Padre Larroca\",\"slug\":\"calle-padre-larroca\"},{\"type\":\"street\",\"value\":\"Calle Usandizaga\",\"slug\":\"calle-usandizaga\"},{\"type\":\"street\",\"value\":\"Paseo Zurriola\",\"slug\":\"paseo-zurriola\"},{\"type\":\"street\",\"value\":\"Plaza de Biteri\",\"slug\":\"plaza-de-biteri\"},{\"type\":\"street\",\"value\":\"Plaza de Catalu\u00F1a\",\"slug\":\"plaza-de-cataluna\"},{\"type\":\"street\",\"value\":\"Calle San Francisco\",\"slug\":\"calle-san-francisco\"},{\"type\":\"street\",\"value\":\"Calle Ramon y Cajal\",\"slug\":\"calle-ramon-y-cajal\"},{\"type\":\"street\",\"value\":\"Plaza de Zuberoa\",\"slug\":\"plaza-de-zuberoa\"},{\"type\":\"street\",\"value\":\"Calle Claudio A. Luzuriaga\",\"slug\":\"calle-claudio-a-luzuriaga\"},{\"type\":\"street\",\"value\":\"Avenida de Zurriol\",\"slug\":\"avenida-de-zurriol\"},{\"type\":\"street\",\"value\":\"Paseo de Colon\",\"slug\":\"paseo-de-colon\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20002\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"20\"},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2048\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.e