7-9037-e27a58a5349b?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":32,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"0d7c69b6-013a-406f-9831-8957562bd1bf\",\"name\":\"GRUPO MOLDATU HOME\",\"tradeName\":\"GRUPO MOLDATU HOME\",\"logo\":\"https://static.fotocasa.es/images/client/0d7c69b6-013a-406f-9831-8957562bd1bf/20251023151213?rule=original\",\"website\":\"https://www.moldatuhome.com/\",\"navigationUrl\":\"/inmobiliaria/grupo-moldatu-home/\",\"legacyPublisherId\":\"29796\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"487\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-26T17:49:16.9181061+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"PRETTY_GOOD\",\"rooms\":2,\"bathrooms\":2,\"builtSurface\":108,\"landArea\":null,\"constructionYear\":1915,\"terrace\":{\"surface\":3,\"has\":true},\"floor\":\"THIRD\",\"features\":{\"has\":[\"ELEVATOR\",\"SECURITY_DOOR\",\"WARDROBES\",\"EQUIPPED_KITCHEN\",\"OFFICE_KITCHEN\"],\"hasNot\":[]},\"orientation\":\"EAST\",\"heating\":\"ELECTRIC\",\"hotWater\":\"ELECTRIC\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"F\",\"value\":284},\"emissions\":{\"label\":\"E\",\"value\":48}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1746,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1746,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3140@inmoweb.email\",\"phone\":\"+34641483681\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/centro/donostia-san-sebastian/28f44321-4f0b-467a-98ff-20d45f88ccdb/d\",\"feature\":null,\"short\":\"/a/28f44321-4f0b-467a-98ff-20d45f88ccdb\"}},{\"id\":\"a4f7fa9c-f37b-428c-a8f9-55165bec6dc3\",\"reference\":\"T6577D\",\"legacyNumericId\":\"29680000002453\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/euskal-herria-kalea/parte-vieja/donostia-san-sebastian/a4f7fa9c-f37b-428c-a8f9-55165bec6dc3/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/parte-vieja/s\",\"summary\":{\"title\":\"Temporal en el centro\",\"description\":\"Disponible para alquiler temporal  este piso se sit\u00FAa en la calle Euskal Herria, en pleno centro de San Sebasti\u00E1n.\\r\\nUbicado en una cuarta planta con ascensor, ofrece un acceso c\u00F3modo y pr\u00E1ctico. La vivienda est\u00E1 distribuida en dos habitaciones, dos ba\u00F1os completos, cocina equipada y zona de estar funcional. Todas las estancias dan a un amplio patio de manzana, lo que garantiza tranquilidad y buena luz natural.\\r\\nSeptiembre a junio: 1.500\u20AC\\r\\nJulio: 2.500\u20AC\\r\\nAgosto:3.500\u20AC\\r\\nEn una zona con todos los servicios, comercios y conexiones de transporte a pie de calle.\\r\\n-Honorarios a cargo del inquilino en funci\u00F3n de la duraci\u00F3n del alquiler.\\r\\n-Fianza en funci\u00F3n de la duraci\u00F3n del alquiler\\r\\n-No mascotas.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Parte Vieja\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Euskal Herria Kalea\",\"streetNumber\":\"9\"},\"coordinates\":{\"latitude\":43.324700680347796,\"longitude\":-1.9822229456941614},\"displayAddressLine\":\"Euskal Herria Kalea\",\"displayZoneLine\":\"Parte Vieja, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pa