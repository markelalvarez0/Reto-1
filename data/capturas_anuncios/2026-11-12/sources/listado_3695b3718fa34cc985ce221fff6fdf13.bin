\":null,\"url\":\"https://static.fotocasa.es/images/ads/491a2221-8b1b-44ef-a6bc-d3900745d2b0?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e7878315-9432-4035-a2b0-9cfa35f223d1?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3f009c6a-8e45-4069-9323-d11c9e5403b9?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/950fcf10-1783-4e0e-92bc-72c3e65a0829?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/5c6744a3-db38-4ae5-8aea-6d80cadfcfde?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/24c56a19-2f5f-4e25-a830-b3a52ede1e2f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/bf17b641-c705-4f08-8819-16078e7a2d00?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/224c7608-e445-45a3-a566-99dea823c01a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ff0e2323-9ed5-4845-9ff7-fadfe13a4658?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b4262283-4fc5-499a-adfb-86ef07c0e20e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/79a3c94e-697a-4430-9aae-a6b40184c9bb?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/760deabc-63ec-4439-8439-574fe87da11e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f5e363e6-014b-40c4-98da-b7ad56b73f9c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/81878d0a-aa8c-4ea8-9122-f6954d383eb3?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":30,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"83a4d860-ebff-4bdf-88cd-dd57a20ec760\",\"name\":\"TOC TOC GESTI\u00D3N INMOBILIARIA\",\"tradeName\":\"TOC TOC GESTI\u00D3N INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/83a4d860-ebff-4bdf-88cd-dd57a20ec760/20260903174514?rule=original\",\"website\":\"http://www.toctoc.com.es\",\"navigationUrl\":\"/inmobiliaria/toc-toc-gestion-inmobiliaria/\",\"legacyPublisherId\":\"60080\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-09-16T14:55:41.9564896+02:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"PRETTY_GOOD\",\"rooms\":2,\"bathrooms\":1,\"builtSurface\":66,\"landArea\":null,\"floor\":\"THIRD\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"EQUIPPED_KITCHEN\",\"YARD\",\"AIR_CONDITIONER\",\"NEARBY_PUBLIC_TRANSPORT\",\"PARQUET\",\"STONEWARE\",\"HOME_APPLIANCES\",\"OVEN\",\"WASHING_MACHINE\",\"MICROWAVE\",\"FRIDGE\",\"TV\"],\"hasNot\":[\"PETS_ALLOWED\",\"WARDROBES\",\"STORAGE_ROOM\",\"PRIVATE_PARKING\",\"PRIVATE_GARDEN\",\"SECURITY_DOOR\",\"COMMUNITY_POOL\",\"PRIVATE_POOL\",\"FIREPLACE\",\"ALARM\",\"SURVEILLANCE_SYSTEM\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"OFFICE_KITCHEN\",\"DOORMAN\",\"JACUZZI\",\"SAUNA\",\"TENNIS_COURT\",\"GYM\",\"SPORTS_AREA\",\"CHILDREN_AREA\",\"HOME_AUTOMATION\",\"INTERNET\",\"SUITE_BATHROOM\",\"BALCONY\",\"DISHWASHER\",\"DRYER\"]},\"orientation\":\"NORTH_EAST\",\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":144},\"emissions\":{\"label\":\"E\",\"value\":48}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"FOR_STUDENTS\",\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1200,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1200,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"toctocinmob@gmail.com\",\"phone\":\"+34605707660\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/bergara-kalea/centro/donostia-san-sebastian/46dd475e-517e-40ad-acdc-c9e5f6748a07/d\",\"feature\":null,\"short\":\"/a/46dd475e-517e-40ad-acdc-c9e5f6748a07\"}},{\"id\":\"5b484ee8-012b-4635-868d-0f25c4e7f905\",\"reference\":\"T6297\",\"legacyNumericId\":\"29680000002134\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/beatriz-infantaren-kalea/antiguo/donostia-san-sebastian/5b484ee8-012b-4635-868d-0f25c4e7f905/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/antiguo/s\",\"summary\":{\"title\":\"ALQUILER TEMPORAL en Ondarreta a estrenar\",\"description\":\"TEMPORAL Disponible \\r\\nOndarreta, Infanta Beatriz, piso a estrenar en alquiler TEMPORAL en Villa Saudade, una de las villas m\u00E1s emblem\u00E1ticas de la ciudad. El piso est\u00E1 distribuido en sal\u00F3n exterior con salida a balc\u00F3n haciendo esquina con orientaci\u00F3n oeste, cocina integrada exterior, dos dormitorios exteriores (uno de ellos con salida a balc\u00F3n sur) y dos ba\u00F1os (uno de ellos incorporado en dormitorio principal) completamente amueblado.\\r\\nLa vivienda cuenta con sistema de aerotermia. El piso dispone de una plaza de garaje cubierta. \\r\\nInmejorable ubicaci\u00F3n a un paso de la playa Ondarreta.\\r\\nDisponibilidad:\\r\\nJulio: disponible\\r\\nagosto: disponible\\r\\nSeptiembre a junio: 2.500\u20AC\\r\\n-Honorarios en funci\u00F3n de la duraci\u00F3n del alquiler.\\r\\n-Fianza en funci\u00F3n de la duraci\u00F3n del alquiler.\\r\\n-Suministros a cargo del inquilino.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Antiguo\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\