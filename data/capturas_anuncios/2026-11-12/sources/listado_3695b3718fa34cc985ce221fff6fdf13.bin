.fotocasa.es/images/ads/5719a44d-a306-41b6-b172-2f3a85263ebf?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/89a69c08-ae3f-4c1b-b62b-82cc86b34a1b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/1456e574-48b9-4e2c-b0b5-33011231229c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/cff1d3d2-72f6-4a62-905a-b49977b6443a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/92fe81e2-eea5-4b95-9535-9d7ba61a6d04?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b38561b9-cd55-4f97-ba98-fa89b3632a69?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/74f5b4c8-88a1-4d92-b6a4-8386a814185e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f342c9be-4caa-40e2-8af6-8174586d9eed?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f3028784-f295-4292-9256-57fc754b3e10?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/577f7d2c-deaf-4253-b21f-8dbab0592051?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":20,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"83a4d860-ebff-4bdf-88cd-dd57a20ec760\",\"name\":\"TOC TOC GESTI\u00D3N INMOBILIARIA\",\"tradeName\":\"TOC TOC GESTI\u00D3N INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/83a4d860-ebff-4bdf-88cd-dd57a20ec760/20260903174514?rule=original\",\"website\":\"http://www.toctoc.com.es\",\"navigationUrl\":\"/inmobiliaria/toc-toc-gestion-inmobiliaria/\",\"legacyPublisherId\":\"60080\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":true,\"premium\":true,\"priorityTier\":\"basic\",\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-09-16T14:56:38.0817621+02:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":84,\"landArea\":null,\"floor\":\"SECOND\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"EQUIPPED_KITCHEN\",\"YARD\",\"NEARBY_PUBLIC_TRANSPORT\",\"BALCONY\",\"HOME_APPLIANCES\",\"OVEN\",\"WASHING_MACHINE\",\"MICROWAVE\",\"FRIDGE\",\"TV\"],\"hasNot\":[\"PETS_ALLOWED\",\"WARDROBES\",\"STORAGE_ROOM\",\"PRIVATE_PARKING\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"SECURITY_DOOR\",\"COMMUNITY_POOL\",\"PRIVATE_POOL\",\"FIREPLACE\",\"ALARM\",\"SURVEILLANCE_SYSTEM\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"OFFICE_KITCHEN\",\"DOORMAN\",\"JACUZZI\",\"SAUNA\",\"TENNIS_COURT\",\"GYM\",\"SPORTS_AREA\",\"CHILDREN_AREA\",\"HOME_AUTOMATION\",\"INTERNET\",\"SUITE_BATHROOM\",\"PARQUET\",\"STONEWARE\",\"DISHWASHER\",\"DRYER\"]},\"orientation\":\"WEST\",\"heating\":\"ELECTRIC\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"G\",\"value\":337},\"emissions\":{\"label\":\"F\",\"value\":62}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"FOR_STUDENTS\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1350,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1350,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"toctocinmob@gmail.com\",\"phone\":\"+34605707660\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/arroka-kalea/centro/donostia-san-sebastian/4b92a7c9-b88b-492c-8731-42b6b0948160/d\",\"feature\":null,\"short\":\"/a/4b92a7c9-b88b-492c-8731-42b6b0948160\"}},{\"id\":\"0ebcc1a0-85f1-456d-aa67-67edaf7c1924\",\"reference\":\"Piso consti\",\"legacyNumericId\":\"23636000000425\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/constitucion-plaza-145/parte-vieja/donostia-san-sebastian/0ebcc1a0-85f1-456d-aa67-67edaf7c1924/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/parte-vieja/s\",\"summary\":{\"title\":\"MARAVILLOSO PISO EN ALQUILER EN PLENA PLAZA DE LA CONSTITUCI\u00D3N DE DONOSTIA - San Sebasti\u00E1n\",\"description\":\"Oportunidad de alquilar por meses precioso piso en plena plaza de la constituci\u00F3n de Donosti, en el coraz\u00F3n del Casco Antiguo, a escasos metros del puerto Pesquero. Precioso y c\u00F3modo piso de aprox 75m2 que consta de 2 habitaciones dobles, amplio cuarto de ba\u00F1o, moderna cocina totalmente equipada con bonitos muebles de nivel y todos los electrodom\u00E9sticos, inducci\u00F3n, lavadora, frigor\u00EDfico combi, lavavajillas, calienta agua, tostadora, cafetera, menaje, ollas etc\u2026 Calefacci\u00F3n con radiadores con gas ciudad en todas las estancias de la casa, cocina y ba\u00F1o incluidos. La casa es una delicia, ideal para cuatro personas con amplitud ya que dispone de 4 amplias camas individuales adem\u00E1s de un sof\u00E1 cama para visitas inesperadas.\\n\\nLo mejor de todo est\u00E1 en las dos terrazas con vistas a la plaza de constituci\u00F3n, en primera planta y haciendo esquina frente al antiguo ayuntamiento. Tanto el sal\u00F3n como la amplia habitaci\u00F3n principal comunican a trav\u00E9s de amplias puertas a dos terrazas que dan a la famosa plaza de los arcos llena de eventos. Adem\u00E1s tenemos que destacar que el piso est\u00E1 en la mayor zona gastron\u00F3mica de Donosti, plena parte vieja, rodeado de los bares de pintxos mas sabrosos y conocidos de San Sebasti\u00E1n. En el piso se incluyen varias rutas documentadas de pintxos de la zona a escasos metros de la vivienda.\\n\\nOportunidad de lujo para disfrutar a un precio asequible de una temporada de descanso en la mejor zona de una de las ciudades mas bonitas y cosmopolitas de Europa para poder probar la gastronom\u00EDa vasca, visitar el aquarium, el monte Urguz,, las playas de la Concha, Ondarreta y la Zurriola, y no nos olvidemos del Kursal y Festival de cine de San Sebasti\u00E1n.\\n\\nPrecio por mes: de 1600\u20AC a 1700\u20AC dependiendo tiempo de estancia.\\nActualmente disponible a partir de septiembre-octubre\",\"location\":{\"visibility\":\"EXACT\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Parte Vieja\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Constituci\u00F3n Plaza\",\"streetNumber\":\"145\"},\"coordinates\":{\"latitude\":43.323404,\"longitude\":-1.9850596},\"displayAddressLine\":\"Constituci\u00F3n Plaza 145\",\"displayZoneLine\":\"Parte Vieja, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Parte Vieja\",\"slug\":\"parte-vieja\"},{\"type\":\"street\",\"value\":\"Calle Narrica\",\"slug\":\"calle-narrica\"},{\"type\":\"street\",\"value\":\"Calle San Jeronimo\",\"slug\":\"calle-san-jeronimo\"},{\"type\":\"street\",\"value\":\"Plaza de De Sarriegi\",\"slug\":\"plaza-de-de-sarriegi\"},{\"type\":\"street\",\"value\":\"Calle Santa Corda\",\"slug\":\"calle-santa-corda\"},{\"type\":\"street\",\"value\":\"Calle Embeltran\",\"slug\":\"calle-embeltran\"},{\"type\":\"street\",\"value\":\"Calle Bilintx\",\"slug\":\"calle-bilintx\"},{\"type\":\"street\",\"value\":\"Calle I\u00F1igo\",\"slug\":\"calle-inigo\"},{\"type\":\"street\",\"