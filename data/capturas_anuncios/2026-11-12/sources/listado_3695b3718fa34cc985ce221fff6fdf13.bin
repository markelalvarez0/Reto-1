},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2056\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ee357d80-9249-407b-850e-5f9c686e523f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/706666fb-aff0-4513-86df-f7eddfbcc07b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/052e0ce5-91ed-4a59-94cb-2f1458fa5aa2?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/a497c060-5521-4af1-b5cb-f667235fa866?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c6a1a53f-e3f2-43ca-bf93-a975c49e87ab?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/becc25f1-d1e4-4480-ab9c-ce343579c259?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/397f9bd5-2f69-47e6-aaf0-44e6f9718326?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/aa6e4d5c-3258-4971-8e8b-9fadc54a5260?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f5762960-bb05-412e-b389-fb33df37fd22?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2b61677f-7f52-4fa2-b5fb-ddfd5e3bf894?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/948cafd1-1cf8-4b2e-879d-bd8649a5b193?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c31b9456-9889-4bdd-a891-4388e7e9f2f1?rule=original\",\"position\":null}],\"videos\":[{\"type\":null,\"url\":\"https://www.youtube-nocookie.com/embed/WJu4vcE7jWI\",\"position\":null}],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":12,\"videos\":1,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"9f3837ad-004a-4684-aa8b-395c962397e8\",\"name\":\"Uniplaces\",\"tradeName\":\"Uniplaces\",\"logo\":\"https://static.fotocasa.es/images/client/9f3837ad-004a-4684-aa8b-395c962397e8/20260219104510?rule=original\",\"website\":\"https://www.uniplaces.com/es\",\"navigationUrl\":\"/inmobiliaria/uniplaces-2/\",\"legacyPublisherId\":\"50824\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-12T03:05:21.1608380+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"apartment\",\"status\":null,\"rooms\":3,\"bathrooms\":1,\"builtSurface\":72,\"landArea\":null,\"floor\":null,\"features\":{\"has\":[\"INTERNET\",\"AIR_CONDITIONER\",\"OVEN\",\"MICROWAVE\",\"WASHING_MACHINE\",\"EQUIPPED_KITCHEN\",\"FURNISHED\"],\"hasNot\":[]},\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":3400,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":3400,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"agents@uniplaces.com\",\"phone\":\"+34910781711\"},\"urls\":{\"canonical\":\"/alquiler/apartamento/parte-vieja/donostia-san-sebastian/20e0932a-0a72-433b-b570-7c6b543a6101/d\",\"feature\":null,\"short\":\"/a/20e0932a-0a72-433b-b570-7c6b543a6101\"}},{\"id\":\"46dd475e-517e-40ad-acdc-c9e5f6748a07\",\"reference\":\"5277 - BERGARA KL.  2026/2027\",\"legacyNumericId\":\"60080000000002\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/bergara-kalea/centro/donostia-san-sebastian/46dd475e-517e-40ad-acdc-c9e5f6748a07/d\",\"listingNavigationUrl\":null,\"summary\":{\"title\":\"REF. 5277 - BERGARA KL.  2026/2027 CURSO\",\"description\":\"*** CURSO 2026/2027 *** \\n\\n 01 de SEPTIEMBRE 2026 - 30 de JUNIO DE 2027.\\n \\n VERANO, NO DISPONIBLE\\n NO LARGA ESTANCIA\\n\\n ***EXCLUSIVO ESTUDIANTES UNIVERSITARIOS *** \u00A1S\u00CD, ya se puede VISITAR!\\n\\n NO disponible para larga estancia. NO disponible verano.\\n NO LLAMAR para consultar esta cuesti\u00F3n, por favor.\\n \\n\\nIDEAL ESTUDIANTES DEUSTO, COCINA BASQUE CULINARY CENTER, ENFERMERIA, E. H. U.\\n\\nAlquiler exclusivamente para estudiantes universitarios desplazados a Donostia-San Sebasti\u00E1n para Curso Acad\u00E9mico 2026/2027.\\n\\nVivienda en el coraz\u00F3n de la ciudad, pleno centro con todo tipo de servicios y transporte a un paso. Cerca de las \u00E1reas de ocio, teatros y cines, playas. Ideal para estudiar y descansar y adem\u00E1s en una excelente ubicaci\u00F3n para acudir a cualquier centro de estudios.\\n\\nUbicaci\u00F3n y prestaciones:\\nLa vivienda se presenta con un amueblado de calidad (armarios, camas, colchones. ), y resulta c\u00E1lida y muy agradable. \\nVivienda en buenas condiciones, tras puesta a punto general.\\n\\nDistribuci\u00F3n: \\nDispone de amplio hall distribuidor, 2 dormitorios (1 con cama de matrimonio, y el otro con doble, con cama nido), sala de estar, cocina-comedor separada, y 1 ba\u00F1o de tres piezas (ducha, inodoro y lavabo. Hay mueble mural) Obra integral del ba\u00F1o (12/2025).\\n\\nServicios individuales. La casa dispone de caldera mixta para agua caliente y calefacci\u00F3n individual a gas natural, y tambi\u00E9n hay Aire Acondicionado (fr\u00EDo y calor).\\nSuelos de madera maciza de elondo.\\nApartamento exterior a patio de manzana.\\n\\nRenta, 1.200\u20AC/mes, m\u00E1s facturas por suministro de servicios.\\nFianza, la estipulada por Gobierno Vasco, en este caso: \u20AC1.995,00.-\\nHonorarios, 1.200\u20AC m\u00E1s IVA del 21%\\nNO se admiten animales/mascotas.\\n\\n*** De acuerdo con la normativa de transparencia -Ley 10/2025 y Ley 12/2023 les informamos de los siguientes datos:\\n1.- El propietario-arrendador NO tiene la condici\u00F3n de gran tenedor,\\n2.- La propiedad se encuentra en una zona de mercado tensionado,\\n3.- El importe de la renta NO est\u00E1 sujeta a limitaciones de precio al no tener un destino de vivienda habitual, conforme a lo estipulado por el MINISTERIO DE VIVIENDA Y AGENDA URBANA, y conforme a la legislaci\u00F3n actual.\\n4.- El arrendador se hace cargo del I.B.I. y de los gastos de comunidad.\\n5.- Es por cuenta del inquilino arrendatario las facturas resultante de los gastos de consumo en los que incurra, tales como electricidad, gas y Agua+Saneamiento+Basuras.\\n\\nTOC, TOC! gesti\u00F3n inmobiliaria queda a su disposici\u00F3n para ampliar cualquier informaci\u00F3n adicional que precisen.\\n\\nPropiedad gestionada por TOC, TOC! gesti\u00F3n inmobiliaria - higiezin kudeaketa.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Centro\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Bergara Kalea\",\"streetNumber\":\"11\"},\"coordinates\":{\"latitude\":43.31947787353633,\"longitude\":-1.9798243746944308},\"displayAddressLine\":\"Bergara Kalea\",\"displayZoneLine\":\"Centro, Donostia - San Sebasti\u00E1n\",\"layers\":[],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20005\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"20\"},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2045\"},{\"level\":\"neighbourhood\",\"code\":\"843\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/cb317c4e-2cd8-4b6f-8f63-288fcf9dc411?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https:/