riginal\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c2243479-a681-43ed-b002-4ff37b54fdd5?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f2b4c5b3-754b-41a8-8a02-5d445dd0bb11?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/09079f3b-ac9e-4895-bee9-c6ba2ca4376c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/92fe487f-89f8-482f-a38f-72be1a249853?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/3d25ae03-0bc4-4b11-8aa1-1786cdc06451?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f4be2622-9ded-4a1f-97b4-f59e26a55a52?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6156f729-3245-4b84-918b-9e9fac9e2957?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/8d4b520d-37b0-46e8-8580-d000ba6e01b1?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/828b89c0-e48d-4c99-af07-099caad9507f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b106938a-9230-4560-90e8-fab0ae389baa?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/910fb914-f39b-4dd4-a8f0-a8b43ea311d4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/61a1f635-ecd5-4fd4-9807-5d40299e9a29?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":29,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"7d947906-2cdc-4e85-a35f-c749bc64f8ae\",\"name\":\"Inmobiliaria Carriquiri \",\"tradeName\":\"Inmobiliaria Carriquiri \",\"logo\":\"https://static.fotocasa.es/images/client/7d947906-2cdc-4e85-a35f-c749bc64f8ae/20230310092401.jpeg?rule=original\",\"website\":\"https://www.inmobiliariacarriquiri.com/\",\"navigationUrl\":\"/inmobiliaria/inmobiliaria-carriquiri/\",\"legacyPublisherId\":\"43632\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T11:25:00.2763649+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":3,\"bathrooms\":2,\"builtSurface\":90,\"landArea\":null,\"constructionYear\":1969,\"floor\":\"SIXTH\",\"features\":{\"has\":[],\"hasNot\":[]},\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"HAS_VIEW_TO_BEACH\",\"IS_EXTERIOR\",\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":3000,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":3000,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"i.inmobiliariacarriquiri.12155@inmovilla.com\",\"phone\":\"+34943967458\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/centro/donostia-san-sebastian/633a0634-dc9f-4524-b8d4-a5c722492570/d\",\"feature\":null,\"short\":\"/a/633a0634-dc9f-4524-b8d4-a5c722492570\"}},{\"id\":\"dfb0f221-0b67-442f-8f64-d2c863adf7be\",\"reference\":\"Ga2425\",\"legacyNumericId\":\"31357000000873\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/jose-maria-salaberria/amara-berri/donostia-san-sebastian/dfb0f221-0b67-442f-8f64-d2c863adf7be/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/amara-berri/s\",\"summary\":{\"title\":null,\"description\":\"ARRENDAMIENTO LARGA DURACION. VIVIENDA AMUEBLADA de 68 m2 \u00FAtiles, EN AMARA. La vivienda consta de 3 habitaciones, sal\u00F3n-comedor, cocina equipada y dos ba\u00F1os (uno de ellos incorporado en la habitaci\u00F3n principal). Con terraza a la que se accede desde el sal\u00F3n.  Alto, luminoso, EXTERIOR. El inmueble dispone de ascensor (sin barreras arquitect\u00F3nicas). \\r\\nConstrucci\u00F3n del a\u00F1o 1978.\\r\\nMUY BIEN SITUADO y COMUNICADO. Muy cerca dispone de todos los servicios (parada de autob\u00FAs, supermercado, farmacia, etc.. . ).\\r\\n\\r\\nAGENCIA INMOBILIARIA y ASESOR\u00CDA JUR\u00CDDICA NUEVO GROS es una agencia inmobiliaria con m\u00E1s de 35 a\u00F1os de experiencia, que cuenta con Agentes de la Propiedad Inmobiliaria y Abogados EXPERTOS EN DERECHO INMOBILIARIO, para el asesoramiento de nuestros clientes en la COMPRA-VENTA y ALQUILER de fincas. Para cualquier consulta no dude en llamarnos 943-293029. [IW]. [IW]\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Amara - Berri\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Jose Maria Salaberria\",\"streetNumber\":\"35\"},\"coordinates\":{\"latitude\":43.3031137614763,\"longitude\":-1.9811992934302225},\"displayAddressLine\":\"Jose Maria Salaberria\",\"displayZoneLine\":\"Amara - Berri, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Amara\",\"slug\":\"amara\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Amara - Berri\",\"slug\":\"amara-berri\"},{\"type\":\"street\",\"value\":\"Calle Jos