\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"arrigain@arrigain.com\",\"phone\":\"+34943450666\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/fermin-calbeton/parte-vieja/donostia-san-sebastian/d303fe09-891a-451b-9db9-c71af8748683/d\",\"feature\":null,\"short\":\"/a/d303fe09-891a-451b-9db9-c71af8748683\"}},{\"id\":\"ca3fa072-bfb9-42f3-ab5d-a517ff576520\",\"reference\":\"Ga1018\",\"legacyNumericId\":\"31357000000865\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/segundo-izpizua-kalea/gros/donostia-san-sebastian/ca3fa072-bfb9-42f3-ab5d-a517ff576520/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/gros/s\",\"summary\":{\"title\":null,\"description\":\"ALQUILER DE TEMPORADA ( de septiembre a junio m\u00E1ximo) Piso de 2 habitaciones, sal\u00F3n con cocina americana equipada y ba\u00F1o. Alto,  con una hermosa terraza. Cocina totalmente equipada. Amueblado. Situado muy cerca de la playa de la Zurriola. El inmueble dispone de ascensor. Muy bien situado y comunicado. Muy cerca dispone de todos los servicios (parada de autob\u00FAs, farmacia, supermercado,.. . ).\\r\\nGARANTIAS: 1 mes de fianza y 2 meses de dep\u00F3sito. \\r\\n\\r\\nAGENCIA INMOBILIARIA y ASESOR\u00CDA JUR\u00CDDICA NUEVO GROS es una agencia inmobiliaria con m\u00E1s de 35 a\u00F1os de experiencia, que cuenta con Agentes de la Propiedad Inmobiliaria y Abogados EXPERTOS EN DERECHO INMOBILIARIO, para el asesoramiento de nuestros clientes en la COMPRA-VENTA y ALQUILER de fincas. Para cualquier consulta no dude en llamarnos 943-293029. [IW]\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Gros\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Segundo Izpizua Kalea\",\"streetNumber\":\"10\"},\"coordinates\":{\"latitude\":43.32494525945142,\"longitude\":-1.9720868337013826},\"displayAddressLine\":\"Segundo Izpizua Kalea\",\"displayZoneLine\":\"Gros, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Gros\",\"slug\":\"gros\"},{\"type\":\"street\",\"value\":\"Calle Secundino Esnaola\",\"slug\":\"calle-secundino-esnaola\"},{\"type\":\"street\",\"value\":\"Calle Txofre\",\"slug\":\"calle-txofre\"},{\"type\":\"street\",\"value\":\"Plaza Nafarroa Beherea\",\"slug\":\"plaza-nafarroa-beherea\"},{\"type\":\"street\",\"value\":\"Plaza Txofre L\",\"slug\":\"plaza-txofre-l\"},{\"type\":\"street\",\"value\":\"Avenida de Zurriol\",\"slug\":\"avenida-de-zurriol\"},{\"type\":\"street\",\"value\":\"Calle Bermingham\",\"slug\":\"calle-bermingham\"},{\"type\":\"street\",\"value\":\"Calle General Artetxe\",\"slug\":\"calle-general-artetxe\"},{\"type\":\"street\",\"value\":\"Paseo J. Mig. Barandiaran\",\"slug\":\"paseo-j-mig-barandiaran\"},{\"type\":\"street\",\"value\":\"Calle San Francisco\",\"slug\":\"calle-san-francisco\"},{\"type\":\"street\",\"value\":\"Calle Segundo Ispizua\",\"slug\":\"calle-segundo-ispizua\"},{\"type\":\"street\",\"value\":\"Calle Zabaleta\",\"slug\":\"calle-zabaleta\"},{\"type\":\"street\",\"value\":\"Avenida de Navarra\",\"slug\":\"avenida-de-navarra\"},{\"type\":\"street\",\"value\":\"Calle Zemoriya\",\"slug\":\"calle-zemoriya\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20001\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"a