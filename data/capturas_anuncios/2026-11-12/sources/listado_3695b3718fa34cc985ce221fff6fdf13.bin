ule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/363d48b9-da26-4e16-9cad-f8ae3cfa944f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6d448c34-738c-4553-b862-b9b8e5a7907b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/06eba540-7d59-4016-bbb4-81e4e1f0f650?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/4fe2c704-35a9-4b88-9c8f-f0e327669029?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/e8f87cc8-eda8-493d-b53a-1f6aa48e195e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d338ec99-065a-4222-9feb-03469c0a3389?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/18a32690-ca07-4ec2-acfc-080c0399ffed?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/90e224ce-9c9a-4113-8d80-be7af0161897?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/8cb3fbd8-f3df-4dae-8a66-747ddb4e1cb0?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ae20cdc7-0269-450d-9532-13c33f2de27a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/dddb6bf3-915c-4757-8400-00d19bd0e5b4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/5248c101-d724-44a7-8bc8-23b12891f45a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/39ff9a94-b34c-4223-a4af-4562cdd8eb31?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d53f17cc-232a-4113-829f-9e802696c35e?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f7dc5bb4-dff6-4bd6-b1c7-8e2dee47ec25?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b8656fea-8e43-4877-90a5-fc47aad383a4?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":29,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"4bb9bb7c-ce92-4cfa-ab5f-1e820a308820\",\"name\":\"ASESORIA JURIDICA Y AGENCIA INMOBILIARIA NUEVO GROS SL\",\"tradeName\":\"NUEVO GROS INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/9202755625017/439961.jpg?rule=original\",\"website\":\"www.https://www.inmonuevogros.com\",\"navigationUrl\":\"/inmobiliaria/nuevo-gros-inmobiliaria/\",\"legacyPublisherId\":\"31357\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"435\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-30T11:25:29.0273130+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":2,\"bathrooms\":1,\"builtSurface\":55,\"landArea\":null,\"constructionYear\":1973,\"terrace\":{\"surface\":10,\"has\":true},\"floor\":\"SIXTH\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"WARDROBES\",\"EQUIPPED_KITCHEN\",\"OFFICE_KITCHEN\"],\"hasNot\":[]},\"orientation\":\"SOUTH\",\"heating\":\"NON_SPECIFIED\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":192},\"emissions\":{\"label\":\"E\",\"value\":40}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"HAS_VIEW_TO_BEACH\",\"IS_EXTERIOR\",\"IS_ON_SEAFRONT\",\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1700,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1700,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3586@inmoweb.email\",\"phone\":\"+34943293029\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/segundo-izpizua-kalea/gros/donostia-san-sebastian/ca3fa072-bfb9-42f3-ab5d-a517ff576520/d\",\"feature\":null,\"short\":\"/a/ca3fa072-bfb9-42f3-ab5d-a517ff576520\"}},{\"id\":\"28f44321-4f0b-467a-98ff-20d45f88ccdb\",\"reference\":\"26101\",\"legacyNumericId\":\"29796000012883\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/centro/donostia-san-sebastian/28f44321-4f0b-467a-98ff-20d45f88ccdb/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/centro/s\",\"summary\":{\"title\":\"ALQUILER NO DESTINADO A VIVIENDA HABITUAL EN DONOSTIA CENTRO\",\"description\":\"ALQUILER VIVIENDA - DONOSTIA - CENTRO - CALLE PRIM\\r\\n\\r\\nARRENDAMIENTO NO DESTINADO A VIVIENDA HABITUAL sino para su uso espor\u00E1dico como segunda residencia, la parte arrendataria no podr\u00E1 empadronarse en la vivienda y deber\u00E1 acreditar su domicilio habitual.\\r\\n\\r\\nEspectacular piso EXTERIOR y LUMINOSO de 98 m2 \u00FAtiles (seg\u00FAn catastro) con DOS BALCONES y VISTAS DESPEJADAS AL R\u00CDO URUMEA, ubicado en el centro de San Sebasti\u00E1n. \\r\\n\\r\\nSe trata de una vivienda en edificio de piedra arenisca construido en el a\u00F1o 1.915, de estilo rom\u00E1ntico (\u00E9poca de esplendor en las construcciones de la zona) y rodeado de espectaculares jardines, con unas vistas maravillosas.\\r\\n\\r\\nSe distribuye en HALL de entrada, SAL\u00D3N, COCINA REFORMADA TOTALMENTE en 2.026 y completamente equipada, DOS DORMITORIOS DOBLES con salida a BALC\u00D3N, uno de ellos con vestidor, armarios empotrados y BA\u00D1O incorporado, y el otro con vestidor y armarios empotrados, (orientaci\u00F3n ESTE) y un segundo BA\u00D1O comunitario.\\r\\n\\r\\nLa vivienda destaca por su amplitud de almacenaje, su excelente luminosidad y su agradable ventilaci\u00F3n natural, lo que la convierte en un hogar especialmente c\u00F3modo y acogedor.\\r\\n\\r\\nSe encuentra en muy buen estado de conservaci\u00F3n y dispone de calefacci\u00F3n y agua caliente mediante sistema el\u00E9ctrico. Adem\u00E1s, cuenta con ventanas de PVC oscilobatientes de reciente instalaci\u00F3n, que proporcionan un excelente aislamiento t\u00E9rmico y ac\u00FAstico.\\r\\n\\r\\nCabe destacar su excelente ubicaci\u00F3n en pleno centro de Donostia, con todos los servicios al alcance de la mano: transporte p\u00FAblico, comercios, supermercados, restaurantes y zonas de ocio. Una localizaci\u00F3n privilegiada que permite disfrutar de la comodidad de tener todo cerca y del inconfundible ambiente donostiarra, sin necesidad de utilizar el veh\u00EDculo.\\r\\n\\r\\nCONDICIONES: se solicitar\u00E1n dos meses de fianza y garant\u00EDa adicional a consensuar. Los honorarios de intermediaci\u00F3n inmobiliaria ser\u00E1n a cargo de la parte arrendataria.\\r\\n\\r\\nEn GRUPO MOLDATU HOME te ayudamos a obtener una HIPOTECA, pues tratamos con varias entidades financieras. Asimismo, puedes VALORAR tu vivienda en venta en nuestra web, en la pesta\u00F1a VALORA TU VIVIENDA.\\r\\n\\r\\nSi deseas m\u00E1s informaci\u00F3n, puedes visitar nuestras oficinas en:\\r\\n- IR\u00DAN - Calle Cipriano Larra\u00F1aga 4-6, bajo\\r\\n- SAN SEBASTI\u00C1N - Calle Prim 6, bajo\\r\\n- BILBAO - Alameda de Recalde 37, bajo (entrada desde Calle del Licenciado Poza)\\r\\n\\r\\nPRIMER GRUPO INMOBILIARIO DEL PAIS VASCO [IW]\",\"location\":{\"visibility\":\"ZONE\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Centro\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"PRIM\",\"streetNumber\":\"51\"},\"coordinates\":{\"latitude\":43.31478048763385,\"longitude\":-1.9798904178612702},\"displayAddressLine\":null,\"displayZoneLine\":\"Centro, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"\u00C1rea Rom\u00E1ntica\",\"slug\":\"area-romantica\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Centro\",\"slug\":\"centro\"},{\"type\":\"street\",\"value\":\"Plaza Centenario L\",\"slug\":\"plaza-centenario-l\"},{\"type\":\"street\",\"value\":\"Calle Pedro Ega\u00F1a\",\"slug\":\"calle-pedro-egana\"},{\"type\":\"street\",\"value\":\"Calle Reyes Catolicos\",\"slug\":\"calle-reyes-catolicos\"},{\"type\":\"street\",\"value\":\"Paseo Arbol  Gernika\",\"slug\":\"paseo-arbol-gernika\"},{\"type\":\"street\",\"value\":\"Calle Urbieta\",\"slug\":\"calle-urbieta\"},{\"type\":\"street\",\"value\":\"Calle Prim\",\"slug\":\"calle-prim\"},{\"type\":\"street\",\"value\":\"Calle Moraza\",\"slug\":\"calle-moraza\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20006\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"20\"},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2045\"},{\"level\":\"neighbourhood\",\"code\":\"843\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6f77edbd-6bc7-4a49-9953-38cfb1ea3678?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d46b25c7-cad7-4049-9258-b15f0ae2816d?rule=original\",\"position\":n