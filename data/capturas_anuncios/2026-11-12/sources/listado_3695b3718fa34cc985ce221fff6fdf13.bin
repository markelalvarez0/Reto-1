/images/ads/a21f4d13-e915-4dc8-b955-9e73eff24cd8?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/23547155-3506-452c-adf6-79d9b6f087c4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b91b19c3-fdb3-46a0-aa99-4128eef84b9c?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/491d111d-de5d-4d6e-ad63-df2afff4ac93?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/8264a2e5-c6b0-4951-8e4f-f8d054718d69?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/92df88e9-9018-46db-b551-2ee545955210?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":43,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"35dae9dd-c09b-458e-b7d6-7dba295658c8\",\"name\":\"RIVAS&BLASCO\",\"tradeName\":\"RIVAS & BLASCO\",\"logo\":\"https://static.fotocasa.es/images/client/9202761585357/631591.jpg?rule=original\",\"website\":null,\"navigationUrl\":\"/inmobiliaria/rivas-blasco/\",\"legacyPublisherId\":\"31369\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":\"premium\",\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-21T17:56:18.9494776+02:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"apartment\",\"status\":\"PRETTY_GOOD\",\"rooms\":2,\"bathrooms\":2,\"builtSurface\":86,\"landArea\":null,\"constructionYear\":2006,\"floor\":\"SECOND\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"AIR_CONDITIONER\",\"WARDROBES\",\"EQUIPPED_KITCHEN\",\"DRYER\"],\"hasNot\":[]},\"orientation\":\"WEST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":192},\"emissions\":{\"label\":\"E\",\"value\":33}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":2000,\"currency\":null,\"hidden\":false,\"priceDrop\":{\"reductionAmount\":300},\"priceRaise\":null},\"trackingPrice\":2000,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3136@inmoweb.email\",\"phone\":\"+34943476009\"},\"urls\":{\"canonical\":\"/alquiler/apartamento/gros/donostia-san-sebastian/c1b2eae8-dcd7-411d-8f19-5251de49875d/d\",\"feature\":null,\"short\":\"/a/c1b2eae8-dcd7-411d-8f19-5251de49875d\"}},{\"id\":\"4b92a7c9-b88b-492c-8731-42b6b0948160\",\"reference\":\"4254 - ARROKA  2026/2027\",\"legacyNumericId\":\"60080000000003\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/arroka-kalea/centro/donostia-san-sebastian/4b92a7c9-b88b-492c-8731-42b6b0948160/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/centro/s\",\"summary\":{\"title\":\"REF. 4554 - ARROKA KL.  2026/2027 CURSO\",\"description\":\"*** CURSO 2026/2027 ***\\n\\n                               16 de SEPTIEMBRE 2026 - 30 de JUNIO DE 2027.\\n\\n                                                 VERANO NO DISPONIBLE\\n                                                 NO LARGA ESTANCIA\\n\\n                 ***EXCLUSIVO ESTUDIANTES UNIVERSITARIOS *** S\u00CD, ya se puede VISITAR!\\n\\n                               NO disponible para larga estancia. NO disponible verano.\\n                               NO LLAMAR para consultar esta cuesti\u00F3n, por favor.\\n\\n\\nIDEAL ESTUDIANTES DEUSTO, COCINA BASQUE CULINARY CENTER, ENFERMERIA, E. H. U.\\n\\nAlquiler exclusivamente para estudiantes universitarios desplazados a Donostia-San Sebasti\u00E1n para Curso Acad\u00E9mico 2026/2027.\\n\\nESTA CASA PUEDE SER LO QUE BUSCA, en una ubicaci\u00F3n inmejorable. \u00C1REA TRANQUILA, EN PLENO CENTRO CIUDAD.\\nTodo tipo de servicios y transporte a un paso. Cerca de las \u00E1reas de ocio, teatros y cines, playas. Ideal para estudiar y descansar y adem\u00E1s en una excelente ubicaci\u00F3n para acudir a cualquier centro de estudios.\\n\\nJunto a la Plaza Easo, y a un paso de la Catedral del Buen Pastor.\\nLa playa de La Concha tambi\u00E9n queda a unos 5 minutos a pie.\\n\\nDistribuci\u00F3n:\\nDispone de 3 dormitorios (1 con cama de matrimonio, otro con doble, y otro individual), sala de estar, cocina-comedor separada, y 2 ba\u00F1os de tres piezas (ducha, inodoro y lavabo.\\n\\nServicios individuales. La casa dispone de caldera para agua caliente (gas natural). Calefacci\u00F3n individual; Suelos de madera maciza.\\nDormitorio principal exterior hacia plaza Arroka.\\n\\nRenta, \u20AC1.350, 00. -/mes, m\u00E1s facturas por suministro de servicios.\\nFianza, la estipulada por Gobierno Vasco, en este caso: 2.242, 00. -\\nHonorarios, \u20AC1.530, 00. - m\u00E1s IVA del 21%\\nNO se admiten animales/mascotas.\\n\\n*** De acuerdo con la normativa de transparencia -Ley 10/2025 y Ley 12/2023 les informamos de los siguientes datos:\\n1. - El propietario-arrendador NO tiene la condici\u00F3n de gran tenedor,\\n2. - La propiedad se encuentra en una zona de mercado tensionado,\\n3. - El importe de la renta NO est\u00E1 sujeta a limitaciones de precio al no tener un destino de vivienda habitual, conforme a lo estipulado por el MINISTERIO DE VIVIENDA Y AGENDA URBANA, y conforme a la legislaci\u00F3n actual.\\n4. - El arrendador se hace cargo del I. B. I. y de los gastos de comunidad.\\n5. - Es por cuenta del inquilino arrendatario las facturas resultante de los gastos de consumo en los que incurra, tales como electricidad, gas y Agua+Saneamiento+Basuras.\\n\\nTOC, TOC! gesti\u00F3n inmobiliaria queda a su disposici\u00F3n para ampliar cualquier informaci\u00F3n adicional que precisen.\\n\\nPropiedad gestionada por TOC, TOC! gesti\u00F3n inmobiliaria - higiezin kudeaketa.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Centro\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Arroka Kalea\",\"streetNumber\":\"3\"},\"coordinates\":{\"latitude\":43.314056295760565,\"longitude\":-1.9826592151678142},\"displayAddressLine\":\"Arroka Kalea\",\"displayZoneLine\":\"Centro, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"Amara Zaharra - Arbaizenea\",\"slug\":\"amara-zaharra-arbaizenea\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Centro\",\"slug\":\"centro\"},{\"type\":\"street\",\"value\":\"Calle Fuente  la Salud\",\"slug\":\"calle-fuente-la-salud\"},{\"type\":\"street\",\"value\":\"Calle Moraza\",\"slug\":\"calle-moraza\"},{\"type\":\"street\",\"value\":\"Plaza de Easo\",\"slug\":\"plaza-de-easo\"},{\"type\":\"street\",\"value\":\"Calle Lizarra / Estella\",\"slug\":\"calle-lizarra-estella\"},{\"type\":\"street\",\"value\":\"Calle Amara\",\"slug\":\"calle-amara\"},{\"type\":\"street\",\"value\":\"Calle Arroka\",\"slug\":\"calle-arroka\"},{\"type\":\"street\",\"value\":\"Calle Autonomia\",\"slug\":\"calle-autonomia\"},{\"type\":\"street\",\"value\":\"Calle Larramendi\",\"slug\":\"calle-larramendi\"},{\"type\":\"street\",\"value\":\"Plaza de Arroka\",\"slug\":\"plaza-de-arroka\"},{\"type\":\"street\",\"value\":\"Calle Easo\",\"slug\":\"calle-easo\"},{\"type\":\"street\",\"value\":\"Calle Alto  Ama