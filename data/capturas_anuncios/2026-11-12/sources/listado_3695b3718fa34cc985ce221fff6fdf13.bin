ia-invalid="false" aria-label="habitaclia en tu idioma"><span data-panot-component="select-value" style="pointer-events:none"></span><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" data-title="chevron_down" fill="currentColor" stroke="none" class="shrink-0 text-current u-current-font-size" aria-hidden="true" focusable="false" data-panot-component="icon" data-testid="select-trigger-icon"><path d="M12 17.4944C11.6183 17.4944 11.2366 17.3482 10.9459 17.0574L2 8.10887L4.10825 6L12 13.8941L19.8918 6L22 8.10887L13.0541 17.0574C12.7634 17.3482 12.3817 17.4944 12 17.4944" fill-rule="nonzero"/></svg></button><select aria-hidden="true" tabindex="-1" name="footer-language-selector" style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal"></select></div></div></div></div></div></div></footer></div></div><script>window.__PERFORMANCE_METRICS__ = JSON.parse("{}");</script><script>window.__APP_CONFIG__ = JSON.parse("{\"hostname\":\"www.habitaclia.com\"}");</script><script>window.__INITIAL_PROPS__ = JSON.parse("{\"initialSearchResultsPage\":{\"status\":\"success\",\"initialSearchContext\":{\"searchType\":\"standard\",\"viewMode\":\"list\",\"geography\":{\"code\":\"20069\",\"locationIds\":\"724,18,20,426,826,20069,0,0,0\",\"layerId\":20,\"layer\":\"municipality\",\"name\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\",\"latitude\":43.3183,\"longitude\":-1.98059,\"parentSlug\":\"gipuzkoa-provincia\"},\"filters\":{\"transactionType\":\"rent\",\"propertyType\":\"home\",\"minPrice\":null,\"maxPrice\":null,\"minSurface\":null,\"maxSurface\":null,\"minRooms\":null,\"minBathrooms\":null,\"features\":[],\"isPrivate\":null,\"isTypology\":null,\"isBank\":null,\"propertySubtype\":[]},\"sortBy\":\"RELEVANCE\",\"semanticFilterSlug\":null,\"urls\":{\"list\":\"/alquiler/viviendas/gipuzkoa-provincia/donostia-san-sebastian/s\",\"map\":\"/alquiler/viviendas/gipuzkoa-provincia/donostia-san-sebastian/sm\"},\"results\":{\"items\":[{\"id\":\"0cd9ef3c-42ee-4c0f-a11e-4964cc7ed65a\",\"reference\":\"R&B - 010103\",\"legacyNumericId\":\"31369000000029\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/apartamento/san-juan/parte-vieja/donostia-san-sebastian/0cd9ef3c-42ee-4c0f-a11e-4964cc7ed65a/d\",\"listingNavigationUrl\":\"/alquiler/apartamentos/gipuzkoa-provincia/donostia-san-sebastian/parte-vieja/s\",\"summary\":{\"title\":null,\"description\":\"Apartamento reci\u00E9n reformado por reconocido decorador con vistas al mar Cant\u00E1brico, Kursaal y Playa de la Zurriola. La Vivienda est\u00E1 situada a los p\u00EDes del Monte Urgull y Frente al Museo San Telmo, una ubicaci\u00F3n magn\u00EDfica para disfrutar con tranquilidad de la ciudad.\\r\\n\\r\\nSe distribuye en: sal\u00F3n-comedor con cocina americana y acceso directo a una de las 2 terrazas con espectaculares vistas al mar, asimismo, el dormitorio, tambi\u00E9n con acceso directo a otra terraza frontal con vistas al mar, incluye vestidor y ba\u00F1o con ventilaci\u00F3n natural. Adem\u00E1s la vivienda cuenta con un aseo de cortes\u00EDa con ventilaci\u00F3n natural, junto al hall de entrada.\\r\\n\\r\\nIMPORTANTE-\\r\\n- Alquiler MENSUAL \\r\\n- Incluye ropa de cama y toallas, cocina equipada, WiFi, TV...\\r\\n- Suministros incluidos hasta 150\u20AC/mes (electricidad, gas y agua)\\r\\n- Fianza: 1 mensualidad\\r\\n\\r\\nRENTAS-\\r\\n- Temporada baja: desde 2.300\u20AC / mes\\r\\n- Temporada verano (junio a septiembre): desde 3.800\u20AC / mes\\r\\n\\r\\nRivas & Blasco\\r\\nSan Mart\u00EDn 62 [IW]\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Parte Vieja\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"san juan\",\"streetNumber\":\"14\"},\"coordinates\":{\"latitude\":43.325803790325075,\"longitude\":-1.9846692241026176},\"displayAddressLine\":\"san juan\",\"displayZoneLine\