sherId\":\"34809\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[],\"updatedAt\":\"2026-11-12T08:40:15.2039867+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":1,\"builtSurface\":80,\"landArea\":null,\"floor\":\"THIRD\",\"features\":{\"has\":[\"ELEVATOR\",\"WARDROBES\",\"FURNISHED\",\"MICROWAVE\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"],\"hasNot\":[\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"BALCONY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\"]},\"orientation\":\"WEST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"F\",\"value\":274},\"emissions\":{\"label\":\"E\",\"value\":57}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"FOR_STUDENTS\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1400,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1400,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"info@aldatz.com\",\"phone\":\"+34943218080\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/antiguo/donostia-san-sebastian/85ccaf2f-e7e7-44be-8483-cb1721e8fd64/d\",\"feature\":null,\"short\":\"/a/85ccaf2f-e7e7-44be-8483-cb1721e8fd64\"}},{\"id\":\"de4b372a-532f-41ba-9652-67f048bf6036\",\"reference\":\"Ga2397\",\"legacyNumericId\":\"31357000000761\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/txalupagillene/antiguo/donostia-san-sebastian/de4b372a-532f-41ba-9652-67f048bf6036/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/antiguo/s\",\"summary\":{\"title\":null,\"description\":\"ARRENDAMIENTO DE TEMPORADA. En EL ANTIGUO, se alquila apartamento de 55 m2 \u00FAtiles. MUY CERCA DE LA PLAYA DE ONDARRETA. La vivienda consta sala-comedor, EXTERIOR a calle Matia; cocina totalmente equipada (frigor\u00EDfico-congelador, horno, extractor, microondas, lavadora, caldera,...); ba\u00F1o con ducha y 1 habitaci\u00F3n con armario empotrado.\\r\\nLa vivienda dispone de una TERRAZA COMUNITARIA en cubierta con unas bonitas vistas de la ciudad. Muy bien SITUADO y COMUNICADO. Muy cerca dispone de todos los servicios (parada de autob\u00FAs, comercios, farmacia,..).\\r\\n\\r\\nAgencia inmobiliaria y asesor\u00EDa jur\u00EDdica nuevo gros es una agencia inmobiliaria con m\u00E1s de 35 a\u00F1os de experiencia, que cuenta con agentes de la propiedad inmobiliaria y abogados expertos en derecho inmobiliario, para el asesoramiento de nuestros clientes en la compra-venta y alquiler de fincas. Para cualquier consulta no dude en llamarnos [IW]\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Antiguo\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Txalupagillene\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":43.312903250851484,\"longitude\":-2.0031370503468224},\"displayAddressLine\":\"Txalupagillene\",\"displayZoneLine\":\"Antiguo, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Antiguo\",\"slug\":\"antiguo\"},{\"type\":\"street\",\"value\":\"Avenida de Zumalakarreg\",\"slug\":\"avenida-de-zumalakarreg\"},{\"type\":\"street\",\"value\":\"Calle Aizkorri\",\"slug\":\"calle-aizkorri\"},{\"type\":\"street\",\"value\":\"Calle Ondarbide\",\"slug\":\"calle-ondarbide\"},{\"type\":\"street\",\"value\":\"Calle Pamplona\",\"slug\":\"calle-pamplona\"},{\"type\":\"street\",\"value\":\"Calle Infanta Beatriz\",\"slug\":\"calle-infanta-beatriz\"},{\"type\":\"street\",\"value\":\"Calle Matia\",\"slug\":\"calle-matia\"},{\"type\":\"street\",\"value\":\"Calle Maestro Guridi\",\"slug\":\"calle-maestro-guridi\"},{\"type\":\"street\",\"value\":\"Plaza Txalupagillene\",\"slug\":\"plaza-txalupagillene\"},{\"type\":\"street\",\"value\":\"Plaza de Adarra\",\"slug\":\"plaza-de-adarra\"},{\"type\":\"street\",\"value\":\"Plaza de Gascu\u00F1a\",\"slug\":\"plaza-de-gascuna\"},{\"type\":\"street\",\"value\":\"Calle Juan  Garai\",\"slug\":\"calle-juan-garai\"},{\"type\":\"street\",\"value\":\"Calle Sansustenea\",\"slug\":\"calle-sansustenea\"},{\"type\":\"street\",\"value\":\"Calle Munibe\",\"slug\":\"calle-munibe\"},{\"type\":\"street\",\"value\":\"Calle Serrano Anguita\",\"slug\":\"calle-serrano-anguita\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20008\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"20\"},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2047\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/1f17704f-a7eb-4473-bd80-3dcfce81c237?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f03c1d26-a803-427c-987f-7f3c5a8bf7fe?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d