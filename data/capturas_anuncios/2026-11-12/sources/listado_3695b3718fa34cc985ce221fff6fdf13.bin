.fotocasa.es/images/ads/3ebd8f77-9b07-44fb-9566-091aec7cffbd?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/7b16863c-0669-4c88-992c-28f7dc7b8e24?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b0656a91-60e6-4c75-82e1-b0e9acabe673?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/9a9c3867-5408-4661-b003-91b94829e949?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/abf487a1-c796-44a1-bfa2-9f0d170c6f8d?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":22,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"4bb9bb7c-ce92-4cfa-ab5f-1e820a308820\",\"name\":\"ASESORIA JURIDICA Y AGENCIA INMOBILIARIA NUEVO GROS SL\",\"tradeName\":\"NUEVO GROS INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/9202755625017/439961.jpg?rule=original\",\"website\":\"www.https://www.inmonuevogros.com\",\"navigationUrl\":\"/inmobiliaria/nuevo-gros-inmobiliaria/\",\"legacyPublisherId\":\"31357\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"435\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-04T16:12:05.7941138+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":1,\"bathrooms\":1,\"builtSurface\":60,\"landArea\":null,\"constructionYear\":1995,\"floor\":\"FOURTH\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"WARDROBES\",\"EQUIPPED_KITCHEN\"],\"hasNot\":[]},\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":132},\"emissions\":{\"label\":\"D\",\"value\":28}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1100,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1100,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3586@inmoweb.email\",\"phone\":\"+34943293029\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/txalupagillene/antiguo/donostia-san-sebastian/de4b372a-532f-41ba-9652-67f048bf6036/d\",\"feature\":null,\"short\":\"/a/de4b372a-532f-41ba-9652-67f048bf6036\"}},{\"id\":\"6b56972f-4e9d-463d-8b5d-bd97d8d58d46\",\"reference\":\"Ga2408\",\"legacyNumericId\":\"31357000000798\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/urdaneta/centro/donostia-san-sebastian/6b56972f-4e9d-463d-8b5d-bd97d8d58d46/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/centro/s\",\"summary\":{\"title\":null,\"description\":\"En el CENTRO de Donostia, se alquila  PISO POR TEMPORADA ( de Octubre a Junio). La vivienda es de 65 m2 y consta de sala distribuidora, 3 habitaciones con cama individual, cocina equipada y 1 ba\u00F1o con ducha.  La vivienda da a patio. \\nEl inmueble dispone de ASCENSOR a cota 0. Sin barreras arquitect\u00F3nicas.\\n\\nMUY BIEN SITUADO y COMUNICADO. MUY CERCA DE LA PLAYA DE LA ZURRIOLA. En sus inmediaciones nos encontramos con servicios de todo tipo (supermercado, farmacia. ), as\u00ED como paradas de autob\u00FAs.\\n\\nGarant\u00EDas: 1 Mes Fianza + 2 Meses Dep\u00F3sito.\\nAs\u00ED mismo, habr\u00E1 que abonar los honorarios de la agencia.\\n\\nAGENCIA INMOBILIARIA y ASESOR\u00CDA JUR\u00CDDICA NUEVO GROS es una agencia inmobiliaria con m\u00E1s de 35 a\u00F1os de experiencia, que cuenta con Agentes de la Propiedad Inmobiliaria y Abogados EXPERTOS EN DERECHO INMOBILIARIO, para el asesoramiento de nuestros clientes en la COMPRA-VENTA y ALQUILER de fincas. Para cualquier consulta no dude en llamarnos [IW]. [IW]\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Centro\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Urdaneta\",\"streetNumber\":\"16\"},\"coordinates\":{\"latitude\":43.31628609942455,\"longitude\":-1.983649374791412},\"displayAddressLine\":\"Urdaneta\",\"displayZoneLine\":\"Centro, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"neighbourhood\",\"value\":\"\u00C1rea Rom\u00E1ntica\",\"slug\":\"area-romantica\"},{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Centro\",\"slug\":\"centro\"},{\"type\":\"street\",\"value\":\"Calzada de Aldapeta\",\"slug\":\"calzada-de-aldapeta\"},{\"type\":\"street\",\"value\":\"Calle Alto San Bartolome\",\"slug\":\"calle-alto-san-bartolome\"},{\"type\":\"street\",\"value\":\"Calle Arrasate\",\"slug\":\"calle-arrasate\"},{\"type\":\"street\",\"value\":\"Plaza de Easo\",\"slug\":\"plaza-de-easo\"},{\"type\":\"street\",\"value\":\"Calle Manterola\",\"slug\":\"calle-manterola\"},{\"type\":\"street\",\"value\":\"Calle San Martin\",\"slug\":\"calle-san-martin\"},{\"type\":\"street\",\"value\":\"Calle San Bartolome\",\"slug\":\"calle-san-bartolome\"},{\"type\":\"street\",\"value\":\"Calle Triunfo\",\"slug\":\"calle-triunfo\"},{\"type\":\"street\",\"value\":\"Calle Urdaneta\",\"slug\":\"calle-urdaneta\"},{\"type\":\"street\",\"value\":\"Calle Eas