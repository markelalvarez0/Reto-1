":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/4035a9af-bb99-4457-a672-22d41c03ea09?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2d4553d0-63ad-4f79-aa18-068293ee22b7?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2e684441-9a46-41ad-bdf7-3a974a7ac74f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/872d75df-0519-4474-84bc-6934104af3d0?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b0e5416c-62e5-472c-974e-3880900aba31?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/598b7906-8989-45f1-ad0c-43c7b3d642d0?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6a832e9a-c8f4-42da-81b1-8142cd27070f?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6a3f5527-6fd6-4e4c-b274-db609a3cacb4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/2f9fbea2-216e-4e87-b08a-8ee7c58abb70?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/1f1b99b4-ccb3-47dd-8c73-7fa1ae619b0a?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c9b634bf-6d07-4d7b-a25b-09d8fda2d3cc?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/58dd87e0-e21f-4729-a9fa-a3f2fc62693d?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/280b3662-1d74-403b-8b92-dd5629e006cc?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/41a7549b-d030-4998-8477-bb7b8c2bafde?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":25,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"4bb9bb7c-ce92-4cfa-ab5f-1e820a308820\",\"name\":\"ASESORIA JURIDICA Y AGENCIA INMOBILIARIA NUEVO GROS SL\",\"tradeName\":\"NUEVO GROS INMOBILIARIA\",\"logo\":\"https://static.fotocasa.es/images/client/9202755625017/439961.jpg?rule=original\",\"website\":\"www.https://www.inmonuevogros.com\",\"navigationUrl\":\"/inmobiliaria/nuevo-gros-inmobiliaria/\",\"legacyPublisherId\":\"31357\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"435\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-11-02T21:49:28.1617144+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":3,\"bathrooms\":1,\"builtSurface\":70,\"landArea\":null,\"constructionYear\":1905,\"floor\":\"FOURTH\",\"features\":{\"has\":[\"ELEVATOR\",\"EQUIPPED_KITCHEN\"],\"hasNot\":[]},\"heating\":\"NON_SPECIFIED\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":245},\"emissions\":{\"label\":\"E\",\"value\":48}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_ADAPTED_FOR_WHEELCHAIR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":1500,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":1500,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3586@inmoweb.email\",\"phone\":\"+34943293029\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/urdaneta/centro/donostia-san-sebastian/6b56972f-4e9d-463d-8b5d-bd97d8d58d46/d\",\"feature\":null,\"short\":\"/a/6b56972f-4e9d-463d-8b5d-bd97d8d58d46\"}},{\"id\":\"9c20697a-7b64-41de-a1da-46be81bb461e\",\"reference\":\"Paseo De Francia\",\"legacyNumericId\":\"29703000000420\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/frantzia-pasealekua-1/gros/donostia-san-sebastian/9c20697a-7b64-41de-a1da-46be81bb461e/d\",\"listingNavigationUrl\":null,\"summary\":{\"title\":\"Paseo de Francia\",\"description\":\"ALQUILER TEMPORAL DE ENERO A JUNIO DEL 2027 de esta maravillosa vivienda de 93m2 \u00FAtiles, ubicada al comienzo del emblem\u00E1tico Paseo de Francia, en el coraz\u00F3n de Gros.\\n\\nLa propiedad consta de tres acogedoras habitaciones, lo que la convierte en un hogar ideal, c\u00F3modo y espacioso. La habitaci\u00F3n principal es doble y cuenta con un vestidor y un ba\u00F1o en suite, la segunda habitaci\u00F3n, tambi\u00E9n doble, y una tercera habitaci\u00F3n simple, para adaptarse a diversas necesidades, ya sea como dormitorios, o espacios de trabajo, el sal\u00F3n-cocina-comedor es un espacio luminoso con un gran mirador con vistas al rio Urumea, la cocina est\u00E1 totalmente equipada y dispone de otro ba\u00F1o adicional.\\n\\nEl edificio dispone de ascensor con rampa salvaescaleras.\\n\\nUbicado en un sitio \u00FAnico, en el barrio de Gros, pero a 2 minutos andando del centro de la ciudad, de las playas tanto de la Concha como de la Zurriola y bien comunicado con el resto de los barrios.\\n\\n\\nCONDICIONES DEL ALQUILER: No se admiten mascotas ni fumadores. Ingresos desmostrables. Las fianzas ser\u00E1n, una como garant\u00EDa adicional para la parte arrendadora y la parte proporcional de los meses de alquiler para el Gobierno Vasco. Los honorarios de la inmobiliaria ser\u00E1n a cargo de la parte arrendataria.\",\"location\":{\"visibility\":\"EXACT\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Gros\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Frantzia Pasealekua\",\"streetNumber\":\"1\"},\"coordinates\":{\"latitude\":43.3213843,\"longitude\":-1.9768279},\"displayAddressLine\":\"Frantzia Pasealekua 1\",\"displayZoneLine\":\"Gros, Donostia - San Sebasti\u00E1n\",\"layers\":[],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20001\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"20\"},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2048\"}]},\"multimedia\":{\"images\":[{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/f3e1da23-6631-46f7-94c2-3bdf8d6e9f92?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/902d4e7f-f458-4691-b192-92aeb077e43b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/10c170dc-56cd-43da-bb5a-765c694abf67?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6b5740ab-69a8-4d10-a148-91c9dd1c686b?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/4c0782f2-7ffc-4d1b-b260-71ce303ae072?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/abdf49b9-6457-4ba7-9e74-c57504181aa4?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b76ba60b-9e9d-4b36-9693-3aba1b444b28?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/bb318655-77ae-4fdc-adbb-658426424720?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/11f07952-fa75-4274-9460-5a7e36914359?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c68b25dd-1137-4dd1-a26a-a4062c93689d?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/c3536bc0-b93a-4901-849b-d2c231539984?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ef3a76c9-ca50-469c-8020-42573c240890?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/d90ffdad-18e2-4d5e-ac70-2fade567ee77?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/b4805a0a-387e-4e2d-adc0-34d02b067051?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/67068c1b-cc55-471c-a3d4-404a7101cda5?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/4a87aa95-57e3-40a6-9db2-d2d1c225d081?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/986e997a-3c71-488f-9837-8897ae6b6c37?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/44ab8497-22f1-4bb1-95cc-e5aebbd7f9fb?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/6b5206e0-beee-437d-b45c-24f3defcc4c2?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/bf75656a-db15-4839-978f-2f472e16bd7d?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/415ae08f-b707-4160-8c93-b424fe202e20?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/eae1402a-db68-4ba1-9856-dd43322f4896?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/79bf965f-ade7-4ff1-99d2-1d63aee3ae60?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/cbd4a6a9-c332-4367-9db8-20eb25049305?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/ccd2417a-034f-4980-a49b-96bb22740212?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":25,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"80cea632-8f1a-4f3f-be1d-c3d00330973b\",\"name\":\"PROMOCIONES Y CONSTRUCCIONES LANBORE SL.\",\"tradeName\":\"DON PISO SAN SEBASTIAN CENTRO\",\"logo\":\"https://static.fotocasa.es/images/client/9202758895309/623367-20200826135559.jpg?rule=original\",\"website\":null,\"navigationUrl\":\"/inmobiliaria/don-piso-san-sebastian-centro/\",\"legacyPublisherId\":\"29703\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-09-16T15:21:38.1925473+02:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"PRETTY_GOOD\",\"rooms\":3,\"bathrooms\":2,\"builtSurface\":93,\"landArea\":null,\"constructionYear\":1981,\"floor\":\"SECOND\",\"features\":{\"has\":[\"ELEVATOR\",\"FURNISHED\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"NEARBY_PUBLIC_TRANSPORT\",\"SUITE_BATHROOM\",\"HOME_APPLIANCES\"],\"hasNot\":[\"PETS_ALLOWED\",\"STORAGE_ROOM\",\"PRIVATE_PARKING\",\"PRIVATE_GARDEN\",\"YARD\",\"AIR_CONDITIONER\",\"SECURITY_DOOR\",\"COMMUNITY_POOL\",\"PRIVATE_POOL\",\"FIREPLACE\",\"ALARM\",\"SURVEILLANCE_SYSTEM\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"OFFICE_KITCHEN\",\"DOORMAN\",\"JACUZZI\",\"SAUNA\",\"TENNIS_COURT\",\"GYM\",\"SPORTS_AREA\",\"CHILDREN_AREA\",\"HOME_AUTOMATION\",\"INTERNET\",\"PARQUET\",\"STONEWARE\",\"BALCONY\",\"OVEN\",\"WASHING_MACHINE\",\"DISHWASHER\",\"MICROWAVE\",\"FRIDGE\",\"DRYER\",\"TV\"]},\"heating\":\"NATURAL_GAS\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":242},\"emissions\":{\"label\":\"E\",\"value\":51}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_ADAPTED_FOR_WHEELCHAIR\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":3000,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":3000,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"sansebastiancentro@donpiso.com\",\"phone\":\"+34943229073\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/frantzia-pasealekua-1/gros/donostia-san-sebastian/9c20697a-7b64-41de-a1da-46be81bb461e/d\",\"feature\":null,\"short\":\"/a/9c20697a-7b64-41de-a1da-46be81bb461e\"}},{\"id\":\"9cd996c9-57ca-44ea-bf4c-0fc7c9c6df34\",\"reference\":\"2445129\",\"legacyNumericId\":\"30956000001105\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/donostia-san-sebastian-plaza-txalupagillene/antiguo/donostia-san-sebastian/9cd996c9-57ca-44ea-bf4c-0fc7c9c6df34/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/antiguo/s\",\"summary\":{\"title\":\"VIVIENDA DE TEMPORADA EN LA CALLE MATIA Se alquila vivienda situada en la calle Matia, una de las zonas m\u00E1s comerciales y din\u00E1mica\",\"description\":\"VIVIENDA DE TEMPORADA EN LA CALLE MATIA \\n Se alquila vivienda situada en la calle Matia, una de las zonas m\u00E1s comerciales y din\u00E1micas del barrio del Antiguo, en San Sebasti\u00E1n.\\n Su excelente ubicaci\u00F3n permite disfrutar de todo tipo de servicios a pie de calle, con supermercados, farmacias, bares, estancos y comercios de proximidad a escasos metros, ofreciendo una gran comodidad para el d\u00EDa a d\u00EDa.\\n La vivienda cuenta con una distribuci\u00F3n funcional, con espacios diferenciados para disfrutar de una estancia c\u00F3moda y pr\u00E1ctica.\\n Se distribuye en:\\n Dos habitaciones: una de 14 m\u00B2 y otra de 11 m\u00B2.Sal\u00F3n: 16,5 m\u00B2.Cocina independiente: 7 m\u00B2.Dos ba\u00F1os: uno de 4 m\u00B2 y otro de 3 m\u00B2.Una excelente oportunidad para vivir en una ubicaci\u00F3n privilegiada, con todos los servicios al alcance de la mano y disfrutar del ambiente y la comodidad que ofrece el barrio del Antiguo.\\n  \\n Condiciones: Fianza Legal (1 mensualidad) Fianza adicional ( 1 mensualidad), Honorarios Agencia por cuenta del propietario. No se aceptan mascotas. No esta permitido fumar en la vivienda\\n  \\n NOTA INFORMATIVA:\\n La Vivienda SI se encuentra ubicada en Zona Tensionada (San Sebasti\u00E1n: BOE, el 29 de julio de 2025)\\n El Propietario de la presente vivienda NO es un Gran Tenedor.\\n La RENTA mensual referida en el apartado RENTA, se desglosa en los siguientes conceptos:  Renta mensual 1.333\u0080; \\n La Renta mensual m\u00E1xima aplicable conforme a los \u00EDndices de precios de referencia (SERPAVI) es de 1.333 \u0080.\\n El mobiliario incluido en el arrendamiento y a modo de resumen es el siguiente: Sof\u00E1, mueble TV, 2 camas, 2 mesillas, 2 armarios, cocina totalemente equipada\\n La superficie \u00FAtil conforme a medici\u00F3n reciente realizada es de 72 m2, siendo la superficie construida estimada la de 80 m2. \\n El edificio data del a\u00F1o 1995.\\n Los honorarios de comercializaci\u00F3n y redacci\u00F3n del contrato de arrendamiento ser\u00E1n por cuenta de la parte arrendadora. Los honorarios por otros servicios solicitados por cualquiera de las partes durante la vigencia del arrendamiento podr\u00E1n ser facturados a quien teniendo inter\u00E9s en ellos, los solicitara\u0094\\n Informaci\u00F3n de ACCESIBILIDAD: Acceso cota 0\\n  \\n CERTIFICADO DE EFICIENCIA ENERGETICA. Letra E/ 204 KW / 43,3 O.\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Antiguo\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Donostia-San Sebasti\u00E1n - Plaza Txalupagillene\",\"streetNumber\":\"5\"},\"coordinates\":{\"latitude\":43.3128382977427,\"longitude\":-2.004001279089266},\"displayAddressLine\":\"Donostia-San Sebasti\u00E1n - Plaza Txalupagillene\",\"displayZoneLine\":\"Antiguo, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Antiguo\",\"slug\":\"antiguo\"},{\"type\":\"street\",\"value\":\"Calle Matia\",\"slug\":\"calle-matia\"},{\"type\":\"street\",\"value\":\"Calle Rosario Artola\",\"slug\":\"calle-rosario-artola\"},{\"type\":\"street\",\"value\":\"Calle Juan  Garai\",\"slug\":\"calle-juan-garai\"},{\"type\":\"street\",\"value\":\"Plaza de Bentaberri\",\"slug\":\"plaza-de-bentaberri\"},{\"type\":\"street\",\"value\":\"Calle Sansustenea\",\"slug\":\"calle-sansustenea\"},{\"type\":\"street\",\"value\":\"Calle Munibe\",\"slug\":\"calle-munibe\"},{\"type\":\"street\",\"value\":\"Calle Serrano Anguita\",\"slug\":\"calle-serrano-anguita\"},{\"type\":\"street\",\"value\":\"Calle Infanta Beatriz\",\"slug\":\"calle-infanta-beatriz\"},{\"type\":\"street\",\"value\":\"Calle Aizkorri\",\"slug\":\"calle-aizkorri\"},{\"type\":\"street\",\"value\":\"Plaza Txalupagillene\",\"slug\":\"plaza-txalupagillene\"},{\"type\":\"street\",\"value\":\"Calle Maestro Guridi\",\"slug\":\"calle-maestro-guridi\"},{\"type\":\"street\",\"value\":\"Calle Bentaberri\",\"slug\":\"calle-bentaberri\"},{\"type\":\"street\",\"value\":\"Avenida de Zumalakarreg\",\"slug\":\"avenida-de-zumalakarreg\"},{\"type\":\"street\",\"value\":\"Plaza de Adarra\",\"slug\":\"plaza-de-adarra\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20008\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"2