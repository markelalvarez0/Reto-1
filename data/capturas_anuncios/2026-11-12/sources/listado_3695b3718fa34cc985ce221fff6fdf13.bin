/db31a0dc-67b4-4250-a4fc-cffe9e27ea0d?rule=original\",\"position\":null},{\"type\":null,\"url\":\"https://static.fotocasa.es/images/ads/fa694455-3b71-422b-9f98-97a3ba1c7d43?rule=original\",\"position\":null}],\"videos\":[],\"virtualTours\":[],\"documents\":[],\"counts\":{\"images\":55,\"videos\":0,\"threeD\":0,\"floorPlans\":0}},\"publisher\":{\"id\":\"e4bd625a-1499-4476-a408-c25fa03ed9dc\",\"name\":\"LIGATI SL\",\"tradeName\":\"Araxes Agencia Inmobiliaria\",\"logo\":\"https://static.fotocasa.es/images/client/9202758917444/625209.jpg?rule=original\",\"website\":\"http://www.araxes.es/?utm_medium=fotocasa\",\"navigationUrl\":\"/inmobiliaria/araxes-agencia-inmobiliaria/\",\"legacyPublisherId\":\"30956\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"349\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-10-28T14:28:43.4238576+01:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":null,\"rooms\":2,\"bathrooms\":2,\"builtSurface\":145,\"landArea\":null,\"constructionYear\":2003,\"floor\":\"THIRD\",\"features\":{\"has\":[\"ELEVATOR\",\"STORAGE_ROOM\",\"HOME_APPLIANCES\",\"SECURITY_DOOR\",\"BALCONY\",\"EQUIPPED_KITCHEN\",\"DRYER\"],\"hasNot\":[\"PRIVATE_PARKING\",\"PRIVATE_POOL\",\"FURNISHED\"]},\"orientation\":\"SOUTH_WEST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"data\":{\"consumption\":{\"label\":\"E\",\"value\":212},\"emissions\":{\"label\":\"E\",\"value\":44}},\"status\":\"AVAILABLE\"},\"dynamicFeatures\":[\"IS_MODERN\",\"IS_TEMPORARY\",\"HAS_VIEW_TO_BEACH\",\"IS_ADAPTED_FOR_WHEELCHAIR\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":2674,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":2674,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"iagestion_1407@iagestion.com\",\"phone\":\"+34604557120\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/mari-14-donostia-san-sebastian/parte-vieja/donostia-san-sebastian/cb58ab59-ae8a-476a-bdd2-af0945d9f407/d\",\"feature\":null,\"short\":\"/a/cb58ab59-ae8a-476a-bdd2-af0945d9f407\"}},{\"id\":\"18911d6a-599e-4204-926c-b27d8efb57f6\",\"reference\":\"25200-ALQ\",\"legacyNumericId\":\"29796000012873\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/alto-de-zorroaga/miramon-zorroaga/donostia-san-sebastian/18911d6a-599e-4204-926c-b27d8efb57f6/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/miramon-zorroaga/s\",\"summary\":{\"title\":\"PISO EN URBANIZACI\u00D3N ALTO DE ZORROAGA\",\"description\":\"ALQUILER TEMPORAL - DONOSTIA - ALTO DE ZORROAGA\\r\\n\\r\\nEspectacular EXTERIOR Y LUMINOSO BAJO de 121 m2 \u00FAtiles (seg\u00FAn catastro) con DOS TERRAZAS Y JARD\u00CDN, ubicado en la primera zona del Alto de Zorroaga en exclusiva urbanizaci\u00F3n privada. La vivienda se completa con un AMPLIO GARAJE CERRADO de 20m2 (seg\u00FAn catastro).\\r\\n\\r\\nSe trata de un piso en dos plantas en URBANIZACI\u00D3N PRIVADA construida en el a\u00F1o 2.002 con espectaculares jardines, parking privado y PISCINA COMUNITARIA.\\r\\n\\r\\nLa vivienda se distribuye en DOS PLANTAS comunicadas con escalera muy c\u00F3moda.\\r\\n\\r\\nLa primera planta a ras de suelo de 92 m2 \u00FAtiles, cuenta con GRAN SAL\u00D3N COMEDOR di\u00E1fano con salida a TERRAZA de 55 m2 aproximados, cocina individual totalmente equipada (todo ello orientaci\u00F3n OESTE), dos DORMITORIOS DOBLES con salida a JARDIN de 66 m2 aproximados (orientaci\u00F3n ESTE) y un BA\u00D1O. Una de dichas habitaciones es tipo SUITE (con ba\u00F1o incorporado).\\r\\n\\r\\nLa planta baja de 29 m2 \u00FAtiles m\u00E1s GARAJE CERRADO de 20 m2 \u00FAtiles tiene un DORMITORIO Y un BA\u00D1O, y espacio de ALMACENAJE, y cuenta con una ventana de aireaci\u00F3n.\\r\\n\\r\\nLa vivienda tiene buenas calidades constructivas, y tanto el interior como el exterior se encuentra en perfecto estado. El garaje cerrado tiene acceso peatonal directo a la vivienda.\\r\\n\\r\\nCabe destacar que la urbanizaci\u00F3n cuenta con una ZONA AJARDINADA DE OCIO COMUNITARIA ideal para familias con ni\u00F1os, zona que otorga mucha libertad para que los ni\u00F1os/ j\u00F3venes puedan disfrutar al aire libre sin peligro por su acceso restringido. [IW]\",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Miramon - Zorroaga\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"ALTO DE ZORROAGA\",\"streetNumber\":\"27\"},\"coordinates\":{\"latitude\":43.30227832380056,\"longitude\":-1.9670202650142983},\"displayAddressLine\":\"ALTO DE ZORROAGA\",\"displayZoneLine\":\"Miramon - Zorroaga, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Miramon - Zorroaga\",\"slug\":\"miramon-zorroaga\"},{\"type\":\"street\",\"value\":\"Calle Alto  Zorroaga\",\"slug\":\"calle-alto-zorroaga\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20014\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\