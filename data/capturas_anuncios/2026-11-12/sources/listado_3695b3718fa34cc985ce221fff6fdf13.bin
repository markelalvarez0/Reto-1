},\"publisher\":{\"id\":\"0d7c69b6-013a-406f-9831-8957562bd1bf\",\"name\":\"GRUPO MOLDATU HOME\",\"tradeName\":\"GRUPO MOLDATU HOME\",\"logo\":\"https://static.fotocasa.es/images/client/0d7c69b6-013a-406f-9831-8957562bd1bf/20251023151213?rule=original\",\"website\":\"https://www.moldatuhome.com/\",\"navigationUrl\":\"/inmobiliaria/grupo-moldatu-home/\",\"legacyPublisherId\":\"29796\",\"officeCode\":\"1\",\"isPrivate\":false,\"isAgent\":false,\"officialRegistrations\":[{\"acronym\":\"COAPI\",\"registrationNumber\":\"487\",\"displayName\":\"COAPI - Gipuzkoa\"}]},\"products\":{\"opportunity\":false,\"premium\":false,\"priorityTier\":null,\"leaderModule\":false,\"expressVisit\":false},\"publisherProducts\":[\"LOGO_EN_PARRILLA\",\"MINISITE\",\"SBLR\"],\"updatedAt\":\"2026-08-06T14:27:51.0819031+02:00\"},\"property\":{\"propertyType\":\"flat\",\"propertySubtype\":\"flat\",\"status\":\"GOOD\",\"rooms\":3,\"bathrooms\":3,\"builtSurface\":130,\"landArea\":null,\"constructionYear\":2002,\"terrace\":{\"surface\":60,\"has\":true},\"floor\":\"GROUND_FLOOR\",\"features\":{\"has\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"STORAGE_ROOM\",\"COMMUNITY_POOL\",\"PRIVATE_GARDEN\",\"SECURITY_DOOR\",\"EQUIPPED_KITCHEN\"],\"hasNot\":[]},\"orientation\":\"SOUTH_WEST\",\"heating\":\"NON_SPECIFIED\",\"hotWater\":\"NATURAL_GAS\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\",\"IS_EXTERIOR\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":2000,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":2000,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"w3140@inmoweb.email\",\"phone\":\"+34641483681\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/alto-de-zorroaga/miramon-zorroaga/donostia-san-sebastian/18911d6a-599e-4204-926c-b27d8efb57f6/d\",\"feature\":null,\"short\":\"/a/18911d6a-599e-4204-926c-b27d8efb57f6\"}},{\"id\":\"cb1a9ace-3da3-4e81-a610-19f3854bc6bb\",\"reference\":\"15353655\",\"legacyNumericId\":\"50446000000410\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/antiguo/donostia-san-sebastian/cb1a9ace-3da3-4e81-a610-19f3854bc6bb/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/antiguo/s\",\"summary\":{\"title\":null,\"description\":\"ALQUILER TEMPORAL. DISPONIBLE MES DE JULIO, AGOSTO Y SEPTIEMBRE.\\r\\nVivienda de 52.9 m\u00B2 \u00FAtiles, distribuida en sal\u00F3n, cocina equipada, un dormitorio y un cuarto de ba\u00F1o.\\r\\nLa vivienda cuenta con calefacci\u00F3n individual de gas natural y agua caliente mediante gas natural.\\r\\nPosibilidad de alquilar una raya de garaje en Benta Berri.\\r\\nUbicada en el barrio del Antiguo con todo tipo de servicios y establecimientos a su alrededor, como supermercados, farmacias, restaurantes y comercios. Adem\u00E1s, dispone de paradas de autob\u00FAs muy pr\u00F3ximas y se encuentra a poca distancia de las universidades.\\r\\n\\r\\nSegunda quincena de julio: 1.000\u20AC\\r\\nAgosto: 2.200 \u20AC\\r\\nPrimera quincena de septiembre: 1.000\u20AC\\r\\n\\r\\nLos gastos no est\u00E1n incluidos en el precio.\\r\\nSe exigir\u00E1 la fianza legal y honorarios a cuenta del inquilino seg\u00FAn la duraci\u00F3n del contrato.\",\"location\":{\"visibility\":\"ZONE\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Antiguo\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Matia Kalea\",\"streetNumber\":\"3\"},\"coordinates\":{\"latitude\":43.314865932760405,\"longitude\":-2.000769269638795},\"displayAddressLine\":null,\"displayZoneLine\":\"Antiguo, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Antiguo\",\"slug\":\"antiguo\"},{\"type\":\"street\",\"value\":\"Calle Matia\",\"slug\":\"calle-matia\"},{\"type\":\"street\",\"value\":\"Plaza de Errotatxo\",\"slug\":\"plaza-de-errotatxo\"},{\"type\":\"street\",\"value\":\"Calle Errotatxo\",\"slug\":\"calle-errotatxo\"},{\"type\":\"street\",\"value\":\"Paseo de los Mikeletes\",\"slug\":\"paseo-de-los-mikeletes\"},{\"type\":\"street\",\"value\":\"Plaza de Gascu\u00F1a\",\"slug\":\"plaza-de-gascuna\"},{\"type\":\"street\",\"value\":\"Paseo de Heriz\",\"slug\":\"paseo-de-heriz\"},{\"type\":\"street\",\"value\":\"Plaza de Alfonso XIII\",\"slug\":\"plaza-de-alfonso-xiii\"},{\"type\":\"street\",\"value\":\"Grupo Nuestra Se\u00F1ora  Aranzazu\",\"slug\":\"grupo-nuestra-senora-aranzazu\"},{\"type\":\"street\",\"value\":\"Avenida de Satrustegi\",\"slug\":\"avenida-de-satrustegi\"},{\"type\":\"street\",\"value\":\"Calle Infante Don Jaime\",\"slug\":\"calle-infante-don-jaime\"},{\"type\":\"street\",\"value\":\"Avenida de Zumalakarreg\",\"slug\":\"avenida-de-zumalakarreg\"},{\"type\":\"street\",\"value\":\"Calle Escolta Real\",\"slug\":\"calle-escolta-real\"},{\"type\":\"street\",\"value\":\"Calle Istingorra\",\"slug\":\"calle-istingorra\"},{\"type\":\"street\",\"value\":\"Calle Sukia\",\"slug\":\"calle-sukia\"}],\"country\":\"Espa\u00F1a\",\"autonomousCommunity\":\"Pa\u00EDs Vasco\",\"postalCode\":\"20008\",\"geography\":[{\"level\":\"country\",\"code\":\"724\"},{\"level\":\"autonomous-community\",\"code\":\"18\"},{\"level\":\"province\",\"code\":\"20\"},{\"level\":\"region\",\"code\":\"426\"},{\"level\":\"area\",\"code\":\"826\"},{\"level\":\"municipality\",\"code\":\"20069\"},{\"level\":\"district\",\"code\":\"2047\"}]},\"multim