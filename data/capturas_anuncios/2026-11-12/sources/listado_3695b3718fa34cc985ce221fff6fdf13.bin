ull,\"terrace\":{\"has\":true},\"floor\":\"FIRST\",\"features\":{\"has\":[\"ELEVATOR\",\"PRIVATE_PARKING\",\"EQUIPPED_KITCHEN\",\"WARDROBES\",\"FURNISHED\",\"MICROWAVE\",\"BALCONY\",\"WASHING_MACHINE\",\"FRIDGE\",\"TV\",\"OVEN\"],\"hasNot\":[\"STORAGE_ROOM\",\"PRIVATE_POOL\",\"PRIVATE_GARDEN\",\"AIR_CONDITIONER\",\"LAUNDRY\",\"COMMUNITY_AREA\",\"CHILDREN_AREA\",\"DOORMAN\",\"GYM\",\"TENNIS_COURT\",\"PETS_ALLOWED\",\"DRYER\",\"ALARM\"]},\"orientation\":\"SOUTH_EAST\",\"heating\":\"NON_SPECIFIED\",\"energyEfficiencyCertificate\":{\"status\":\"PENDING\"},\"dynamicFeatures\":[\"IS_TEMPORARY\"]},\"transaction\":{\"type\":\"rent\",\"price\":{\"amount\":2500,\"currency\":null,\"hidden\":false,\"priceDrop\":null,\"priceRaise\":null},\"trackingPrice\":2500,\"pricePerSquareMeter\":null},\"contact\":{\"email\":\"arrigain@arrigain.com\",\"phone\":\"+34943450666\"},\"urls\":{\"canonical\":\"/alquiler/planta-intermedia/beatriz-infantaren-kalea/antiguo/donostia-san-sebastian/5b484ee8-012b-4635-868d-0f25c4e7f905/d\",\"feature\":null,\"short\":\"/a/5b484ee8-012b-4635-868d-0f25c4e7f905\"}},{\"id\":\"b8ce3da0-accf-46fc-9c7b-a548177598b9\",\"reference\":\"E5568D\",\"legacyNumericId\":\"29680000002166\",\"kind\":\"secondHand\",\"navigationUrl\":\"/alquiler/planta-intermedia/usandizaga-kalea/gros/donostia-san-sebastian/b8ce3da0-accf-46fc-9c7b-a548177598b9/d\",\"listingNavigationUrl\":\"/alquiler/plantas-intermedias/gipuzkoa-provincia/donostia-san-sebastian/gros/s\",\"summary\":{\"title\":\"Temporal estudiantes\",\"description\":\"Desde septiembre 2027 a junio 2028. Estudiantes de curso solo disponible de septiembre  2027 a junio 2028. Calle Usandizaga 16, excelente ubicaci\u00F3n en segunda l\u00EDnea de playa y a 5 minutos del centro a pie. \\r\\nBonito piso que se distribuye en 3 habitaciones, 2 dobles y exteriores y 1 individual con cama nido a patio. 2 cuarto de ba\u00F1o completo, cocina y sal\u00F3n comedor. \\r\\nA la vez dispone de todos los servicios de transporte y muchos comercios alrededor. \\r\\n-Suministros a cargo del inquilino.\\r\\n-Honorarios a cargo del inquilino, a consultar.\\r\\n-Fianza seg\u00FAn duraci\u00F3n alquiler \\r\\n \\r\\n \\r\\n \",\"location\":{\"visibility\":\"STREET\",\"municipality\":\"Donostia - San Sebasti\u00E1n\",\"district\":\"Gros\",\"region\":\"Donostialdea - Oarsoldea\",\"province\":\"Gipuzkoa\",\"address\":{\"streetName\":\"Usandizaga Kalea\",\"streetNumber\":\"16\"},\"coordinates\":{\"latitude\":43.323820538320824,\"longitude\":-1.9768006630962418},\"displayAddressLine\":\"Usandizaga Kalea\",\"displayZoneLine\":\"Gros, Donostia - San Sebasti\u00E1n\",\"layers\":[{\"type\":\"country\",\"value\":\"Espa\u00F1a\",\"slug\":\"espana\"},{\"type\":\"autonomous_community\",\"value\":\"Pa\u00EDs Vasco\",\"slug\":\"pais-vasco\"},{\"type\":\"province\",\"value\":\"Gipuzkoa\",\"slug\":\"gipuzkoa\"},{\"type\":\"region\",\"value\":\"Donostialdea - Oarsoldea\",\"slug\":\"donostialdea-oarsoldea\"},{\"type\":\"area\",\"value\":\"Donostia - San Sebasti\u00E1n , Zona de\",\"slug\":\"donostia-san-sebastian-zona-de\"},{\"type\":\"municipality\",\"value\":\"Donostia - San Sebasti\u00E1n\",\"slug\":\"donostia-san-sebastian\"},{\"type\":\"district\",\"value\":\"Gros\",\"slug\":\"gros\"},{\"type\":\"street\",\"value\":\"Avenida de Zurriol\",\"slug\":\"avenida-de-zurriol\"},{\"type\":\"street\",\"value\":\"Calle Agirre Miramon\",\"slug\":\"calle-agirre-miramon\"},{\"type\":\"street\",\"value\":\"Calle Usandizaga\",\"slug\":\"calle-usandizaga\"},{\"type\":\"street\",\"value\":\"Calle Iparragirre\",\"slug\":\"calle-iparragirre\"},{\"type\":\"street\",\"value\":\"Plaza Luises Obreros\",\"slug\":\"plaza-luises-obreros\"},{\"type\":\"street\",\"value\":\"Calle Dunas\",\"slug\":\"calle-dunas\"},{\"type\":\"street\",\"value\":\"Calle Miguel Imaz\",\"slug\":\"calle-miguel-imaz\"},{\"type\":\"street\",\"value\":\"Plaza de Zuberoa\",\"slug\":\"plaza-de-zuberoa\"},{\"type\":\"street\",\"value\":\"Calle Pe\u00F1a y Go\u00F1i\",\"slug\":\"c