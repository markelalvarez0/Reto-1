    var fileName = culture == 'es' ? `resources_v23` : `resources_v23.${culture}`;

    fetch(`https://statics.imghs.net/dist/translations/${fileName}.json`)
        .then((res) => res.json())
        .then((translation) => {
            window.resources = translation;
        })
        .catch(() => {
            console.error(`Could not load resources with culture ${culture}`);
        });
</script>


